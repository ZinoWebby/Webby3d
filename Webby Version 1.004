    const classOf=(ch,inSet)=>{ const lc=ch.toLowerCase(); if(cls[lc]){ const neg=ch!==lc; return inSet?(neg?null:cls[lc]):'['+(neg?'^':'')+cls[lc]+']'; } return null; };
