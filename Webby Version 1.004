    });
    G.set('collectgarbage',()=>0);
    const unpack=(t,i,j)=>{ tbl(t,1,'unpack'); i=opt(i)?1:i; j=opt(j)?t.length():j; const out=[]; for(let k=i;k<=j;k++) out.push(t.get(k)); return out; };
    G.set('unpack',unpack);
