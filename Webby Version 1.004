          case 'f': { const n=num(arg,ai+1,'format'); out=n.toFixed(opt(pr)?6:+pr); if(flags.includes('+')&&n>=0) out='+'+out; break; }
          case 'g': { const n=num(arg,ai+1,'format'); out=String(+n.toPrecision(opt(pr)?6:(+pr||1))); break; }
          case 'e': out=num(arg,ai+1,'format').toExponential(opt(pr)?6:+pr); break;
          case 'x': out=(Math.trunc(num(arg,ai+1,'format'))>>>0).toString(16); break;
          case 'X': out=(Math.trunc(num(arg,ai+1,'format'))>>>0).toString(16).toUpperCase(); break;
          case 'o': out=(Math.trunc(num(arg,ai+1,'format'))>>>0).toString(8); break;
          case 'c': out=String.fromCharCode(num(arg,ai+1,'format')); break;
          case 's': { out=vm.tostr(arg); if(!opt(pr)) out=out.slice(0,+pr); break; }
