    S.set('reverse',s=>str(s,1,'reverse').split('').reverse().join(''));
    S.set('sub',(s,i,j)=>{
      s=str(s,1,'sub'); const n=s.length; let a=opt(i)?1:Math.floor(num(i,2,'sub')); let b=opt(j)?-1:Math.floor(num(j,3,'sub'));
      if(a<0) a=Math.max(n+a+1,1); else if(a===0) a=1; if(b<0) b=n+b+1; else if(b>n) b=n;
      return a>b?'':s.slice(a-1,b);
    });
    S.set('rep',(s,n,sep)=>{ s=str(s,1,'rep'); n=Math.floor(num(n,2,'rep')); sep=opt(sep)?'':str(sep,3,'rep'); if(n<=0) return ''; if((s.length+sep.length)*n>1e6) throw vm.err('resulting string too large'); return Array(n).fill(s).join(sep); });
    S.set('byte',(s,i,j)=>{ s=str(s,1,'byte'); i=opt(i)?1:i; j=opt(j)?i:j; const out=[]; for(let k=i;k<=j;k++) if(k>=1&&k<=s.length) out.push(s.charCodeAt(k-1)); return out; });
    S.set('char',(...a)=>a.map((v,i)=>String.fromCharCode(num(v,i+1,'char'))).join(''));
    S.set('format',(f,...a)=>{
