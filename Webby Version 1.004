          re+=set+']'; i=j;
        }
        else if(c==='.') re+='[\\s\\S]';
        else if(c==='('){ if(p[i+1]===')') throw vm.err('position captures are not supported'); caps++; re+='('; }
        else if(c===')') re+=')';
        else if(c==='$' && i===p.length-1) re+='$';
        else if(c==='*'||c==='+'||c==='?') re+=c;
        else if(c==='-') re+='*?';
        else re+=esc(c);
      }
      const r={re,caps,anchor}; cache.set(p,r); return r;
    }
    const mkrx=c=>new RegExp(c.re, c.anchor?'y':'g');
    const capsOf=(m,c)=>c.caps>0?m.slice(1).map(x=>x===undefined?'':x):[m[0]];
    S.set('find',(s,p,init,plain)=>{
      s=str(s,1,'find'); p=str(p,2,'find'); let st=opt(init)?1:Math.floor(num(init,3,'find')); if(st<0) st=Math.max(s.length+st+1,1); if(st===0) st=1;
      if(luaTruthy(plain)||!/[\^$()%.\[\]*+\-?]/.test(p)){ const k=s.indexOf(p,st-1); return k<0?[null]:[k+1,k+p.length]; }
      const c=compilePat(p), rx=mkrx(c); rx.lastIndex=st-1; const m=rx.exec(s);
      if(!m) return [null]; return [m.index+1,m.index+m[0].length,...(c.caps>0?capsOf(m,c):[])];
    });
    S.set('match',(s,p,init)=>{
      s=str(s,1,'match'); p=str(p,2,'match'); let st=opt(init)?1:Math.floor(num(init,3,'match')); if(st<0) st=Math.max(s.length+st+1,1); if(st===0) st=1;
      const c=compilePat(p), rx=mkrx(c); rx.lastIndex=st-1; const m=rx.exec(s);
      if(!m) return [null]; return capsOf(m,c);
    });
    S.set('gmatch',(s,p)=>{
      s=str(s,1,'gmatch'); p=str(p,2,'gmatch'); const c=compilePat(p), rx=new RegExp(c.re,'g'); let pos=0;
      return ()=>{ if(pos>s.length) return [null]; rx.lastIndex=pos; const m=rx.exec(s); if(!m){ pos=s.length+1; return [null]; } pos=m[0].length===0?m.index+1:m.index+m[0].length; return capsOf(m,c); };
    });
    S.set('gsub',(s,p,r,max)=>{
      s=str(s,1,'gsub'); p=str(p,2,'gsub'); const c=compilePat(p), rx=mkrx(c); let out='', pos=0, count=0;
      if(!(typeof r==='string'||typeof r==='number'||r instanceof LuaTable||vm.callable(r))) throw vm.err("bad argument #3 to 'gsub' (string/function/table expected, got "+vm.typeName(r)+")");
      while(pos<=s.length && (opt(max)||count<max)){
        rx.lastIndex=pos; const m=rx.exec(s); if(!m) break;
        const st=m.index, en=st+m[0].length; out+=s.slice(pos,st);
        let rep;
        if(typeof r==='string'||typeof r==='number') rep=String(r).replace(/%([0-9%])/g,(x,d)=>d==='%'?'%':(d==='0'?m[0]:(m[+d]!==undefined?m[+d]:'')));
        else if(r instanceof LuaTable){ const v=vm.index(r,c.caps>0?(m[1]||''):m[0]); rep=(v===null||v===false)?m[0]:vm.tostr(v); }
        else { const v=vm.call(r,capsOf(m,c))[0]; rep=(v===null||v===undefined||v===false)?m[0]:vm.tostr(v); }
        out+=rep; count++;
        if(en===st){ if(st<s.length) out+=s[st]; pos=st+1; } else pos=en;
        if(c.anchor) break;
      }
      if(pos<s.length) out+=s.slice(pos);
      return [out,count];
    });
  }
}

// ---------- Webby Create: the game engine scripts talk to ----------
const NAMED_COLORS={red:0xe53935,green:0x43a047,blue:0x1e88e5,yellow:0xfdd835,orange:0xfb8c00,purple:0x8e24aa,pink:0xec407a,white:0xf5f5f5,black:0x212121,gray:0x9e9e9e,grey:0x9e9e9e,brown:0x6d4c41,gold:0xffc107,cyan:0x00acc1,lime:0x9ccc65,teal:0x26a69a};
function parseColor(v){
  const c255=n=>Math.max(0,Math.min(255,Math.round(Number(n)||0)));
  if(typeof v==='number' && isFinite(v)) return Math.max(0,Math.min(0xffffff,Math.floor(v)));
  if(typeof v==='string'){
    const s=v.trim().toLowerCase(); if(NAMED_COLORS[s]!==undefined) return NAMED_COLORS[s];
    let m=/^#?([0-9a-f]{6})$/.exec(s); if(m) return parseInt(m[1],16);
    m=/^#?([0-9a-f]{3})$/.exec(s); if(m) return parseInt(m[1].split('').map(c=>c+c).join(''),16);
  }
  if(Array.isArray(v) && v.length>=3) return (c255(v[0])<<16)|(c255(v[1])<<8)|c255(v[2]);
  if(v && typeof v==='object' && ('r' in v)) return (c255(v.r)<<16)|(c255(v.g)<<8)|c255(v.b);
  return 0x9e9e9e;
}
const plr={
  x:0, y:0, z:0, health:100,
  teleport(x,y,z){ p.set(Number(x)||0,Number(y)||0,Number(z)||0); v.set(0,0,0); },
  damage(n){ n=Number(n)||0; if(shieldT>0||dead) return; setHp(hp-n); if(hp<=0) die(); },
  heal(n){ if(dead) return; setHp(hp+(Number(n)||0)); },
  setHealth(n){ if(dead) return; setHp(Number(n)||0); if(hp<=0) die(); },
  kill(){ if(!dead) die(); },
  setSpeed(n){ SPEED=Math.max(0,Math.min(60,Number(n)||0)); },
  setJump(n){ JUMPV=Math.max(0,Math.min(80,Number(n)||0)); }
};
const engine={
  parts:new Set(), cbStart:[], cbUpdate:[], cbDeath:[], keys:new Map(), timers:[], t:0, failed:false, wasDead:false, started:false, toastT:null, syncHook:null,
  print(text,isErr){
    const out=document.getElementById('cOut'); const d=document.createElement('div');
    if(isErr) d.className='err'; d.textContent=String(text).slice(0,500); out.appendChild(d);
    while(out.children.length>200) out.firstChild.remove(); out.scrollTop=out.scrollHeight;
  },
  error(e){ const msg=(e && e.lua) ? ((e.line?'Line '+e.line+': ':'')+e.message) : String((e && e.message) || e); this.lastError=msg; this.print('Error: '+msg,true); this.failed=true; },
  safe(fn){ try{ return fn(); }catch(e){ this.error(e); } },
  need(fn){ if(typeof fn!=='function') throw new Error('Expected a function here'); },
  reset(){
    [...this.parts].forEach(pt=>{ pt.dead=true; scene.remove(pt.mesh); pt.mesh.geometry.dispose(); pt.mesh.material.dispose(); });
    this.parts.clear(); this.cbStart=[]; this.cbUpdate=[]; this.cbDeath=[]; this.keys=new Map(); this.timers=[];
    this.t=0; this.failed=false; this.wasDead=false; this.started=false; this.syncHook=null;
    clearTimeout(this.toastT); document.getElementById('cmsg').classList.add('hide'); document.getElementById('chud').classList.add('hide');
  },
  makePart(props){
    if(this.parts.size>=400) throw new Error('Too many blocks (the limit is 400)');
    const num=(val,d)=>{ const n=Number(val); return (val===undefined||val===null||!isFinite(n))?d:n; };
    const x=num(props.x,0), y=num(props.y,0.5), z=num(props.z,0);
    const clampS=n=>Math.min(500,Math.max(0.05,n));
    const w=clampS(num(props.w,4)), h=clampS(num(props.h,1)), d=clampS(num(props.d,4));
    if(Math.abs(x)>2000||Math.abs(y)>2000||Math.abs(z)>2000) throw new Error('A block is too far away (keep x, y and z within 2000)');
    const mesh=new THREE.Mesh(new THREE.BoxGeometry(1,1,1), new THREE.MeshLambertMaterial({color:parseColor(props.color)}));
    scene.add(mesh);
    const box={minx:0,maxx:0,miny:0,maxy:0,minz:0,maxz:0};
    const pt={mesh,box,x,y,z,w,h,d,solid:props.solid!==false,damage:Math.max(0,num(props.damage,0)),kill:!!props.kill,bounce:Math.max(0,num(props.bounce,0)),
              cbTouch:[],touching:false,hurtT:0,active:true,dead:false};
    const place=()=>{
      box.minx=pt.x-pt.w/2; box.maxx=pt.x+pt.w/2; box.miny=pt.y-pt.h/2; box.maxy=pt.y+pt.h/2; box.minz=pt.z-pt.d/2; box.maxz=pt.z+pt.d/2;
      mesh.position.set(pt.x,pt.y,pt.z); mesh.scale.set(pt.w,pt.h,pt.d);
    };
    place();
    if(pt.solid) boxes.push(box);
    this.parts.add(pt);
    const eng=this;
    const handle={
      name:String(props.name===undefined?'':props.name).slice(0,40), x,y,z,w,h,d,
      setColor(c){ mesh.material.color.setHex(parseColor(c)); },
      setPosition(nx,ny,nz){
        nx=num(nx,pt.x); ny=num(ny,pt.y); nz=num(nz,pt.z);
        const onTop=pt.active && pt.solid && onGround && Math.abs(p.y-box.maxy)<0.2 && p.x+HW>box.minx && p.x-HW<box.maxx && p.z+HW>box.minz && p.z-HW<box.maxz;
        const dx=nx-pt.x, dy=ny-pt.y, dz=nz-pt.z;
        pt.x=nx; pt.y=ny; pt.z=nz; place(); handle.x=nx; handle.y=ny; handle.z=nz;
        if(onTop){ p.x+=dx; p.y+=dy; p.z+=dz; }     // carry a plr who is standing on it
      },
      setSize(a,b,c){ pt.w=clampS(num(a,pt.w)); pt.h=clampS(num(b,pt.h)); pt.d=clampS(num(c,pt.d)); place(); handle.w=pt.w; handle.h=pt.h; handle.d=pt.d; },
      setVisible(on){
        on=!!on; pt.active=on; mesh.visible=on;
        if(pt.solid){ const i=boxes.indexOf(box); if(on&&i<0) boxes.push(box); if(!on&&i>=0) boxes.splice(i,1); }
      },
      destroy(){
        if(pt.dead) return; pt.dead=true; eng.parts.delete(pt);
        const i=boxes.indexOf(box); if(i>=0) boxes.splice(i,1);
        scene.remove(mesh); mesh.geometry.dispose(); mesh.material.dispose();
      },
      onTouch(fn){ eng.need(fn); pt.cbTouch.push(fn); }
    };
    return handle;
  },
  onStart(fn){ this.need(fn); this.cbStart.push(fn); },
  onUpdate(fn){ this.need(fn); this.cbUpdate.push(fn); },
  onDeath(fn){ this.need(fn); this.cbDeath.push(fn); },
  onKey(k,fn){ this.need(fn); k=String(k).toLowerCase(); if(!this.keys.has(k)) this.keys.set(k,[]); this.keys.get(k).push(fn); },
  key(e){ const k=e.key===' '?'space':String(e.key).toLowerCase(); const l=this.keys.get(k); if(l) l.slice().forEach(fn=>this.safe(()=>fn())); },
  after(s,fn){ this.need(fn); const tm={left:Math.max(0,Number(s)||0),fn,every:0,dead:false}; this.timers.push(tm); return {stop(){ tm.dead=true; }}; },
  every(s,fn){ this.need(fn); const iv=Math.max(0.05,Number(s)||1); const tm={left:iv,fn,every:iv,dead:false}; this.timers.push(tm); return {stop(){ tm.dead=true; }}; },
  message(text,secs){
    const el=document.getElementById('cmsg'); el.textContent=String(text).slice(0,140); el.classList.remove('hide');
    clearTimeout(this.toastT); this.toastT=setTimeout(()=>el.classList.add('hide'),Math.max(0.5,Number(secs)||3)*1000);
  },
  hud(text){ const el=document.getElementById('chud'); text=String(text).slice(0,140); el.textContent=text; el.classList.toggle('hide',!text); },
  playSound(name){
    const f={coin:sfx.coin,win:sfx.win,hit:sfx.hurt,hurt:sfx.hurt,jump:()=>beep(300,600,0.12,'square',0.15),pop:sfx.place,place:sfx.place,pick:sfx.pick,die:sfx.die}[String(name)];
    if(f) f();
  },
  setSpawn(x,y,z){ spawnPos.set(Number(x)||0,Number(y)||0,Number(z)||0); if(!this.started){ p.copy(spawnPos); v.set(0,0,0); } },
  sky(c){ scene.background=new THREE.Color(parseColor(c)); },
  gravity(n){ GRAV=Math.max(0,Math.min(200,Number(n)||0)); },
  clear(){ [...this.parts].forEach(pt=>{ if(pt.dead) return; pt.dead=true; this.parts.delete(pt); const i=boxes.indexOf(pt.box); if(i>=0) boxes.splice(i,1); scene.remove(pt.mesh); pt.mesh.geometry.dispose(); pt.mesh.material.dispose(); }); },
  syncPlayer(){ plr.x=+p.x.toFixed(2); plr.y=+p.y.toFixed(2); plr.z=+p.z.toFixed(2); plr.health=hp; if(this.syncHook) this.syncHook(); },
  tick(dt){
    this.t+=dt; this.syncPlayer();
    for(const tm of this.timers.slice()){
      if(tm.dead) continue; tm.left-=dt;
      if(tm.left<=0){ if(tm.every) tm.left+=tm.every; else tm.dead=true; this.safe(()=>tm.fn()); }
    }
    this.timers=this.timers.filter(tm=>!tm.dead);
    for(const pt of [...this.parts]){
      if(pt.dead||!pt.active) continue;
      const b=pt.box;
      const touching=!dead && p.x+HW+0.15>b.minx && p.x-HW-0.15<b.maxx && p.z+HW+0.15>b.minz && p.z-HW-0.15<b.maxz && p.y+H>b.miny-0.05 && p.y<b.maxy+0.1;
      if(touching && !pt.touching) pt.cbTouch.slice().forEach(fn=>this.safe(()=>fn(plr)));
      pt.touching=touching;
      if(pt.dead) continue;
      if(!touching){ pt.hurtT=0; continue; }
      if(shieldT<=0){
        if(pt.kill) die();
        else if(pt.damage>0){ pt.hurtT-=dt; if(pt.hurtT<=0){ pt.hurtT=0.35; setHp(hp-pt.damage); sfx.hurt(); burst(p.x,p.y+1.5,p.z,pt.mesh.material.color.getHex(),5,1); if(hp<=0) die(); } }
      }
      if(pt.bounce>0){ v.y=pt.bounce; onGround=false; }
    }
    this.syncPlayer();
    this.cbUpdate.slice().forEach(fn=>this.safe(()=>fn(dt)));
    if(dead && !this.wasDead) this.cbDeath.slice().forEach(fn=>this.safe(()=>fn()));
    this.wasDead=dead;
  },
  run(g){
    this.print('Game started. Press Esc for the menu.');
    this.safe(()=>{
      if(g.lang==='lua'){ const vm=new LuaVM(); vm.out=t=>this.print(t); bindLua(vm,this); vm.run(g.code); }
      else { new Function('api','with(api){\n'+g.code+'\n}')(jsApi); }
    });
    if(!this.failed){ this.started=true; this.cbStart.slice().forEach(f=>this.safe(f)); }
  }
};
const jsApi={
  part:props=>engine.makePart(props||{}), message:(t,s)=>engine.message(t,s), hud:t=>engine.hud(t), playSound:n=>engine.playSound(n),
  setSpawn:(x,y,z)=>engine.setSpawn(x,y,z), sky:c=>engine.sky(c), gravity:n=>engine.gravity(n), clear:()=>engine.clear(),
  random:(a,b)=>{ if(a===undefined) return Math.random(); let lo=1, hi=Number(a); if(b!==undefined){ lo=Number(a); hi=Number(b); } return lo+Math.floor(Math.random()*(hi-lo+1)); },
  time:()=>engine.t, print:(...a)=>engine.print(a.map(String).join(' ')),
  onStart:f=>engine.onStart(f), onUpdate:f=>engine.onUpdate(f), onKey:(k,f)=>engine.onKey(k,f), onDeath:f=>engine.onDeath(f),
  after:(s,f)=>engine.after(s,f), every:(s,f)=>engine.every(s,f), player:plr
};
function luaToJS(v){
  if(v instanceof LuaTable){
    if(v.length()>0){ const a=[]; for(let i=1;i<=v.length();i++) a.push(luaToJS(v.get(i))); return a; }
    const o={}; v.h.forEach((val,k)=>{ o[String(k)]=luaToJS(val); }); return o;
  }
  return v;
}
function bindLua(vm,eng){
  const G=vm.G, N=(n,f)=>G.set(n,f);
  const lp=new LuaTable();
  const syncLP=()=>{ lp.set('x',plr.x); lp.set('y',plr.y); lp.set('z',plr.z); lp.set('health',plr.health); };
  eng.syncHook=syncLP; syncLP();
  const wrap=fn=>{
    if(!(fn instanceof LuaFunction) && typeof fn!=='function') throw vm.err('expected a function');
    return (...a)=>{ vm.steps=0; vm.depth=0; vm.call(fn,a.map(x=>x===plr?lp:x)); };
  };
  lp.set('teleport',(s,x,y,z)=>{ plr.teleport(x,y,z); });
  lp.set('damage',(s,n)=>{ plr.damage(n); });
  lp.set('heal',(s,n)=>{ plr.heal(n); });
  lp.set('setHealth',(s,n)=>{ plr.setHealth(n); });
  lp.set('kill',()=>{ plr.kill(); });
  lp.set('setSpeed',(s,n)=>{ plr.setSpeed(n); });
  lp.set('setJump',(s,n)=>{ plr.setJump(n); });
  G.set('player',lp);
  const luaPart=h=>{
    const t=new LuaTable();
    const sync=()=>{ ['name','x','y','z','w','h','d'].forEach(k=>t.set(k,h[k])); };
    sync();
    t.set('setColor',(s,c)=>{ h.setColor(luaToJS(c)); });
    t.set('setPosition',(s,x,y,z)=>{ h.setPosition(x,y,z); sync(); });
    t.set('setSize',(s,a,b,c)=>{ h.setSize(a,b,c); sync(); });
    t.set('setVisible',(s,on)=>{ h.setVisible(luaTruthy(on)); });
    t.set('destroy',()=>{ h.destroy(); });
    t.set('onTouch',(s,fn)=>{ h.onTouch(wrap(fn)); });
    return t;
  };
  const timer=h=>{ const t=new LuaTable(); t.set('stop',()=>{ h.stop(); }); return t; };
  N('part',props=>luaPart(eng.makePart(props instanceof LuaTable?luaToJS(props):{})));
  N('message',(t,s)=>{ eng.message(vm.tostr(t),s); });
  N('hud',t=>{ eng.hud(vm.tostr(t)); });
  N('playSound',n=>{ eng.playSound(vm.tostr(n)); });
  N('setSpawn',(x,y,z)=>{ eng.setSpawn(x,y,z); });
  N('sky',c=>{ eng.sky(luaToJS(c)); });
  N('gravity',n=>{ eng.gravity(n); });
  N('clear',()=>{ eng.clear(); });
  N('random',vm.G.get('math').get('random'));
  N('time',()=>eng.t);
  N('onStart',fn=>{ eng.onStart(wrap(fn)); });
  N('onUpdate',fn=>{ eng.onUpdate(wrap(fn)); });
  N('onDeath',fn=>{ eng.onDeath(wrap(fn)); });
  N('onKey',(k,fn)=>{ eng.onKey(vm.tostr(k),wrap(fn)); });
  N('after',(s,fn)=>timer(eng.after(s,wrap(fn))));
  N('every',(s,fn)=>timer(eng.every(s,wrap(fn))));
}

// ---------- Webby Create: the editor ----------
const TEMPLATES={"lua": "-- Welcome to Webby Create! Press RUN to play your game. Press Esc for the menu.\n-- x = right, y = up, z = toward the camera. The floor is at y = 0.\n\nsetSpawn(0, 0, 0)\n\n-- a staircase of blue blocks\nfor i = 1, 6 do\n  part{x = 6 + i * 3, y = i * 1.2, z = 0, w = 3, h = 0.6, d = 3, color = \"#4aa3ff\"}\nend\n\n-- a red block that kills you\npart{x = 0, y = 0.5, z = -8, w = 4, h = 1, d = 4, color = \"red\", kill = true}\n\n-- a golden goal at the top of the stairs\nlocal goal = part{x = 27, y = 8.2, z = 0, w = 3, h = 0.6, d = 3, color = \"gold\"}\ngoal:onTouch(function()\n  message(\"You win!\", 4)\n  playSound(\"win\")\nend)\n\nhud(\"Climb the stairs!\")\n", "js": "// Welcome to Webby Create! Press RUN to play your game. Press Esc for the menu.\n// x = right, y = up, z = toward the camera. The floor is at y = 0.\n\nsetSpawn(0, 0, 0);\n\n// a staircase of blue blocks\nfor (let i = 1; i <= 6; i++) {\n  part({ x: 6 + i * 3, y: i * 1.2, z: 0, w: 3, h: 0.6, d: 3, color: \"#4aa3ff\" });\n}\n\n// a red block that kills you\npart({ x: 0, y: 0.5, z: -8, w: 4, h: 1, d: 4, color: \"red\", kill: true });\n\n// a golden goal at the top of the stairs\nconst goal = part({ x: 27, y: 8.2, z: 0, w: 3, h: 0.6, d: 3, color: \"gold\" });\ngoal.onTouch(() => {\n  message(\"You win!\", 4);\n  playSound(\"win\");\n});\n\nhud(\"Climb the stairs!\");\n"}, EXAMPLES={"lua": "-- Example: collect 5 coins, ride a moving platform, avoid the lava, use the jump pad.\nlocal score = 0\nhud(\"Coins: 0 / 5\")\n\n-- coins (gold blocks you can walk through)\nfor i = 1, 5 do\n  local coin = part{x = i * 5, y = 1.5, z = -6, w = 1, h = 1, d = 1, color = \"gold\", solid = false}\n  coin:onTouch(function()\n    coin:destroy()\n    score = score + 1\n    hud(\"Coins: \" .. score .. \" / 5\")\n    playSound(\"coin\")\n    if score == 5 then\n      message(\"You got them all!\", 4)\n      playSound(\"win\")\n    end\n  end)\nend\n\n-- lava (hurts 10% every moment you stand on it)\npart{x = 12, y = 0.1, z = 0, w = 20, h = 0.2, d = 6, color = \"#ff6d00\", damage = 10}\n\n-- a platform that slides left and right\nlocal plat = part{x = 0, y = 2, z = 8, w = 5, h = 0.6, d = 5, color = \"#ffa24a\"}\nlocal t = 0\nonUpdate(function(dt)\n  t = t + dt\n  plat:setPosition(math.sin(t) * 8, 2, 8)\nend)\n\n-- a jump pad\npart{x = -8, y = 0.2, z = 0, w = 3, h = 0.4, d = 3, color = \"#7cc65a\", bounce = 22}\n\n-- press E to teleport back to the start\nonKey(\"e\", function()\n  player:teleport(0, 1, 0)\n  message(\"Back to the start!\", 2)\nend)\n", "js": "// Example: collect 5 coins, ride a moving platform, avoid the lava, use the jump pad.\nlet score = 0;\nhud(\"Coins: 0 / 5\");\n\n// coins (gold blocks you can walk through)\nfor (let i = 1; i <= 5; i++) {\n  const coin = part({ x: i * 5, y: 1.5, z: -6, w: 1, h: 1, d: 1, color: \"gold\", solid: false });\n  coin.onTouch(() => {\n    coin.destroy();\n    score++;\n    hud(\"Coins: \" + score + \" / 5\");\n    playSound(\"coin\");\n    if (score === 5) {\n      message(\"You got them all!\", 4);\n      playSound(\"win\");\n    }\n  });\n}\n\n// lava (hurts 10% every moment you stand on it)\npart({ x: 12, y: 0.1, z: 0, w: 20, h: 0.2, d: 6, color: \"#ff6d00\", damage: 10 });\n\n// a platform that slides left and right\nconst plat = part({ x: 0, y: 2, z: 8, w: 5, h: 0.6, d: 5, color: \"#ffa24a\" });\nlet t = 0;\nonUpdate((dt) => {\n  t += dt;\n  plat.setPosition(Math.sin(t) * 8, 2, 8);\n});\n\n// a jump pad\npart({ x: -8, y: 0.2, z: 0, w: 3, h: 0.4, d: 3, color: \"#7cc65a\", bounce: 22 });\n\n// press E to teleport back to the start\nonKey(\"e\", () => {\n  player.teleport(0, 1, 0);\n  message(\"Back to the start!\", 2);\n});\n"};
let curGame=null, defaultBoxes=[], defaultHazards=[], defaultMeshes=[], defaultBg=null, helpHTML='', delArmed=false;
const cName=document.getElementById('cName'), cLang=document.getElementById('cLang'), cCode=document.getElementById('cCode'), cNote=document.getElementById('cNote'), cList=document.getElementById('cList');
function renderGames(){
  cList.innerHTML='';
  const pbt=document.getElementById('cPublish'); if(pbt) pbt.textContent=(curGame&&curGame.pub)?(curGame.pub.th?'Published \u2713 (edit)':'Add thumbnail (required)'):'Publish to Webby';
  profile.games.forEach(g=>{
    const d=document.createElement('div'); d.className='citem'+(curGame && curGame.id===g.id?' on':'');
    d.textContent=g.name+'  \u00b7  '+(g.lang==='lua'?'Lua':'JS')+(g.banned?'  \u00b7  removed by moderator':g.pub?(g.pub.th?'  \u00b7  \u2713 '+VIS_LABEL[g.pub.vis]:'  \u00b7  needs a thumbnail'):'');
    d.onclick=()=>{ saveCurrent(true); selectGame(g.id); };
    cList.appendChild(d);
  });
}
function selectGame(id){
  curGame=profile.games.find(g=>g.id===id)||null;
  if(curGame){ cName.value=curGame.name; cLang.value=curGame.lang; cCode.value=curGame.code; }
  renderGames(); cNote.textContent=''; delArmed=false; document.getElementById('cDelete').textContent='Delete';
  if(typeof curGame!=='undefined') document.getElementById('cPublish').textContent=(curGame&&curGame.pub)?'Published \u2713 (edit)':'Publish to Webby';
}
function saveCurrent(silent){
  if(!curGame) return;
  curGame.name=(cName.value.trim()||'Untitled').slice(0,40); curGame.lang=cLang.value==='js'?'js':'lua'; curGame.code=cCode.value.slice(0,20000);
  saveProfile(); renderGames(); if(!silent) cNote.textContent='Saved!';
}
function newGame(){
  if(profile.games.length>=20){ cNote.textContent='You can keep up to 20 games. Delete one first.'; return; }
  saveCurrent(true);
  const g={id:'g'+Date.now().toString(36)+Math.floor(Math.random()*1000), name:'My game '+(profile.games.length+1), lang:'lua', code:TEMPLATES.lua};
  profile.games.push(g); saveProfile(); selectGame(g.id);
}
function renderCreate(){ if(!profile.games.length) newGame(); else if(!curGame || !profile.games.includes(curGame)) selectGame(profile.games[0].id); else renderGames(); }
cLang.onchange=()=>{
  const old=curGame?curGame.lang:'lua', nw=cLang.value, now=cCode.value.trim();
  if(now===''||now===TEMPLATES[old].trim()) cCode.value=TEMPLATES[nw];
  if(curGame) curGame.lang=nw;
  if(curGame && curGame.pub && nw==='js') cNote.textContent='JavaScript games cannot be shared, so this game is hidden from the homepage until you switch back to Lua.';
};
document.getElementById('cNew').onclick=newGame;
document.getElementById('cSave').onclick=()=>saveCurrent(false);
document.getElementById('cExample').onclick=()=>{ cCode.value=EXAMPLES[cLang.value]; cNote.textContent='Example loaded. Press RUN to try it, or Save to keep it.'; };
document.getElementById('cDelete').onclick=()=>{
  if(!curGame) return;
  if(!delArmed){ delArmed=true; document.getElementById('cDelete').textContent='Click again to delete'; setTimeout(()=>{ delArmed=false; document.getElementById('cDelete').textContent='Delete'; },3000); return; }
  if(curGame.pub){ const k=acct.uid+':'+curGame.id; catalog[k]={k,u:acct.uid,id:curGame.id,t:Date.now(),rm:1}; saveCatalog(); catDirty=true; setTimeout(()=>syncCatalog(true),50); }
  profile.games=profile.games.filter(g=>g!==curGame); curGame=null; saveProfile(); renderCommunity(); delArmed=false; document.getElementById('cDelete').textContent='Delete';
  if(profile.games.length) selectGame(profile.games[0].id); else newGame();
};
document.getElementById('cRun').onclick=()=>{
  if(!curGame) return; saveCurrent(true); cNote.textContent='';
  document.getElementById('cOut').innerHTML=''; runCustom(curGame);
};
cCode.addEventListener('keydown',e=>{
  e.stopPropagation();
  if(e.key==='Tab'){ e.preventDefault(); const a=cCode.selectionStart, b=cCode.selectionEnd; cCode.value=cCode.value.slice(0,a)+'  '+cCode.value.slice(b); cCode.selectionStart=cCode.selectionEnd=a+2; }
  if((e.ctrlKey||e.metaKey) && e.key==='Enter'){ e.preventDefault(); document.getElementById('cRun').onclick(); }
});
cCode.addEventListener('keyup',e=>e.stopPropagation());
cName.addEventListener('keydown',e=>e.stopPropagation()); cName.addEventListener('keyup',e=>e.stopPropagation());
// ----- opening the editor and running a game -----
function showLoadingCard(title,by,status,ms,then){
  const ld=document.getElementById('loading'), nm=ld.querySelector('.lname'), bl=ld.querySelector('.lby'), st=document.getElementById('lstat');
  const old=[nm.textContent,bl.textContent];
  nm.textContent=title; bl.textContent=by; st.textContent=status; ld.classList.remove('hide'); joining=true;
  setTimeout(()=>{ ld.classList.add('hide'); nm.textContent=old[0]; bl.textContent=old[1]; joining=false; then(); },ms);
}
function openCreate(){ if(joining||running||customMode||!acct) return; showLoadingCard('Webby Create','Make your own games','Loading the editor...',1600,()=>showTab('create')); }
function runCustom(g){ if(joining||running||customMode||!acct) return; showLoadingCard(g.name,'By '+myName,'Starting your game...',1400,()=>startCustom(g)); }
function setDefaultWorldVisible(on){ scene.children.forEach(o=>{ if(o.userData && o.userData.dw && o!==defaultMeshes[0]) o.visible=on; }); devBlocks.forEach(o=>{ o.mesh.visible = on && o.visible; }); }
let customOpts={};
function startCustom(g,opts){
  customOpts=opts||{};
  defaultBoxes=boxes.slice(); defaultHazards=hazards.slice(); defaultMeshes=worldMeshes.slice(); defaultBg=scene.background;
  boxes.length=0; boxes.push(defaultBoxes[0]); hazards.length=0; worldMeshes.length=0; worldMeshes.push(defaultMeshes[0]);
  setDefaultWorldVisible(false);
  customMode=true; engine.reset(); GRAV=30; SPEED=8; JUMPV=12; spawnPos.set(0,0,0);
  p.copy(spawnPos); v.set(0,0,0); dead=false; deathTimer=0; body.visible=true; setHp(100); shieldT=3; hurtT=0; climbing=false; dancing=false;
  camYaw=0; camPitch=0.6; camDist=16; camera.position.set(0,9,13);
  home.classList.add('hide'); showHud(true); document.getElementById('pb').classList.add('hide'); document.getElementById('bar').classList.add('hide'); document.getElementById('devBtn').classList.add('hide'); document.getElementById('devtools').classList.add('hide');
  const help=document.getElementById('help'); helpHTML=help.innerHTML;
  help.innerHTML='WASD / Arrows = move &nbsp;\u00b7&nbsp; Space = jump &nbsp;\u00b7&nbsp; Drag mouse = camera &nbsp;\u00b7&nbsp; Esc = menu';
  running=true;
  engine.run(g);
  if(engine.failed){ engine.failed=false; stopCustom(false); }
}
function stopCustom(esc){
  if(!customMode) return;
  customMode=false; engine.reset(); engine.print('Game stopped.');
  boxes.length=0; defaultBoxes.forEach(b=>boxes.push(b)); hazards.length=0; defaultHazards.forEach(h=>hazards.push(h));
  worldMeshes.length=0; defaultMeshes.forEach(m=>worldMeshes.push(m)); setDefaultWorldVisible(true);
  scene.background=defaultBg; GRAV=30; SPEED=8; JUMPV=12; spawnPos.set(0,0,0);
  running=false; releaseLock(); if(typing) closeChat();
  rpieces.forEach(o=>scene.remove(o.m)); rpieces=[]; pieces.forEach(o=>scene.remove(o.m)); pieces=[];
  p.set(0,0,0); v.set(0,0,0); dead=false; deathTimer=0; body.visible=true; setHp(100); shieldT=0; hurtT=0; climbing=false; dancing=false;
  camYaw=0; camPitch=0.6; camDist=16;
  clog.innerHTML=''; document.getElementById('help').innerHTML=helpHTML;
  if(window.WEBBY_STANDALONE){   // downloaded game: Esc restarts it, an error leaves the message on screen
    home.classList.add('hide');
    if(esc===true){ setTimeout(()=>startCustom(window.WEBBY_GAME),60); }
    else { showHud(false); engine.message('Game error: '+(engine.lastError||'unknown')+'  (reload the page to try again)',600); }
    return;
  }
  const community=!!customOpts.community; customOpts={};
  if(community){ playing=false; playingName=''; releaseActive(); if(party){ party.shim.close(); partyEnded('',true); } }
  showHud(false); home.classList.remove('hide'); showTab(community?'home':'create');
}
function customTick(dt){
  engine.tick(dt);
  if(engine.failed){ engine.failed=false; stopCustom(false); }
}
document.getElementById('tabCreate').onclick=openCreate;

// ---------- DevTools button, in Testing Place ----------
const devBtn=document.getElementById('devBtn'), devPanel=document.getElementById('devtools'), dCode=document.getElementById('dCode'), dNote=document.getElementById('dNote');
devBtn.onclick=()=>devPanel.classList.toggle('hide');
document.getElementById('dClose').onclick=()=>devPanel.classList.add('hide');
document.getElementById('dClearMine').onclick=()=>{ devClearMine(); devPrint('Cleared your blocks, signs and settings.'); };
document.getElementById('dRun').onclick=()=>{
  if(typeof room!=='undefined' && room && myId()==='local'){ dNote.textContent='Still connecting to the server, try again in a second.'; return; }
  document.getElementById('dOut').innerHTML=''; dNote.textContent=''; devClearMine();
  const vm=new LuaVM(); vm.out=t=>devPrint(t);
  try{ bindDevLua(vm); vm.run(dCode.value.slice(0,20000)); dNote.textContent='Running! Everyone here can see it.'; }
  catch(e){ devPrint((e.lua ? (e.line?'Line '+e.line+': ':'')+e.message : String((e&&e.message)||e)), true); dNote.textContent='Stopped because of an error above.'; }
};
dCode.addEventListener('keydown',e=>{
  e.stopPropagation();
  if(e.key==='Tab'){ e.preventDefault(); const a=dCode.selectionStart, b=dCode.selectionEnd; dCode.value=dCode.value.slice(0,a)+'  '+dCode.value.slice(b); dCode.selectionStart=dCode.selectionEnd=a+2; }
  if((e.ctrlKey||e.metaKey) && e.key==='Enter'){ e.preventDefault(); document.getElementById('dRun').onclick(); }
});
dCode.addEventListener('keyup',e=>e.stopPropagation());



// ---------- Esc menu: players, settings, reset / leave / resume ----------
const tmEl=document.getElementById('tm'); let tmTab='players', _tmKey='';
const tmOpen=()=>!tmEl.classList.contains('hide');
function tmShow(t){
  tmTab=t;
  [['players','tmPlayers','tmtPlayers'],['settings','tmSettings','tmtSettings'],['help','tmHelp','tmtHelp']].forEach(([n,box,btn])=>{
    document.getElementById(box).classList.toggle('hide',n!==t); document.getElementById(btn).classList.toggle('on',n===t);
  });
  if(t==='players'){ _tmKey=''; renderTabPlayers(); }
}
function openTM(){
  if(!running) return;
  releaseLock(); Object.keys(keys).forEach(k=>keys[k]=false);
  pp.classList.add('hide');
  document.getElementById('tmLeaveT').textContent=window.WEBBY_STANDALONE?'Restart Game':'Leave Game';
  tmEl.classList.remove('hide'); tmShow(tmTab); syncSettingsUI();
}
function closeTM(){ tmEl.classList.add('hide'); }
function tmReset(){ closeTM(); if(running && !dead) die(); }
function tmLeave(){
  closeTM();
  if(customMode) stopCustom(true);
  else if(running) goHome();
}
document.getElementById('tmtPlayers').onclick=()=>tmShow('players');
document.getElementById('tmtSettings').onclick=()=>tmShow('settings');
document.getElementById('tmtHelp').onclick=()=>tmShow('help');
document.getElementById('tmReset').onclick=tmReset;
document.getElementById('tmLeave').onclick=tmLeave;
document.getElementById('tmResume').onclick=closeTM;
// Esc opens/closes the menu; R and L work while it is open. Tab does nothing. (Runs before the game's own key handler.)
addEventListener('keydown', e=>{
  const tg=e.target && e.target.tagName; if(tg==='INPUT' || tg==='TEXTAREA' || tg==='SELECT') return;
  if(typing || !running) { if(e.code==='Tab' && running) e.preventDefault(); return; }
  if(e.code==='Tab'){ e.preventDefault(); e.stopImmediatePropagation(); return; }   // Tab is intentionally unused
  if(e.code==='Escape'){
    if(e.repeat){ e.stopImmediatePropagation(); return; }
    if(tmOpen()){ e.stopImmediatePropagation(); closeTM(); return; }
    if(pv || !devPanel.classList.contains('hide')) return;   // those close first (game handler)
    e.stopImmediatePropagation(); openTM(); return;
  }
  if(!tmOpen()) return;
  if(false){}
  else if(e.code==='KeyR'){ e.stopImmediatePropagation(); tmReset(); }
  else if(e.code==='KeyL'){ e.stopImmediatePropagation(); tmLeave(); }
}, true);
function tmClose_ifStopped(){ if(!running && tmOpen()) closeTM(); }
setInterval(tmClose_ifStopped,500);
// players tab
function renderTabPlayers(){
  const list=[{name:myName,skin:mySkin,hat:myHat,face:myFace,n:null,me:true}];
  remotes.forEach((r,id)=>{ const nm=r.name||tagOf(id); list.push({name:nm,skin:(r.skin===undefined?Y:r.skin),hat:r.c.hat|0,face:r.c.face|0,n:uidOf(nm)}); });
  const key=list.map(x=>[x.name,x.skin,x.hat,x.face,x.n?friendState(x.n):''].join('|')).join(';')+'#'+(userPeer?1:0)+profile.incoming.join(',');
  if(key===_tmKey) return; _tmKey=key;
  const box=document.getElementById('tmPlayers'); box.innerHTML='';
  const head=document.createElement('div'); head.className='tmrow'; head.innerHTML='<b></b>'; head.firstChild.textContent='Players in this server: '+list.length; box.appendChild(head);
  list.forEach(x=>{
    const row=document.createElement('div'); row.className='tmprow';
    row.innerHTML='<div class="pface"><div class="pfin">'+avatarHTML(hex6(x.skin),x.hat,x.face)+'</div></div><div class="pn"><span></span><small></small></div>';
    row.querySelector('.pn span').textContent=censor(x.name).text;
    const small=row.querySelector('small');
    if(x.me){ small.textContent='You'; }
    else if(x.n && acct && x.n!==acct.uid){
      small.textContent='@'+x.n;
      const op=()=>openProfile(x.n,{name:x.name,skin:x.skin,hat:x.hat,face:x.face});
      row.querySelector('.pface').style.cursor='pointer'; row.querySelector('.pface').onclick=op;
      const st=friendState(x.n), bt=document.createElement('button');
      if(st==='f'){ bt.textContent='Friends'; bt.disabled=true; }
      else if(st==='o'){ bt.textContent='Request sent'; bt.disabled=true; }
      else if(st==='i'){ bt.textContent='Accept'; bt.onclick=()=>acceptFriend(x.n); }
      else { bt.textContent='Add friend'; bt.onclick=()=>{ if(!userPeer){ addChat('Friends',socialMsg()); return; } sendRequest(x.n); }; }
      row.appendChild(bt);
    } else small.textContent='Guest';
    box.appendChild(row);
  });
}
setInterval(()=>{ if(tmOpen() && tmTab==='players') renderTabPlayers(); },400);
// settings tab
function syncSettingsUI(){
  document.getElementById('stVol').value=SET.vol; document.getElementById('stVolV').textContent=Math.round(SET.vol)+'%';
  document.getElementById('stFov').value=SET.fov; document.getElementById('stFovV').textContent=Math.round(SET.fov)+'\u00b0';
  document.getElementById('stSens').value=SET.sens; document.getElementById('stSensV').textContent=(+SET.sens).toFixed(1)+'x';
  [['stInv',SET.inv],['stFps',SET.fps],['stFull',!!document.fullscreenElement]].forEach(([id,on])=>{ const b=document.getElementById(id); b.textContent=on?'On':'Off'; b.classList.toggle('on',on); });
  document.getElementById('fps').classList.toggle('hide',!(SET.fps && running));
}
document.getElementById('stVol').oninput=e=>{ SET.vol=+e.target.value; saveSettings(); syncSettingsUI(); };
document.getElementById('stVol').onchange=()=>sfx.coin();
document.getElementById('stFov').oninput=e=>{ SET.fov=+e.target.value; camera.fov=SET.fov; camera.updateProjectionMatrix(); saveSettings(); syncSettingsUI(); };
document.getElementById('stSens').oninput=e=>{ SET.sens=+e.target.value; saveSettings(); syncSettingsUI(); };
document.getElementById('stInv').onclick=()=>{ SET.inv=!SET.inv; saveSettings(); syncSettingsUI(); };
document.getElementById('stFps').onclick=()=>{ SET.fps=!SET.fps; saveSettings(); syncSettingsUI(); };
document.getElementById('stFull').onclick=()=>{ try{ if(document.fullscreenElement) document.exitFullscreen(); else document.documentElement.requestFullscreen(); }catch(e){} setTimeout(syncSettingsUI,300); };
document.getElementById('stDef').onclick=()=>{ Object.assign(SET,SET_DEF); camera.fov=SET.fov; camera.updateProjectionMatrix(); saveSettings(); syncSettingsUI(); };
document.addEventListener('fullscreenchange',syncSettingsUI);
// FPS counter
let _fc=0, _fl=performance.now(); const fpsEl=document.getElementById('fps');
(function fpsTick(){ _fc++; requestAnimationFrame(fpsTick); })();
setInterval(()=>{ const n=performance.now(); if(SET.fps && running){ fpsEl.classList.remove('hide'); fpsEl.textContent=Math.round(_fc*1000/(n-_fl))+' FPS'; } else fpsEl.classList.add('hide'); _fc=0; _fl=n; },1000);


// ---------- Homepage settings (theme and more) ----------
const HS_DEF={theme:'system',accent:'#2775c4',size:100,compact:false,pubOnly:false,auto:true};
const HS=Object.assign({},HS_DEF);
try{ const sv=JSON.parse(localStorage.getItem('webbyHome')||'null'); if(sv && typeof sv==='object'){
  if(['light','dark','system'].includes(sv.theme)) HS.theme=sv.theme;
  if(typeof sv.accent==='string' && /^#[0-9a-f]{6}$/i.test(sv.accent)) HS.accent=sv.accent;
  if([90,100,115].includes(sv.size)) HS.size=sv.size;
  HS.compact=!!sv.compact; HS.pubOnly=!!sv.pubOnly; HS.auto=sv.auto!==false; } }catch(e){}
const darkMQ=window.matchMedia ? matchMedia('(prefers-color-scheme: dark)') : null;
function saveHS(){ try{ localStorage.setItem('webbyHome',JSON.stringify(HS)); }catch(e){} }
function applyHS(){
  const dark=HS.theme==='dark' || (HS.theme==='system' && darkMQ && darkMQ.matches);
  document.documentElement.setAttribute('data-eff',dark?'dark':'light');
  document.documentElement.style.setProperty('--acc',HS.accent);
  home.style.zoom=HS.size===100?'':String(HS.size/100);
  home.classList.toggle('hcompact',HS.compact);
}
if(darkMQ){ const f=()=>{ if(HS.theme==='system') applyHS(); }; if(darkMQ.addEventListener) darkMQ.addEventListener('change',f); else if(darkMQ.addListener) darkMQ.addListener(f); }
const ACCENTS=['#2775c4','#2e8b57','#7b4fc4','#c0392b','#d9531e','#138d90','#555e6e'];
(function(){ const box=document.getElementById('hsAccent'); ACCENTS.forEach(c=>{ const b=document.createElement('button'); b.className='accb'; b.style.background=c; b.dataset.v=c; b.title=c; b.onclick=()=>{ HS.accent=c; saveHS(); applyHS(); syncHomeSettings(); }; box.appendChild(b); }); })();
document.querySelectorAll('#hsTheme .opt').forEach(b=>b.onclick=()=>{ HS.theme=b.dataset.v; saveHS(); applyHS(); syncHomeSettings(); });
document.querySelectorAll('#hsSize .opt').forEach(b=>b.onclick=()=>{ HS.size=+b.dataset.v; saveHS(); applyHS(); syncHomeSettings(); });
function setSw(id,on){ const b=document.getElementById(id); b.textContent=on?'On':'Off'; b.classList.toggle('on',on); }
function syncHomeSettings(){
  document.querySelectorAll('#hsTheme .opt').forEach(b=>b.classList.toggle('on',b.dataset.v===HS.theme));
  document.querySelectorAll('#hsSize .opt').forEach(b=>b.classList.toggle('on',+b.dataset.v===HS.size));
  document.querySelectorAll('#hsAccent .accb').forEach(b=>b.classList.toggle('on',b.dataset.v===HS.accent));
  setSw('hsCompact',HS.compact); setSw('hsPubOnly',HS.pubOnly); setSw('hsAuto',HS.auto); setSw('hsInv',SET.inv); setSw('hsFps',SET.fps);
  document.getElementById('hsVol').value=SET.vol; document.getElementById('hsVolV').textContent=Math.round(SET.vol)+'%';
  document.getElementById('hsFov').value=SET.fov; document.getElementById('hsFovV').textContent=Math.round(SET.fov)+'\u00b0';
  document.getElementById('hsSens').value=SET.sens; document.getElementById('hsSensV').textContent=(+SET.sens).toFixed(1)+'x';
}
document.getElementById('hsCompact').onclick=()=>{ HS.compact=!HS.compact; saveHS(); applyHS(); syncHomeSettings(); };
document.getElementById('hsPubOnly').onclick=()=>{ HS.pubOnly=!HS.pubOnly; saveHS(); syncHomeSettings(); renderCommunity(); };
document.getElementById('hsAuto').onclick=()=>{ HS.auto=!HS.auto; saveHS(); syncHomeSettings(); };
function gameSettingChanged(){ camera.fov=SET.fov; camera.updateProjectionMatrix(); saveSettings(); syncHomeSettings(); syncSettingsUI(); }
document.getElementById('hsVol').oninput=e=>{ SET.vol=+e.target.value; gameSettingChanged(); };
document.getElementById('hsVol').onchange=()=>sfx.coin();
document.getElementById('hsFov').oninput=e=>{ SET.fov=+e.target.value; gameSettingChanged(); };
document.getElementById('hsSens').oninput=e=>{ SET.sens=+e.target.value; gameSettingChanged(); };
document.getElementById('hsInv').onclick=()=>{ SET.inv=!SET.inv; gameSettingChanged(); };
document.getElementById('hsFps').onclick=()=>{ SET.fps=!SET.fps; gameSettingChanged(); };
document.getElementById('hsReset').onclick=()=>{ Object.assign(HS,HS_DEF); Object.assign(SET,SET_DEF); saveHS(); applyHS(); gameSettingChanged(); renderCommunity(); document.getElementById('hsNote').textContent='Settings reset.'; setTimeout(()=>document.getElementById('hsNote').textContent='',2500); };
document.getElementById('tabSettings').onclick=()=>showTab('settings');
applyHS();

// ---------- Community games: publish a Webby Create game to the homepage ----------
// There is no Webby server, so the catalog is shared peer to peer: every open Webby keeps a copy of the catalog in this
// browser, and a few of them (webby-dir-1..8) also answer when another Webby asks "what games do you know about?".
// Public games travel with their code. Private and whitelisted games only travel as a listing; their code is handed out
// by the developer's own Webby (checked against the whitelist) and only while the developer is online.
const CAT_KEY='webbyCatalog', DIRS=8, CAT_MAX=150;
let catalog={}, catDirty=true, catSyncing=false, catLast=0, dirPeer=null, dirBusy=false;
const gkOf=e=>(e.u+'_'+e.id).replace(/[^A-Za-z0-9_-]/g,'').slice(0,48);
function cleanEntry(e){
  if(!e || typeof e!=='object') return null;
  const u=uidOf(e.u); if(!u || typeof e.id!=='string' || !/^[A-Za-z0-9_-]{1,40}$/.test(e.id)) return null;
  const t=Number.isFinite(e.t)?e.t:0;
  if(t>Date.now()+3600000) return null;   // nobody can pin a listing (or a delete) to the top with a fake future date
  const o={k:u+':'+e.id, u, id:e.id, t};
  if(e.ban){   // a removal by the moderator: signed, so other players can't fake it
    o.ban=1; o.why=String(e.why||'').slice(0,200);
    if(typeof e.pk!=='string' || !/^[\w-]{20,100}\.[\w-]{20,100}$/.test(e.pk) || typeof e.sig!=='string' || !/^[\w-]{60,140}$/.test(e.sig)) return null;
    o.pk=e.pk; o.sig=e.sig; return o;
  }
  if(e.rm){ o.rm=1; return o; }
  if(typeof e.n!=='string' || !['public','private','whitelist'].includes(e.v) || e.lang!=='lua' || !isThumb(e.th)) return null;   // a thumbnail is required   // only Lua games are shared: Lua can't touch your computer
  o.dn=String(e.dn||u).slice(0,24); o.n=e.n.slice(0,40); o.ab=typeof e.ab==='string'?e.ab.slice(0,400):''; o.v=e.v; o.lang='lua';
  o.th=e.th; o.al=Array.isArray(e.al)?[...new Set(e.al.map(x=>typeof x==='string'?uidOf(x):null).filter(Boolean))].slice(0,50):[];
  if(e.v==='public' && typeof e.code==='string' && e.code.length<=20000) o.code=e.code;
  o.gk=gkOf(o);
  return o;
}
function loadCatalog(){
  catalog={};
  try{ const a=JSON.parse(localStorage.getItem(CAT_KEY)||'[]'); if(Array.isArray(a)) a.forEach(x=>{ const c=cleanEntry(x); if(c) catalog[c.k]=c; }); }catch(e){}
}
function saveCatalog(){
  let list=Object.values(catalog).sort((a,b)=>b.t-a.t);
  const bans=list.filter(e=>e.ban).slice(0,300), rm=list.filter(e=>e.rm).slice(0,100), live=list.filter(e=>!e.rm && !e.ban).slice(0,CAT_MAX);
  catalog={}; bans.concat(rm,live).forEach(e=>catalog[e.k]=e);
  for(let tries=0;tries<4;tries++){
    try{ localStorage.setItem(CAT_KEY,JSON.stringify(Object.values(catalog))); return; }
    catch(e){ const v=Object.values(catalog).filter(x=>!x.rm && !x.ban).sort((a,b)=>a.t-b.t); if(!v.length) return; delete catalog[v[0].k]; }
  }
}
async function mergeEntries(list){
  let changed=false; const ok=[];
  for(const x of (Array.isArray(list)?list:[]).slice(0,CAT_MAX+100)){
    const c=cleanEntry(x); if(!c) continue;
    if(c.ban && !(await verifyBan(c))) continue;
    ok.push(c);
  }
  ok.forEach(c=>{
    const old=catalog[c.k];
    if(old && old.ban && !(c.ban && c.t>old.t)) return;   // once the moderator removed a game it stays removed
    if(acct && c.u===acct.uid && !c.rm && !c.ban && profile.games.some(q=>q.id===c.id)) return;   // my own games on this computer are decided by my own profile, never by what others tell me
    if(!old || c.t>old.t || (c.ban && !old.ban)){ catalog[c.k]=c; changed=true; if(c.ban) onBan(c); }
  });
  if(changed) saveCatalog();
  return changed;
}
function onBan(c){
  if(acct && c.u===acct.uid){
    const g=profile.games.find(q=>q.id===c.id);
    if(g && !g.banned){ g.pub=null; g.banned=c.why||'Removed by the moderator.'; saveProfile(); addWarning({text:'Your game was removed from Webby by the moderator.'+(c.why?' Reason: '+c.why:''),game:g.name,kind:'removed'}); renderGames(); }
  }
}
function myEntries(){
  if(!acct) return [];
  return profile.games.filter(g=>g.pub && g.lang==='lua').map(g=>{
    const o={u:acct.uid,id:g.id,t:g.pub.t,dn:myName,n:g.name,ab:g.pub.about,v:g.pub.vis,al:g.pub.al,th:g.pub.th,lang:'lua'};
    if(g.pub.vis==='public') o.code=g.code;
    return cleanEntry(o);
  }).filter(Boolean);
}
function refreshOwn(){   // put my published games into my own copy of the catalog
  if(!acct) return;
  myEntries().forEach(e=>{ if(!(catalog[e.k] && catalog[e.k].ban)) catalog[e.k]=e; });
  saveCatalog();
}
async function onDirMsg(m,c){
  if(!m || typeof m!=='object' || m.k!=='cat') return;
  await mergeEntries(m.push);
  const have=(m.have && typeof m.have==='object')?m.have:{};
  const out=Object.values(catalog).filter(e=>!(Number.isFinite(have[e.k]) && have[e.k]>=e.t)).sort((a,b)=>(b.ban?1:0)-(a.ban?1:0) || b.t-a.t).slice(0,40);   // removals first, then newest; the rest follow on the next refresh
  try{ c.send({k:'cat',list:out}); }catch(e){}
}
async function startDir(){
  if(dirPeer || dirBusy) return; dirBusy=true;
  try{
    await loadPeer();
    for(let n=1;n<=DIRS;n++){
      let pe; try{ pe=await claimSlot('webby-dir-'+n); }catch(e){ break; }
      if(!pe) continue;
      dirPeer=pe;
      pe.on('connection',c=>{ c.on('data',m=>onDirMsg(m,c)); });
      pe.on('error',()=>{});
      pe.on('disconnected',()=>{ try{ pe.reconnect(); }catch(e){} });
      pe.on('close',()=>{ if(dirPeer===pe) dirPeer=null; });
      break;
    }
  } finally { dirBusy=false; }
}
async function syncCatalog(force){
  if(catSyncing || (!force && Date.now()-catLast<15000)) return;
  catSyncing=true; catLast=Date.now();
  try{
    await loadPeer();
    const pe=probePeer(); if(!pe) return;
    for(let i=0;i<30 && !pe.open;i++) await sleep(200);
    if(!pe.open) return;
    const have={}; Object.values(catalog).forEach(e=>{ have[e.k]=e.t; });
    const push=catDirty ? myEntries().concat(Object.values(catalog).filter(e=>(e.rm && acct && e.u===acct.uid) || (e.ban && isMod()))) : [];
    const jobs=[]; for(let n=1;n<=DIRS;n++) jobs.push(askRaw(pe,'webby-dir-'+n,{k:'cat',have,push},{cat:1},d=>d && d.k==='cat'));
    const res=await Promise.all(jobs); let got=0;
    for(const d of res){ if(d && Array.isArray(d.list)){ got++; await mergeEntries(d.list); } }
    if(got) catDirty=false;
  } catch(e){}
  finally { catSyncing=false; renderCommunity(); }
}
function canPlay(e){
  if(!acct) return false;
  if(e.u===acct.uid || e.v==='public' || isMod()) return true;
  return e.v==='whitelist' && e.al.includes(acct.uid);
}
function accessMsg(e){ return e.v==='private' ? 'This game is private. Only its developer can play it.' : 'This game is whitelisted. Ask '+e.dn+' to add your username.'; }
async function getGameData(e){
  if(acct && e.u===acct.uid){ const g=profile.games.find(q=>q.id===e.id); return g?{name:g.name,lang:g.lang,code:g.code,dev:e.dn}:null; }
  if(e.code) return {name:e.n,lang:'lua',code:e.code,dev:e.dn};
  const r=await ask(e.u,{t:'game',id:e.id});
  if(r && r.t==='game' && r.ok && typeof r.code==='string' && r.lang==='lua') return {name:e.n,lang:'lua',code:r.code.slice(0,20000),dev:e.dn};
  return {err: r ? (r.why==='denied' ? accessMsg(e) : 'That game is not available any more.') : 'The developer of this game is offline right now, so it cannot be loaded. Try again later.'};
}
function hueOf(str){ let h=0; for(const ch of String(str)) h=(h*31+ch.charCodeAt(0))>>>0; return h%360; }
const VIS_LABEL={public:'Public',private:'Private',whitelist:'Whitelisted'};
function renderCommunity(){
  const box=document.getElementById('commBox'); if(!box) return;
  const q=((document.getElementById('commSearch')||{}).value||'').trim().toLowerCase(), terms=q.split(/\s+/).filter(Boolean);
  let list=Object.values(catalog).filter(e=>!e.rm && !e.ban);
  if(terms.length) list=list.filter(e=>{ const hay=(censor(e.n).text+' '+censor(e.dn).text+' '+censor(e.ab||'').text+' @'+e.u).toLowerCase(); return e.v==='public' && terms.every(t=>hay.includes(t)); });   // searching only ever shows public games
  else if(HS.pubOnly) list=list.filter(e=>e.v==='public');
  list=list.sort((a,b)=>b.t-a.t).slice(0,terms.length?100:60);
  const hint=document.getElementById('commHint'); if(hint) hint.textContent=terms.length ? (list.length+' public game'+(list.length===1?'':'s')+' found. Search only shows public games.') : '';
  box.innerHTML='';
  if(!list.length){ const d=document.createElement('div'); d.className='pbox'; d.textContent=terms.length?'No public games match your search.':(HS.pubOnly?'No public games yet.':'No community games yet. Make one in Webby Create and press "Publish to Webby"!'); box.appendChild(d); return; }
  list.forEach(e=>{
    const row=document.createElement('div'); row.className='cgame';
    const th=document.createElement('div'); th.className='cgthumb'; const im=document.createElement('img'); im.alt=''; im.src=e.th; th.appendChild(im);
    const body=document.createElement('div'); body.className='cgbody';
    const h=document.createElement('h3'); h.textContent=censor(e.n).text;
    const tag=document.createElement('span'); tag.className='vtag '+e.v; tag.textContent=VIS_LABEL[e.v]; h.appendChild(tag);
    const by=document.createElement('div'); by.className='cgby'; by.textContent='By '+censor(e.dn).text+' \u00b7 Lua';
    const ab=document.createElement('div'); ab.className='cgabout'; ab.textContent=e.ab?censor(e.ab).text:'The developer has not written an about page yet.';
    const bt=document.createElement('div'); bt.className='cgbtns';
    const ok=canPlay(e);
    const play=document.createElement('button'); play.className='oplay small'; play.textContent='PLAY'; play.disabled=!ok; play.onclick=()=>playCommunity(e);
    const sv=document.createElement('button'); sv.className='srvbtn'; sv.style.cssText='margin:0;padding:6px 18px;font-size:14px'; sv.textContent='SERVERS'; sv.disabled=!ok; sv.onclick=()=>openServers(e);
    const dl=document.createElement('button'); dl.className='opt'; dl.textContent='Download .html'; dl.disabled=!ok; dl.onclick=()=>downloadCommunity(e,dl);
    bt.appendChild(play); bt.appendChild(sv); bt.appendChild(dl);
    if(acct && e.u!==acct.uid){
      const done=profile.reported.includes(e.k);
      const rp=document.createElement('button'); rp.className='opt'; rp.textContent=done?'Reported':'Report'; rp.disabled=done; rp.onclick=()=>openReport(e); bt.appendChild(rp);
    }
    if(isMod()){ const rm=document.createElement('button'); rm.className='opt'; rm.style.cssText='border-color:#c0392b;color:#c0392b'; rm.textContent='Remove (mod)'; rm.onclick=()=>openModDlg('remove',{u:e.u,id:e.id,gn:e.n}); bt.appendChild(rm); }
    if(!ok){ const n=document.createElement('span'); n.className='cgnote'; n.textContent=e.v==='private'?'Only the developer can play this.':'You are not on the whitelist.'; bt.appendChild(n); }
    body.appendChild(h); body.appendChild(by); body.appendChild(ab); body.appendChild(bt);
    row.appendChild(th); row.appendChild(body); box.appendChild(row);
  });
}
async function playCommunity(e,opts){
  if(joining||running||customMode||!acct) return;
  if(!canPlay(e)){ showDlg(accessMsg(e)); return; }
  joining=true;
  if(activeOther()){ joining=false; showDlg(); return; }
  claimActive(); await sleep(150);
  if(activeOther()){ joining=false; showDlg(); return; }
  playing=true; playingName=e.n;
  const ld=document.getElementById('loading'), nm=ld.querySelector('.lname'), bl=ld.querySelector('.lby'), st=document.getElementById('lstat');
  const old=[nm.textContent,bl.textContent];
  nm.textContent=e.n; bl.textContent='By '+e.dn; st.textContent='Getting the game...'; ld.classList.remove('hide');
  const t0=performance.now();
  const undo=()=>{ ld.classList.add('hide'); nm.textContent=old[0]; bl.textContent=old[1]; joining=false; };
  const fail=msg=>{ undo(); playing=false; playingName=''; releaseActive(); showDlg(msg); };
  const g=await getGameData(e);
  if(!g || g.err){ fail(g&&g.err?g.err:'Could not load this game.'); return; }
  st.textContent='Joining server...';
  const iv=setInterval(()=>{ st.textContent=document.getElementById('pstat').textContent||'Joining server...'; },300);
  let res='fail'; try{ res=await joinPublic(opts&&opts.pub?opts.pub:null, e.gk); }catch(x){}
  clearInterval(iv); st.textContent='Entering the server...';
  await sleep(Math.max(0,2800-(performance.now()-t0)));
  if(opts && opts.pub && res!=='ok'){ fail(res==='full'?'That server is full.':'Could not join that server. It may have closed.'); return; }
  undo(); hstat.textContent='';
  recordPlayed(e.n,{k:e.k,by:e.dn});
  startCustom({name:g.name,lang:'lua',code:g.code},{community:true});
  if(res!=='ok') engine.message('Could not join a server, so you are playing alone.',4);
}
// ----- Publish dialog -----
let pubTh='';
function showPubThumb(){ const b=document.getElementById('pubThumb'); b.innerHTML=''; if(pubTh){ const i=document.createElement('img'); i.alt=''; i.src=pubTh; b.appendChild(i); } else b.textContent='No image yet'; }
function makeThumb(file){
  return new Promise((res,rej)=>{
    const url=URL.createObjectURL(file), img=new Image();
    img.onload=()=>{
      URL.revokeObjectURL(url);
      for(const [W,H] of [[320,180],[256,144],[192,108]]){
        const c=document.createElement('canvas'); c.width=W; c.height=H; const x=c.getContext('2d');
        const sc=Math.max(W/img.width,H/img.height), w=img.width*sc, h=img.height*sc;
        x.fillStyle='#fff'; x.fillRect(0,0,W,H); x.drawImage(img,(W-w)/2,(H-h)/2,w,h);
        for(const q of [0.8,0.65,0.5,0.4]){ const d=c.toDataURL('image/jpeg',q); if(isThumb(d)){ res(d); return; } }
      }
      rej(new Error('big'));
    };
    img.onerror=()=>{ URL.revokeObjectURL(url); rej(new Error('bad')); };
    img.src=url;
  });
}
const pubEl=document.getElementById('pub'), pubAbout=document.getElementById('pubAbout'), pubVis=document.getElementById('pubVis'), pubAllow=document.getElementById('pubAllow'), pubNote=document.getElementById('pubNote');
function pubSyncUI(){ document.getElementById('pubAllowWrap').classList.toggle('hide',pubVis.value!=='whitelist'); }
pubVis.onchange=pubSyncUI;
[pubAbout,pubAllow].forEach(el=>{ el.addEventListener('keydown',ev=>ev.stopPropagation()); el.addEventListener('keyup',ev=>ev.stopPropagation()); });
function openPublish(){
  if(!curGame) return; saveCurrent(true);
  if(curGame.banned){ cNote.textContent='This game was removed by the moderator and cannot be published again. '+curGame.banned; return; }
  if(curGame.lang!=='lua'){ cNote.textContent='Only Lua games can be published (JavaScript has no safety box). Switch the language to Lua to publish.'; return; }
  const pb=curGame.pub;
  pubTh=(pb&&pb.th)||''; showPubThumb();
  pubAbout.value=pb?pb.about:''; pubVis.value=pb?pb.vis:'public'; pubAllow.value=pb?pb.al.join(', '):''; pubNote.textContent='';
  document.getElementById('pubTitle').textContent=pb?'Update "'+curGame.name+'"':'Publish "'+curGame.name+'"';
  document.getElementById('pubGo').textContent=pb?'UPDATE':'PUBLISH';
  document.getElementById('pubRemove').classList.toggle('hide',!pb);
  pubSyncUI(); pubEl.classList.remove('hide'); pubAbout.focus();
}
document.getElementById('pubPick').onclick=()=>document.getElementById('pubFile').click();
document.getElementById('pubFile').onchange=async ev=>{
  const f=ev.target.files && ev.target.files[0]; ev.target.value=''; if(!f) return;
  if(!/^image\//.test(f.type)){ pubNote.textContent='Please choose an image file.'; return; }
  try{ pubTh=await makeThumb(f); showPubThumb(); pubNote.textContent=''; }
  catch(e){ pubNote.textContent='Could not use that image. Try a different one.'; }
};
document.getElementById('cPublish').onclick=openPublish;
document.getElementById('pubCancel').onclick=()=>pubEl.classList.add('hide');
document.getElementById('pubGo').onclick=()=>{
  if(!curGame || !acct) return;
  const about=pubAbout.value.trim().slice(0,400), vis=pubVis.value;
  if(censor(curGame.name).count || censor(about).count){ pubNote.textContent='Please remove swear words from the name or the about page.'; return; }
  if(!curGame.code.trim()){ pubNote.textContent='Your game has no code yet.'; return; }
  if(!pubTh){ pubNote.textContent='A thumbnail is required. Choose an image for your game first.'; return; }
  let al=[];
  if(vis==='whitelist'){
    const parts=pubAllow.value.split(/[,\s]+/).filter(Boolean), bad=parts.filter(x=>!uidOf(x));
    if(bad.length){ pubNote.textContent='These are not valid usernames: '+bad.slice(0,3).join(', '); return; }
    al=[...new Set(parts.map(uidOf))].slice(0,50);
  }
  curGame.pub={vis,about,al,th:pubTh,t:Date.now()}; saveProfile(); refreshOwn(); catDirty=true; renderGames(); renderCommunity(); syncCatalog(true);
  pubEl.classList.add('hide'); cNote.textContent='Published! It is on the Webby homepage now.';
};
document.getElementById('pubRemove').onclick=()=>{
  if(!curGame || !curGame.pub) return;
  const k=acct.uid+':'+curGame.id; curGame.pub=null; saveProfile();
  catalog[k]={k,u:acct.uid,id:curGame.id,t:Date.now(),rm:1}; saveCatalog(); catDirty=true; renderGames(); renderCommunity(); syncCatalog(true);
  pubEl.classList.add('hide'); cNote.textContent='Unpublished. It is gone from the homepage.';
};
// ----- Download a game as a standalone .html file -----
function buildStandalone(g,by){
  let h=WEBBY_PRISTINE;
  const TH='<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js';
  let i=h.indexOf(TH); if(i<0) return null;
  const mk='<script id="webby-'+'standalone">', j=h.lastIndexOf(mk,i);   // an older injected copy (when re-exporting a downloaded game)
  if(j>=0){ const e=h.indexOf('<\/script>',j); if(e>=0 && e<i){ h=h.slice(0,j)+h.slice(e+9).replace(/^\s+/,''); i=h.indexOf(TH); } }
  const data=JSON.stringify({name:g.name,by:by,lang:g.lang,code:g.code}).replace(/</g,'\\u003c').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');
  const tag=mk+'window.WEBBY_STANDALONE='+data+';<\/script>\n';
  h=h.slice(0,i)+tag+h.slice(i);
  const safe=String(g.name).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  return h.replace(/<title>[\s\S]*?<\/title>/,()=>'<title>'+safe+' - Webby</title>');
}
function saveHtmlFile(g,by){
  const html=buildStandalone(g,by); if(!html) return false;
  const blob=new Blob([html],{type:'text/html'}), a=document.createElement('a');
  a.href=URL.createObjectURL(blob); a.download=(String(g.name).replace(/[^A-Za-z0-9 _-]+/g,'').trim().replace(/\s+/g,'_')||'webby_game')+'.html';
  document.body.appendChild(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(a.href),4000);
  return true;
}
document.getElementById('cDownload').onclick=()=>{
  if(!curGame) return; saveCurrent(true);
  cNote.textContent=saveHtmlFile(curGame,myName)?'Downloaded! Open the .html file in any browser to play it (it needs an internet connection to load the 3D library).':'Could not build the file.';
};
async function downloadCommunity(e,btn){
  const old=btn.textContent; btn.textContent='Getting the game...'; btn.disabled=true;
  const g=await getGameData(e);
  btn.textContent=old; btn.disabled=!canPlay(e);
  if(!g || g.err){ showDlg(g&&g.err?g.err:'Could not load this game.'); return; }
  if(!saveHtmlFile({name:g.name,lang:g.lang,code:g.code},e.dn)) showDlg('Could not build the file.');
}
let _srchT=null;
document.getElementById('commSearch').addEventListener('input',()=>{ clearTimeout(_srchT); _srchT=setTimeout(renderCommunity,150); });
document.getElementById('commClear').onclick=()=>{ document.getElementById('commSearch').value=''; renderCommunity(); };
document.getElementById('commRefresh').onclick=()=>{ renderCommunity(); syncCatalog(true); };
loadCatalog();
setInterval(()=>{ if(HS.auto && acct && !home.classList.contains('hide') && !document.getElementById('viewHome').classList.contains('hide')) syncCatalog(); },45000);

// ---------- Reports and moderation (the moderator account is EEEEEEEL) ----------
const MOD_UID='eeeeeeel';
const MOD_PUB_FIXED='';   // optional: paste the moderator's public key here (shown on the Moderation tab) to lock it in for everyone using this file
const isMod=()=>!!acct && acct.uid===MOD_UID;
const subtle=(window.crypto && crypto.subtle) || null;
const b64u=buf=>btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
const unb64u=t=>Uint8Array.from(atob(t.replace(/-/g,'+').replace(/_/g,'/')),c=>c.charCodeAt(0));
const WHY_LABEL={image:'Inappropriate thumbnail',content:'Sensitive content',other:'Other'};
function modPinned(){ if(MOD_PUB_FIXED) return MOD_PUB_FIXED; try{ return localStorage.getItem('webbyModPub')||''; }catch(e){ return ''; } }
async function modEnsureKey(){
  if(!isMod() || !subtle) return;
  if(!profile.modKey){
    try{ const kp=await subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign','verify']); const j=await subtle.exportKey('jwk',kp.privateKey); profile.modKey={x:j.x,y:j.y,d:j.d}; saveProfile(); }
    catch(e){ return; }
  }
  if(!MOD_PUB_FIXED){ try{ localStorage.setItem('webbyModPub',profile.modKey.x+'.'+profile.modKey.y); }catch(e){} }
}
async function modSign(msg){
  const k=profile.modKey; const key=await subtle.importKey('jwk',{kty:'EC',crv:'P-256',x:k.x,y:k.y,d:k.d,ext:true},{name:'ECDSA',namedCurve:'P-256'},false,['sign']);
  return b64u(await subtle.sign({name:'ECDSA',hash:'SHA-256'},key,new TextEncoder().encode(msg)));
}
async function modVerifySig(pk,msg,sig){
  try{ const [x,y]=pk.split('.'); const key=await subtle.importKey('jwk',{kty:'EC',crv:'P-256',x,y,ext:true},{name:'ECDSA',namedCurve:'P-256'},false,['verify']);
    return await subtle.verify({name:'ECDSA',hash:'SHA-256'},key,unb64u(sig),new TextEncoder().encode(msg)); }catch(e){ return false; }
}
async function verifyBan(c){
  if(!subtle) return false;
  const pinned=modPinned(); if(pinned && pinned!==c.pk) return false;
  const ok=await modVerifySig(c.pk,'ban|'+c.u+'|'+c.id+'|'+c.t,c.sig);
  if(ok && !pinned){ try{ localStorage.setItem('webbyModPub',c.pk); }catch(e){} }   // first moderator key seen is remembered
  return ok;
}
async function modRemove(u,id,why){
  if(!isMod()) return 'Only the moderator can remove games.';
  if(!subtle || !profile.modKey) return 'This page cannot sign removals (it needs https or a local file).';
  const t=Date.now(), sig=await modSign('ban|'+u+'|'+id+'|'+t);
  const c=cleanEntry({u,id,t,ban:1,why,pk:profile.modKey.x+'.'+profile.modKey.y,sig}); if(!c) return 'Could not build the removal.';
  catalog[c.k]=c; saveCatalog(); catDirty=true;
  profile.inbox=profile.inbox.filter(r=>r.k!==c.k); saveProfile(); renderMod(); renderCommunity(); syncCatalog(true);
  return '';
}
// warnings the developer sees
function addWarning(w){
  profile.warnings.unshift({text:String(w.text||'').slice(0,300),game:String(w.game||'').slice(0,40),kind:w.kind==='removed'?'removed':'warning',t:Date.now(),seen:false});
  profile.warnings=profile.warnings.slice(0,20); saveProfile(); renderWarnings(); showWarnings();
}
function showWarnings(){
  const un=profile.warnings.filter(w=>!w.seen); if(!un.length) return;
  showDlg(un.map(w=>(w.kind==='removed'?'Game removed: ':'Warning from the Webby moderator: ')+(w.game?'"'+w.game+'" - ':'')+w.text).join('   \u2022   '));
  un.forEach(w=>w.seen=true); saveProfile();
}
function renderWarnings(){
  const box=document.getElementById('warnBox'); if(!box) return; box.innerHTML='';
  profile.warnings.slice(0,5).forEach(w=>{
    const d=document.createElement('div'); d.className='warnitem';
    d.textContent=(w.kind==='removed'?'\u26d4 Game removed: ':'\u26a0 Warning from the moderator: ')+(w.game?'"'+w.game+'" - ':'')+w.text+'  ('+new Date(w.t).toLocaleDateString()+')';
    box.appendChild(d);
  });
}
// sending reports and warnings (kept and retried if the other person is offline)
async function flushOut(){
  if(!acct || !userPeer || !userPeer.open) return;
  const jobs=[];
  if(!isMod()) profile.repQ.slice().forEach(r=>jobs.push(ask(MOD_UID,Object.assign({t:'report'},r)).then(a=>{ if(a && a.t==='repAck'){ profile.repQ=profile.repQ.filter(x=>x!==r); } })));
  if(isMod()) profile.modOut.slice().forEach(w=>jobs.push(ask(w.u,{t:'warn',gn:w.gn,text:w.text}).then(a=>{ if(a && a.t==='warnAck'){ profile.modOut=profile.modOut.filter(x=>x!==w); } })));
  if(jobs.length){ await Promise.all(jobs); saveProfile(); }
}
function addInbox(m,by){
  const r=cleanReport(m,by); if(!r) return;
  profile.inbox=profile.inbox.filter(x=>!(x.by===r.by && x.k===r.k)); profile.inbox.unshift(r); profile.inbox=profile.inbox.slice(0,25);
  saveProfile(); updateModBadge(); if(!document.getElementById('viewMod').classList.contains('hide')) renderMod();
}
function updateModBadge(){ const b=document.getElementById('tabMod'); if(b) b.textContent='Moderation'+(profile.inbox.length?' ('+profile.inbox.length+')':''); }
function modInit(){
  document.getElementById('tabMod').classList.toggle('hide',!isMod()); updateModBadge();
  renderWarnings(); showWarnings(); modEnsureKey().then(()=>{ if(isMod()) renderMod(); }); setTimeout(()=>flushOut(),1500);
}
document.getElementById('tabMod').onclick=()=>showTab('mod');
document.getElementById('modRefresh').onclick=()=>{ renderMod(); flushOut(); syncCatalog(true); };
// ----- report dialog -----
const repEl=document.getElementById('rep'), repNote=document.getElementById('repNote'); let repTarget=null;
['repDet','modTxt'].forEach(id=>{ const el=document.getElementById(id); el.addEventListener('keydown',ev=>ev.stopPropagation()); el.addEventListener('keyup',ev=>ev.stopPropagation()); });
function openReport(e){
  if(!acct || e.u===acct.uid) return; repTarget=e;
  document.getElementById('repTitle').textContent='Report "'+e.n+'"';
  const tb=document.getElementById('repThumb'); tb.innerHTML=''; const im=document.createElement('img'); im.alt=''; im.src=e.th; tb.appendChild(im);
  document.getElementById('repWho').textContent='By '+e.dn;
  document.getElementById('repWhy').value='image'; document.getElementById('repDet').value=''; repNote.textContent='';
  document.getElementById('repGo').disabled=false; repEl.classList.remove('hide');
}
document.getElementById('repCancel').onclick=()=>repEl.classList.add('hide');
document.getElementById('repGo').onclick=async()=>{
  const e=repTarget; if(!e || !acct) return;
  if(profile.reported.includes(e.k)){ repNote.textContent='You already reported this game.'; return; }
  const btn=document.getElementById('repGo'); btn.disabled=true; repNote.textContent='Sending...';
  const why=document.getElementById('repWhy').value, det=document.getElementById('repDet').value.trim().slice(0,300);
  const rep={u:e.u,id:e.id,gn:e.n,dn:e.dn,why,det,th:e.th,ts:Date.now()};
  if(why!=='image' && e.v!=='public'){ try{ const g=await getGameData(e); if(g && g.code) rep.code=g.code; }catch(x){} }   // the moderator can't open private/whitelisted games, so attach what the reporter saw
  const r=cleanReport(rep,'');
  profile.reported.unshift(e.k); profile.reported=profile.reported.slice(0,100);
  let sent=false;
  if(isMod()){ addInbox(r,acct.uid); sent=true; }
  else { try{ const a=await ask(MOD_UID,Object.assign({t:'report'},r)); sent=!!(a && a.t==='repAck'); }catch(x){} }
  if(!sent){ profile.repQ.push(r); profile.repQ=profile.repQ.slice(-5); }
  saveProfile(); renderCommunity(); repEl.classList.add('hide');
  showDlg(sent?'Thank you. Your report was sent to the moderator.':'Thank you. The moderator is offline right now, so your report is saved and will be sent automatically when they are online.');
};
// ----- moderator dialog (remove a game / warn a developer) -----
const modDlgEl=document.getElementById('modDlg'); let modAct=null;
function openModDlg(kind,d){
  if(!isMod()) return; modAct={kind,d};
  document.getElementById('modTitle').textContent=kind==='remove'?'Remove "'+d.gn+'"':'Warn the developer of "'+d.gn+'"';
  document.getElementById('modSub').textContent=kind==='remove'?'The game disappears from the homepage for everyone and its developer cannot publish it again. The developer is told why.':'The developer gets this message the next time they are online.';
  document.getElementById('modLbl').textContent=kind==='remove'?'Reason (shown to the developer)':'Warning message';
  document.getElementById('modTxt').value=''; document.getElementById('modNote').textContent=''; document.getElementById('modGo').textContent=kind==='remove'?'REMOVE GAME':'SEND WARNING';
  modDlgEl.classList.remove('hide'); document.getElementById('modTxt').focus();
}
document.getElementById('modCancel').onclick=()=>modDlgEl.classList.add('hide');
document.getElementById('modGo').onclick=async()=>{
  if(!modAct) return; const {kind,d}=modAct, txt=document.getElementById('modTxt').value.trim().slice(0,300), note=document.getElementById('modNote');
  if(kind==='warn' && !txt){ note.textContent='Write a message first.'; return; }
  if(kind==='remove'){ const err=await modRemove(d.u,d.id,txt); if(err){ note.textContent=err; return; } }
  else { profile.modOut.push({u:d.u,gn:d.gn,text:txt}); profile.modOut=profile.modOut.slice(-30); saveProfile(); flushOut(); }
  modDlgEl.classList.add('hide');
  showDlg(kind==='remove'?'Game removed.':'Warning queued. It is sent as soon as the developer is online.');
};
// ----- Moderation tab -----
function renderMod(){
  if(!isMod()) return;
  const info=document.getElementById('modInfo'); info.innerHTML='';
  const l1=document.createElement('div'); l1.textContent='Reports from players arrive here while you are online, or are delivered when you next log in as EEEEEEEL. You can remove a game for everyone, warn its developer, or dismiss the report.'; info.appendChild(l1);
  const l2=document.createElement('div'); l2.style.cssText='margin-top:8px;font-size:12px;color:#666;word-break:break-all';
  l2.textContent=subtle ? (profile.modKey ? 'Your moderator key (locked in on this computer; use the same computer so removals stay trusted): '+profile.modKey.x+'.'+profile.modKey.y : 'Creating your moderator key...') : 'Removals cannot be signed on this page: open Webby over https or as a local file.';
  info.appendChild(l2);
  const box=document.getElementById('modList'); box.innerHTML=''; updateModBadge();
  if(!profile.inbox.length){ const d=document.createElement('div'); d.className='pbox'; d.textContent='No reports right now.'; box.appendChild(d); return; }
  const counts={}; profile.inbox.forEach(r=>counts[r.k]=(counts[r.k]||0)+1);
  profile.inbox.forEach(r=>{
    const row=document.createElement('div'); row.className='cgame';
    const th=document.createElement('div'); th.className='cgthumb'; if(r.th){ const im=document.createElement('img'); im.alt=''; im.src=r.th; th.appendChild(im); }
    const body=document.createElement('div'); body.className='cgbody';
    const h=document.createElement('h3'); h.textContent=r.gn||r.id; const tg=document.createElement('span'); tg.className='rtag'; tg.textContent=WHY_LABEL[r.why]; h.appendChild(tg);
    const by=document.createElement('div'); by.className='cgby'; by.textContent='Developer: '+r.dn+' (@'+r.u+')  \u00b7  reported by @'+(r.by||'unknown')+'  \u00b7  '+new Date(r.ts).toLocaleString()+(counts[r.k]>1?'  \u00b7  '+counts[r.k]+' reports on this game':'');
    const ab=document.createElement('div'); ab.className='cgabout'; ab.textContent=r.det?'"'+r.det+'"':'(no details)';
    const bt=document.createElement('div'); bt.className='cgbtns';
    const en=catalog[r.k]; const live=en && !en.ban && !en.rm;
    const mk=(txt,fn,cls,dis)=>{ const b=document.createElement('button'); b.className=cls||'opt'; b.textContent=txt; b.disabled=!!dis; b.onclick=fn; bt.appendChild(b); return b; };
    mk('View game',()=>playCommunity(en),'oplay small',!live);
    mk('Remove game',()=>openModDlg('remove',{u:r.u,id:r.id,gn:r.gn}),'opt',!live);
    mk('Warn developer',()=>openModDlg('warn',{u:r.u,id:r.id,gn:r.gn}));
    mk('Dismiss',()=>{ profile.inbox=profile.inbox.filter(x=>x!==r); saveProfile(); renderMod(); });
    if(!live){ const n=document.createElement('span'); n.className='cgnote'; n.textContent=(en&&en.ban)?'Already removed.':'Not in your catalog right now.'; bt.appendChild(n); }
    body.appendChild(h); body.appendChild(by); body.appendChild(ab); body.appendChild(bt);
    row.appendChild(th); row.appendChild(body); box.appendChild(row);
  });
}

// ---------- Accounts: log in / create account ----------
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const b64e=u8=>btoa(String.fromCharCode.apply(null,u8));
const b64d=t=>Uint8Array.from(atob(t),c=>c.charCodeAt(0));
async function hashPw(pw,saltB64){
  const key=await crypto.subtle.importKey('raw',new TextEncoder().encode(pw),'PBKDF2',false,['deriveBits']);
  const bits=await crypto.subtle.deriveBits({name:'PBKDF2',salt:b64d(saltB64),iterations:100000,hash:'SHA-256'},key,256);
  return b64e(new Uint8Array(bits));
}
function getAccounts(){ try{ const a=JSON.parse(localStorage.getItem('webbyAccounts')||'{}'); return (a && typeof a==='object') ? a : {}; }catch(e){ return {}; } }
function putAccounts(a){ try{ localStorage.setItem('webbyAccounts',JSON.stringify(a)); }catch(e){} }
const lgUser=document.getElementById('lgUser'), lgPass=document.getElementById('lgPass'), lgPass2=document.getElementById('lgPass2'), lgMsg=document.getElementById('lgMsg'), lgGo=document.getElementById('lgGo');
let lgMode='in', lgFails=0;
function setLgMode(m){
  lgMode=m; lgMsg.textContent='';
  document.getElementById('lgTabIn').classList.toggle('on',m==='in');
  document.getElementById('lgTabNew').classList.toggle('on',m==='new');
  lgPass2.classList.toggle('hide',m!=='new');
  lgPass.autocomplete = m==='new' ? 'new-password' : 'current-password';
  lgGo.textContent = m==='new' ? 'CREATE ACCOUNT' : 'LOG IN';
}
async function createAccount(name,pw,pw2){
  name=String(name||'').trim();
  const uid=uidOf(name);
  if(!uid) return 'Usernames are 3 to 16 letters, numbers or single underscores (not at the start or end).';
  if(censor(name).count) return 'That username is not allowed.';
  if(pw.length<6) return 'Your password must be at least 6 characters.';
  if(pw!==pw2) return 'The passwords do not match.';
  const accts=getAccounts();
  if(accts[uid]) return 'That username is already taken on this computer.';
  const firstAccount=Object.keys(accts).length===0;
  const salt=b64e(crypto.getRandomValues(new Uint8Array(16)));
  accts[uid]={name, salt, hash:await hashPw(pw,salt), created:Date.now()};
  putAccounts(accts);
  if(!getAccounts()[uid]) return 'Your browser could not save the account (storage is turned off).';
  if(firstAccount){   // carry over the avatar from before accounts existed
    try{ const old=JSON.parse(localStorage.getItem('webbyProfile')||'null'); if(old){ localStorage.setItem('webbyProfile:'+uid,JSON.stringify(parseProfile(old))); localStorage.removeItem('webbyProfile'); } }catch(e){}
  }
  return {uid,name};
}
async function checkLogin(name,pw){
  const uid=uidOf(name), a=uid && getAccounts()[uid];
  if(!a) return null;
  return (await hashPw(pw,a.salt))===a.hash ? {uid,name:a.name} : null;
}
function loadAccount(a){
  acct=a;
  let sv=null; try{ sv=JSON.parse(localStorage.getItem('webbyProfile:'+a.uid)||'null'); }catch(e){}
  const p=parseProfile(sv);
  Object.keys(profile).forEach(k=>delete profile[k]); Object.assign(profile,p);
  myName=a.name; mySkin=profile.skin; myHat=profile.hat; myFace=profile.face;
  setSkin(player,mySkin); setLook(myChar,myHat,myFace);
  fstat.clear(); findU=null; _pkey=''; curGame=null;
  saveProfile(); renderAvatar(); renderProfile(); renderSocial(); refreshOwn(); catDirty=true; showTab('home');
  initUser(); startDir(); modInit();
}
function finishLogin(a){
  lgPass.value=''; lgPass2.value='';
  try{ if(document.getElementById('lgStay').checked) localStorage.setItem('webbySession',a.uid); else localStorage.removeItem('webbySession'); localStorage.setItem('webbyLastUser',a.name); }catch(e){}
  document.getElementById('login').classList.add('hide');
  loadAccount(a);
}
async function submitLogin(){
  lgMsg.textContent='';
  if(!window.crypto || !crypto.subtle){ lgMsg.textContent='This browser cannot protect passwords here. Try Chrome or Edge.'; return; }
  const u=lgUser.value.trim(), pw=lgPass.value;
  lgGo.disabled=true;
  try{
    if(lgMode==='new'){
      const r=await createAccount(u,pw,lgPass2.value);
      if(typeof r==='string'){ lgMsg.textContent=r; return; }
      finishLogin(r);
    } else {
      if(!u || !pw){ lgMsg.textContent='Enter your username and password.'; return; }
      const r=await checkLogin(u,pw);
      if(!r){ lgFails++; await sleep(Math.min(lgFails,5)*600); lgMsg.textContent='Wrong username or password.'; return; }
      lgFails=0; finishLogin(r);
    }
  } finally { lgGo.disabled=false; }
}
function logout(){
  try{ localStorage.removeItem('webbySession'); }catch(e){}
  saveProfile();
  if(acct){ try{ const k='webbyUserHold:'+acct.uid, h=JSON.parse(localStorage.getItem(k)||'null'); if(h && h.id===clientId) localStorage.removeItem(k); }catch(e){} }
  if(userPeer){ const p=userPeer; userPeer=null; try{ p.destroy(); }catch(e){} }
  acct=null;
  Object.keys(profile).forEach(k=>delete profile[k]); Object.assign(profile,freshProfile());
  myName='Guest'; mySkin=Y; myHat=0; myFace=0; setSkin(player,mySkin); setLook(myChar,0,0);
  fstat.clear(); findU=null; userMsg='Connecting...'; curGame=null;
  const has=Object.keys(getAccounts()).length>0; let last=''; try{ last=localStorage.getItem('webbyLastUser')||''; }catch(e){}
  setLgMode(has?'in':'new'); lgUser.value=has?last:''; lgPass.value=''; lgPass2.value='';
  document.getElementById('login').classList.remove('hide');
}
document.getElementById('lgTabIn').onclick=()=>setLgMode('in');
document.getElementById('lgTabNew').onclick=()=>setLgMode('new');
lgGo.onclick=submitLogin;
[lgUser,lgPass,lgPass2].forEach(el=>{ el.addEventListener('keydown',e=>{ e.stopPropagation(); if(e.key==='Enter') submitLogin(); }); el.addEventListener('keyup',e=>e.stopPropagation()); });
document.getElementById('logoutBtn').onclick=logout;
(function bootLogin(){
  if(window.WEBBY_STANDALONE){   // this file was downloaded from Webby: skip the login and go straight into the game
    const W=window.WEBBY_STANDALONE;
    window.WEBBY_GAME={name:String(W.name||'Webby game'),lang:W.lang==='js'?'js':'lua',code:String(W.code||'')};
    document.getElementById('login').classList.add('hide'); home.classList.add('hide');
    acct={uid:'standalone',name:'Player'}; myName='Player'; document.title=window.WEBBY_GAME.name+' - Webby';
    setTimeout(()=>startCustom(window.WEBBY_GAME),80);
    return;
  }
  const accts=getAccounts(); let sess=null, last='';
  try{ sess=localStorage.getItem('webbySession'); last=localStorage.getItem('webbyLastUser')||''; }catch(e){}
  if(sess && accts[sess]){ document.getElementById('login').classList.add('hide'); loadAccount({uid:sess,name:accts[sess].name}); return; }
  const has=Object.keys(accts).length>0;
  setLgMode(has?'in':'new'); if(has) lgUser.value=last;
})();
</script>
</body>
</html>
