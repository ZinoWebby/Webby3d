    m1('asin',Math.asin); m1('acos',Math.acos); m1('exp',Math.exp);
    M.set('atan',(y,x)=>opt(x)?Math.atan(num(y,1,'atan')):Math.atan2(num(y,1,'atan'),num(x,2,'atan')));
    M.set('log',(x,b)=>opt(b)?Math.log(num(x,1,'log')):Math.log(num(x,1,'log'))/Math.log(num(b,2,'log')));
    M.set('max',(...a)=>Math.max(...a.map((v,i)=>num(v,i+1,'max'))));
    M.set('min',(...a)=>Math.min(...a.map((v,i)=>num(v,i+1,'min'))));
    M.set('fmod',(a,b)=>num(a,1,'fmod')%num(b,2,'fmod'));
