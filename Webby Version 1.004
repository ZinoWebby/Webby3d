<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Webby</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<style>
:root{--acc:#2775c4;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html,body{height:100%;margin:0;background:#111;overflow:hidden;font-family:"Trebuchet MS",Arial,sans-serif;color:#fff}
canvas{display:block;width:100%;height:100%}
.sq{border:3px solid #fff;border-radius:10px;background:#000;color:#fff;font:bold 22px "Trebuchet MS",Arial,sans-serif;padding:14px 26px;cursor:pointer}
.sq:hover{background:#222}
#help{position:fixed;bottom:calc(76px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);font-size:14px;background:#000;border:2px solid #fff;border-radius:8px;padding:6px 12px;white-space:nowrap}
.ov{position:fixed;inset:0;background:rgba(0,0,0,.7);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px}
.ov h1{margin:0;font-size:28px;letter-spacing:2px}
.bar{width:min(320px,70vw);height:22px;border:3px solid #fff;border-radius:8px;padding:3px;background:#000}
#fill{height:100%;width:0;background:#fff;border-radius:3px}
#ltext{font-size:16px;margin-top:10px;text-align:center;min-height:20px}
#chat{position:fixed;left:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));width:min(260px,28vw);display:flex;flex-direction:column;gap:4px}
#clog{display:flex;flex-direction:column;gap:3px;font-size:13px}
.cm{background:rgba(0,0,0,.8);border:2px solid #fff;border-radius:6px;padding:3px 8px;word-break:break-word}
#ci{background:#000;color:#fff;border:2px solid #fff;border-radius:6px;padding:6px 8px;font:14px "Trebuchet MS",Arial,sans-serif;outline:none}
#pb{position:fixed;top:calc(12px + env(safe-area-inset-top,0px));right:12px;padding:4px 12px;font-size:26px;line-height:1.2}
#pp{position:fixed;top:calc(70px + env(safe-area-inset-top,0px));right:12px;width:250px;background:rgba(0,0,0,.9);border:3px solid #fff;border-radius:10px;padding:10px;display:flex;flex-direction:column;gap:8px}
#pp .wt{font-weight:bold;text-align:center;font-size:18px}
#pp .pd{font-size:13px;opacity:.85}
#pp .it{font-size:15px;padding:8px}
#pp input{background:#000;color:#fff;border:2px solid #fff;border-radius:6px;padding:7px;font:15px "Trebuchet MS",Arial,sans-serif;outline:none;width:100%;box-sizing:border-box;margin-bottom:6px;text-transform:uppercase}
#pstat{font-size:12px;min-height:16px}
.hrow{display:flex;justify-content:space-between;align-items:center;gap:6px;font-size:13px;margin-bottom:4px}
#pp .hrow .it{padding:4px 10px;font-size:13px}
#hplist{font-size:13px}
.pc{font-size:30px;font-weight:bold;letter-spacing:6px;text-align:center;border:2px solid #fff;border-radius:8px;padding:6px;margin-bottom:6px}
#names{position:fixed;inset:0;pointer-events:none;overflow:hidden}
.nm{position:absolute;left:0;top:0;text-align:center;color:#fff;font-size:20px;font-weight:normal;letter-spacing:.5px;text-shadow:0 0 3px #000,0 1px 3px #000,0 0 6px rgba(0,0,0,.6);white-space:nowrap;will-change:transform}
#hp{position:fixed;top:calc(12px + env(safe-area-inset-top,0px));left:12px;display:flex;align-items:center;gap:8px;background:#000;border:3px solid #fff;border-radius:10px;padding:8px 12px}
.hpb{width:160px;height:16px;border:2px solid #fff;border-radius:4px;padding:2px}
#hpf{height:100%;width:100%;background:#4caf50}
#hpt{font-weight:bold;font-size:15px;min-width:44px}
.hb{width:76px;height:9px;border:2px solid #000;border-radius:3px;background:rgba(0,0,0,.6);margin:3px auto 0;box-sizing:border-box}
.hf{height:100%;width:100%}
.bub{position:absolute;left:0;top:0;max-width:200px;background:#fff;color:#111;border-radius:12px;padding:6px 12px;font-size:14px;line-height:1.25;text-align:center;word-wrap:break-word;box-shadow:0 1px 4px rgba(0,0,0,.35);will-change:transform}
.bub::after{content:"";position:absolute;left:50%;bottom:-7px;margin-left:-7px;border:7px solid transparent;border-bottom:0;border-top-color:#fff}
#xh{position:fixed;left:50%;top:50%;width:6px;height:6px;margin:-3px 0 0 -3px;border-radius:50%;background:#fff;border:1px solid #000;pointer-events:none}
#home{position:fixed;inset:0;z-index:50;background:#e4e4e7;color:#1a1a1a;display:flex;flex-direction:column;overflow:auto;font-family:Arial,Helvetica,sans-serif}
.htop{display:flex;align-items:center;gap:12px;height:46px;padding:0 18px;background:var(--acc);color:#fff;flex:none;box-shadow:0 1px 4px rgba(0,0,0,.3)}
.logo{width:26px;height:26px;border-radius:6px;background:#fff;color:var(--acc);font-weight:bold;font-size:18px;display:flex;align-items:center;justify-content:center}
.hname{font-weight:bold;font-size:16px}
.hmain{width:100%;max-width:980px;box-sizing:border-box;margin:0 auto;padding:36px 28px}
.hsec{font-size:22px;font-weight:bold;letter-spacing:.5px;margin-bottom:12px}
.gcard{display:flex;gap:24px;align-items:center;flex-wrap:wrap;background:#fff;border-radius:6px;padding:22px;box-shadow:0 1px 4px rgba(0,0,0,.15)}
.thumb{position:relative;width:22em;height:13em;font-size:15px;border-radius:6px;overflow:hidden;background:linear-gradient(#9fd3f0,#d7efff);flex:none;box-shadow:0 1px 4px rgba(0,0,0,.25)}
.thumb *{position:absolute}
.cinfo{flex:1;min-width:230px}
.cinfo h3{margin:0 0 8px;font-size:30px;font-weight:bold}
.cinfo p{margin:0 0 20px;color:#555;font-size:16px;line-height:1.45}
.oplay{background:#d9531e;color:#fff;border:0;border-radius:4px;padding:12px 44px;font:bold 17px Arial,Helvetica,sans-serif;letter-spacing:1px;cursor:pointer}
.oplay:hover{background:#c04718}
.oplay:disabled{opacity:.6;cursor:default}
#hstat{margin-top:12px;font-size:14px;color:#555;min-height:18px}
.sq:disabled{opacity:.5;cursor:default}
#loading{position:fixed;inset:0;z-index:60;background:#2d2d2d;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:Arial,Helvetica,sans-serif;text-align:center}
.ico{position:relative;width:13em;height:13em;font-size:12px;overflow:hidden;border-radius:6px;background:linear-gradient(#9fd3f0,#d7efff);box-shadow:0 2px 10px rgba(0,0,0,.5);margin-bottom:18px}
.icoin{position:absolute;left:-4em;bottom:0;width:22em;height:13em}
.icoin *{position:absolute}
.lname{font-size:36px;margin-bottom:6px}
.lby{font-size:14px;color:#bdbdbd;margin-bottom:6px}
.lstat{font-size:13px;color:#9e9e9e;min-height:16px}
.lw{position:fixed;right:22px;bottom:22px;width:42px;height:42px;background:#fff;color:#2d2d2d;font:bold 26px Arial,Helvetica,sans-serif;border-radius:7px;display:flex;align-items:center;justify-content:center;animation:wspin 1.8s ease-in-out infinite}
@keyframes wspin{0%{transform:rotate(0deg) scale(1)}50%{transform:rotate(180deg) scale(.78)}100%{transform:rotate(360deg) scale(1)}}

.tab{background:none;border:0;color:#d6e6f7;font:bold 15px Arial,Helvetica,sans-serif;padding:0 16px;height:46px;cursor:pointer;border-bottom:3px solid transparent;box-sizing:border-box}
.tab:hover{color:#fff}
.tab.on{color:#fff;border-bottom-color:#fff}
.who{margin-left:auto;display:flex;align-items:center;gap:8px;font-weight:bold;font-size:14px}
.whoc{width:16px;height:16px;border-radius:4px;border:2px solid #fff;display:inline-block}
.avc{align-items:flex-start}
.avprev{text-align:center;flex:none;background:#eef3f8;border-radius:6px;padding:18px 28px}
.avbox{position:relative;width:14em;height:15em;font-size:14px}
.avbox *{position:absolute}
.avname{margin-top:12px;font-weight:bold;font-size:17px}
#swatches{display:flex;flex-wrap:wrap;gap:8px;max-width:330px;margin-bottom:18px}
.sw{width:44px;height:44px;border-radius:6px;border:3px solid #fff;box-shadow:0 0 0 1px #aaa;cursor:pointer;padding:0}
.sw.on{box-shadow:0 0 0 3px var(--acc)}
.avrow{font-size:15px;color:#333}
.avrow input{vertical-align:middle;margin-left:8px;width:50px;height:30px;border:0;padding:0;background:none;cursor:pointer}
#dlg{position:fixed;inset:0;z-index:70;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;font-family:Arial,Helvetica,sans-serif}
.dbox{background:#fff;color:#1a1a1a;border-radius:8px;padding:26px 30px;max-width:380px;text-align:center;box-shadow:0 4px 20px rgba(0,0,0,.4)}
.dmsg{font-size:17px;line-height:1.45;margin-bottom:20px}
.sub{font-weight:bold;font-size:16px;margin:18px 0 8px;color:#222}
.opts{display:flex;flex-wrap:wrap;gap:8px}
.opt{background:#fff;border:2px solid #bbb;border-radius:6px;padding:8px 14px;font:bold 14px Arial,Helvetica,sans-serif;cursor:pointer;color:#222}
.opt:hover{border-color:var(--acc)}
.opt.on{border-color:var(--acc);background:#e8f1fb}
#pp{max-height:calc(100vh - 90px);overflow-y:auto}
#ptabParty{display:flex;flex-direction:column;gap:8px}
.ptabs{display:flex;gap:6px}
.ptab{flex:1;background:#000;color:#fff;border:2px solid #fff;border-radius:6px;padding:6px 4px;font:bold 13px "Trebuchet MS",Arial,sans-serif;cursor:pointer}
.ptab.on{background:#fff;color:#000}
.prow{display:flex;gap:12px;align-items:center;border:2px solid #fff;border-radius:8px;padding:8px;margin-bottom:8px;background:#111}
.pav{position:relative;width:14em;height:15em;font-size:6px;background:#eef3f8;border-radius:6px;overflow:hidden;flex:none}
.pav *,.pface *{position:absolute}
.pface{position:relative;width:5em;height:5em;font-size:10px;overflow:hidden;background:#eef3f8;border-radius:6px;margin-bottom:6px}
.pfin{position:absolute;left:-4.2em;bottom:-8.3em;width:14em;height:15em}
.pname{font-weight:bold;font-size:14px;word-break:break-all}
.who{cursor:pointer}
.who:hover span{text-decoration:underline}
.whoav{font-size:6px;margin:0 !important;border:2px solid #fff;box-sizing:content-box}
.pbox{background:#fff;border-radius:6px;padding:20px;box-shadow:0 1px 4px rgba(0,0,0,.15);margin-bottom:22px;color:#1a1a1a}
.phead{display:flex;align-items:center;gap:20px}
.phead .pface{font-size:16px;margin:0;border-radius:50%}
.ptitle{font-size:30px;font-weight:bold}
.psub{color:#666;font-size:14px;margin-top:4px}
.aboutv{white-space:pre-wrap;word-wrap:break-word;font-size:15px;line-height:1.5;color:#222;min-height:24px}
.aboutv.empty{color:#888;font-style:italic}
#aboutTxt{width:100%;box-sizing:border-box;min-height:110px;padding:10px;font:15px Arial,Helvetica,sans-serif;border:2px solid #bbb;border-radius:6px;resize:vertical}
.arow{display:flex;align-items:center;gap:10px;margin-top:12px;flex-wrap:wrap}
.oplay.small{padding:8px 22px;font-size:14px}
#aboutNote{font-size:13px;color:#666}
.rrow{display:flex;align-items:center;gap:14px;padding:8px 0;border-bottom:1px solid #eee}
.rrow:last-child{border-bottom:0}
.ico.ricon{font-size:4.5px;margin:0;flex:none}
.rname{font-weight:bold;font-size:17px}
.rsub{color:#666;font-size:13px;margin-top:3px}
.pwear{display:flex;gap:26px;align-items:center;flex-wrap:wrap}
.pwinfo{display:flex;flex-direction:column;gap:12px;font-size:16px}
.srow{display:flex;gap:10px}
.srow input{flex:1;padding:10px 12px;font:15px Arial,Helvetica,sans-serif;border:2px solid #bbb;border-radius:6px;box-sizing:border-box}
.fnote{font-size:13px;color:#666;margin:10px 0;min-height:16px}
.frow{display:flex;align-items:center;gap:14px;padding:10px 0;border-bottom:1px solid #eee}
.frow:last-child{border-bottom:0}
.frow .pface{font-size:9px;margin:0;flex:none}
.fgrow{flex:1}
.fname{font-weight:bold;font-size:16px}
.fstat{font-size:13px;color:#666;margin-top:3px}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px;background:#9e9e9e}
.dot.on{background:#3fa34d}
.srvbtn{background:#fff;color:#d9531e;border:2px solid #d9531e;border-radius:4px;padding:10px 26px;font:bold 17px Arial,Helvetica,sans-serif;letter-spacing:1px;margin-left:10px;cursor:pointer}
.srvbtn:hover{background:#fdeee7}
#srv{position:fixed;inset:0;z-index:65;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;font-family:Arial,Helvetica,sans-serif}
.srvbox{width:min(660px,92vw);max-width:none;max-height:84vh;overflow:auto;text-align:left;padding:20px 22px}
.srvhead{display:flex;align-items:center;gap:10px}
.srvtitle{flex:1;font-size:22px;font-weight:bold}
.srvsub{color:#666;font-size:13px;margin:6px 0 12px}
.srvrow{display:flex;align-items:center;gap:14px;padding:12px 0;border-top:1px solid #eee}
.srvinfo{width:96px;flex:none}
.srvname{font-weight:bold}
.srvcnt{font-size:13px;color:#666}
.srvpl{flex:1;display:flex;gap:8px;flex-wrap:wrap}
.pcard{width:56px;text-align:center;font-size:10px}
.pcard .pface{font-size:9px;margin:0 auto 3px}
.pcard span{display:block;word-break:break-all;line-height:1.1}
#login{position:fixed;inset:0;z-index:80;background:#2d2d2d;display:flex;align-items:center;justify-content:center;font-family:Arial,Helvetica,sans-serif;overflow:auto}
.lgbox{background:#fff;color:#1a1a1a;border-radius:10px;padding:28px 30px;width:min(360px,90vw);box-shadow:0 6px 28px rgba(0,0,0,.5);text-align:center}
.lglogo{width:56px;height:56px;margin:0 auto 8px;border-radius:12px;background:var(--acc);color:#fff;font:bold 36px Arial,Helvetica,sans-serif;display:flex;align-items:center;justify-content:center}
.lgtitle{font-size:26px;font-weight:bold;margin-bottom:16px}
.lgtabs{display:flex;margin-bottom:16px;border-bottom:2px solid #ddd}
.lgtab{flex:1;background:none;border:0;padding:10px 0;font:bold 15px Arial,Helvetica,sans-serif;color:#777;cursor:pointer;border-bottom:3px solid transparent;margin-bottom:-2px}
.lgtab.on{color:var(--acc);border-bottom-color:var(--acc)}
.lgbox input[type=text],.lgbox input[type=password]{width:100%;box-sizing:border-box;padding:11px 12px;margin-bottom:10px;font:15px Arial,Helvetica,sans-serif;border:2px solid #bbb;border-radius:6px}
.lgchk{display:block;text-align:left;font-size:13px;color:#555;margin:4px 0 14px}
.lgbtn{width:100%;padding:12px 0}
#lgMsg{min-height:18px;margin-top:12px;font-size:13px;color:#c0392b}
.lgnote{margin-top:10px;font-size:12px;color:#888}
#pview{position:fixed;inset:0;z-index:66;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;font-family:Arial,Helvetica,sans-serif}
.pvbox{width:min(640px,94vw);max-width:none;max-height:88vh;overflow:auto;text-align:left;padding:22px 24px}
.pvtop{display:flex;align-items:center;gap:16px}
.pvtop .pface{font-size:14px;margin:0;border-radius:50%;flex:none}
.pvhead{flex:1}
.pvbox .hsec{font-size:15px;margin:18px 0 8px}
.pvbox .ptitle{font-size:26px}
.frow .pface,.frow .fname,.pcard{cursor:pointer}
.frow .fname:hover{text-decoration:underline}
.cmain{max-width:1200px}
.cwrap{display:flex;gap:18px;align-items:flex-start;flex-wrap:wrap}
.cwrap .pbox{margin-bottom:0}
.cside{width:230px;flex:none}
.cmainbox{flex:1;min-width:320px}
.citem{padding:9px 10px;border-radius:6px;cursor:pointer;font-size:14px;margin-top:6px;border:2px solid transparent;word-break:break-word}
.citem:hover{background:#eef3f8}
.citem.on{border-color:var(--acc);background:#e8f1fb;font-weight:bold}
.crow{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:10px 0}
.crow input,.crow select{padding:9px 10px;font:15px Arial,Helvetica,sans-serif;border:2px solid #bbb;border-radius:6px;box-sizing:border-box}
.crow input{flex:1;min-width:160px}
#cCode{width:100%;box-sizing:border-box;min-height:340px;font:14px/1.45 Consolas,Menlo,monospace;background:#1e1f26;color:#e8e8e8;border:2px solid #444;border-radius:6px;padding:10px;tab-size:2;resize:vertical;white-space:pre;overflow:auto}
#cOut{background:#111;color:#cfe8d5;font:13px/1.4 Consolas,Menlo,monospace;padding:10px;border-radius:6px;min-height:70px;max-height:170px;overflow:auto;margin:6px 0 0}
#cOut .err{color:#ff8a80}
#cNote{font-size:13px;color:#666}
#cDocs{font-size:14px;line-height:1.5;color:#333;margin-top:8px}
#cDocs code{background:#eef3f8;padding:1px 5px;border-radius:4px;font:13px Consolas,Menlo,monospace}
#cDocs li{margin-bottom:8px}
details summary{cursor:pointer;font-weight:bold;margin-top:14px}
#cmsg{position:fixed;top:70px;left:50%;transform:translateX(-50%);background:#000;color:#fff;border:3px solid #fff;border-radius:10px;padding:10px 22px;font:bold 20px "Trebuchet MS",Arial,sans-serif;z-index:30;max-width:80vw;text-align:center}
#chud{position:fixed;top:12px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.75);color:#fff;border:2px solid #fff;border-radius:8px;padding:6px 16px;font:bold 17px "Trebuchet MS",Arial,sans-serif;z-index:30;max-width:60vw;text-align:center}
.sign{position:absolute;left:0;top:0;background:rgba(0,0,0,.6);color:#fff;border:2px solid #fff;border-radius:6px;padding:4px 10px;font:bold 13px "Trebuchet MS",Arial,sans-serif;white-space:pre-wrap;max-width:220px;text-align:center;will-change:transform}
#devBtn{position:fixed;top:calc(12px + env(safe-area-inset-top,0px));right:64px;padding:4px 14px;font-size:16px;letter-spacing:1px}
#devtools{position:fixed;top:calc(70px + env(safe-area-inset-top,0px));right:12px;width:380px;max-width:90vw;max-height:calc(100vh - 100px);overflow:auto;background:rgba(0,0,0,.92);border:3px solid #fff;border-radius:10px;padding:12px;display:flex;flex-direction:column;gap:8px;z-index:25}
#dCode{width:100%;box-sizing:border-box;min-height:210px;font:13px/1.4 Consolas,Menlo,monospace;background:#1e1f26;color:#e8e8e8;border:2px solid #444;border-radius:6px;padding:8px;resize:vertical}
#dOut{background:#111;color:#cfe8d5;font:12px/1.4 Consolas,Menlo,monospace;padding:8px;border-radius:6px;min-height:40px;max-height:120px;overflow:auto}
#dOut .err{color:#ff8a80}
#dNote{font-size:12px;color:#ccc;min-height:14px}
#devtools summary{color:#ccc;font-size:12px;cursor:pointer}
#devtools details div{font-size:12px;color:#ccc;line-height:1.6;margin-top:6px}
#devtools details code{background:#1e1f26;padding:1px 5px;border-radius:4px}
#bar{position:fixed;bottom:calc(10px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);display:flex;gap:6px}
.slot{width:52px;height:52px;border:2px solid #fff;border-radius:8px;background:rgba(0,0,0,.75);position:relative;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:bold;cursor:pointer}
.slot i{position:absolute;top:2px;left:5px;font-style:normal;font-size:10px;opacity:.8}
.slot.on{background:#fff;color:#000}
#wp{position:fixed;top:calc(76px + env(safe-area-inset-top,0px));left:12px;width:190px;background:rgba(0,0,0,.85);border:3px solid #fff;border-radius:10px;padding:10px;display:flex;flex-direction:column;gap:6px}
#wp .wt{font-weight:bold;text-align:center;font-size:18px}
#wp .it{font-size:15px;padding:8px}
#wp .it.on{background:#fff;color:#000}
#whint{font-size:12px;opacity:.85;min-height:48px}
.cgame{display:flex;gap:18px;align-items:flex-start;flex-wrap:wrap;background:#fff;border-radius:6px;padding:18px;box-shadow:0 1px 4px rgba(0,0,0,.15);margin-bottom:14px;color:#222}
.cgthumb{width:192px;height:108px;border-radius:6px;flex:none;display:flex;align-items:center;justify-content:center;font:bold 44px Arial,Helvetica,sans-serif;color:#fff;box-shadow:0 1px 4px rgba(0,0,0,.25)}
.cgbody{flex:1;min-width:220px}
.cgbody h3{margin:0 0 4px;font-size:22px}
.cgby{font-size:13px;color:#666;margin-bottom:8px}
.cgabout{color:#555;font-size:15px;line-height:1.4;margin-bottom:12px;white-space:pre-wrap;word-break:break-word}
.vtag{display:inline-block;font-size:12px;font-weight:bold;padding:2px 9px;border-radius:10px;margin-left:8px;vertical-align:middle;color:#fff;letter-spacing:.3px}
.vtag.public{background:#3fa34d}.vtag.private{background:#c0392b}.vtag.whitelist{background:#d68910}
.cgbtns{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.cgnote{font-size:13px;color:#888}
#pub,#rep,#modDlg{position:fixed;inset:0;z-index:66;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;font-family:Arial,Helvetica,sans-serif}
.pubbox{width:min(520px,92vw);max-width:none;max-height:88vh;overflow:auto;text-align:left;padding:22px 24px}
.pubbox label{display:block;font-weight:bold;font-size:14px;margin:14px 0 5px}
.pubbox textarea,.pubbox input,.pubbox select{width:100%;box-sizing:border-box;padding:9px 10px;font:15px Arial,Helvetica,sans-serif;border:2px solid #bbb;border-radius:6px}
.pubbox textarea{height:96px;resize:vertical}
#tm{position:fixed;top:calc(18px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);width:min(520px,94vw);max-height:calc(100vh - 40px);overflow:auto;background:rgba(18,20,28,.93);border-radius:10px;z-index:30;color:#fff;box-shadow:0 6px 30px rgba(0,0,0,.55)}
.tmtabs{display:flex;background:rgba(0,0,0,.45);border-radius:10px 10px 0 0;position:sticky;top:0}
.tmtab{flex:1;background:none;border:0;color:#aab;font:bold 15px "Trebuchet MS",Arial,sans-serif;padding:14px 6px;cursor:pointer;border-bottom:3px solid transparent}
.tmtab.on{color:#fff;border-bottom-color:#fff}
.tmbody{padding:10px 18px 4px;min-height:250px}
.tmrow{display:flex;align-items:center;gap:12px;padding:9px 0;font-size:14px}
.tmrow b{flex:1}
.tmrow input[type=range]{width:190px;accent-color:#2f8fff}
.tmval{width:46px;text-align:right;font-size:13px;color:#ccc}
.tmsw{min-width:70px;background:#000;color:#fff;border:2px solid #fff;border-radius:6px;padding:5px 10px;font:bold 13px "Trebuchet MS",Arial,sans-serif;cursor:pointer}
.tmsw.on{background:#2f8fff;border-color:#2f8fff}
.tmfoot{display:flex;gap:10px;padding:10px 18px 16px;flex-wrap:wrap}
.tmbtn{flex:1;min-width:130px;display:flex;align-items:center;gap:10px;background:rgba(45,49,62,.95);border:2px solid #666;border-radius:6px;color:#fff;font:bold 14px "Trebuchet MS",Arial,sans-serif;padding:8px 10px;cursor:pointer}
.tmbtn:hover{background:rgba(70,76,96,.95)}
.tmkey{border:2px solid #fff;border-radius:5px;padding:3px 8px;font-size:13px}
.tmprow{display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.12)}
.tmprow .pface{margin:0;flex:none}
.tmprow .pn{flex:1;font-weight:bold;font-size:15px;word-break:break-all}
.tmprow .pn small{display:block;font-weight:normal;color:#9ab;font-size:12px}
.tmprow button{background:#000;color:#fff;border:2px solid #fff;border-radius:6px;padding:5px 10px;font:bold 12px "Trebuchet MS",Arial,sans-serif;cursor:pointer}
.tmprow button:disabled{opacity:.55;cursor:default}
.tmhelp{font-size:14px;line-height:1.7;color:#dde}
#fps{position:fixed;top:calc(8px + env(safe-area-inset-top,0px));left:10px;background:rgba(0,0,0,.7);border:2px solid #fff;border-radius:6px;padding:3px 8px;font:bold 13px Arial,sans-serif;z-index:24;pointer-events:none}
.pubthumb{width:192px;height:108px;border-radius:6px;border:2px dashed #bbb;background:#f3f3f3;display:flex;align-items:center;justify-content:center;color:#888;font-size:13px;text-align:center;overflow:hidden;flex:none}
.pubthumb img{width:100%;height:100%;object-fit:cover;display:block}
.cgthumb img{width:100%;height:100%;object-fit:cover;border-radius:6px;display:block}
.rtag{display:inline-block;font-size:12px;font-weight:bold;padding:2px 9px;border-radius:10px;margin-left:8px;vertical-align:middle;color:#fff;background:#8e44ad}
.warnitem{background:#fff4d6;border:2px solid #e0a800;border-radius:6px;padding:10px 14px;margin-bottom:10px;color:#5a4300;font-size:14px;word-break:break-word}
.strow{display:flex;align-items:center;gap:14px;padding:11px 0;border-bottom:1px solid #eee;flex-wrap:wrap}
.strow:last-child{border-bottom:0}
.strow>b{flex:1;min-width:170px;font-size:15px}
.strow small{display:block;font-weight:normal;color:#777;font-size:12px;margin-top:2px}
.strow input[type=range]{width:200px;accent-color:var(--acc)}
.stv{width:48px;text-align:right;font-size:13px;color:#666}
.hsw{min-width:70px;background:#fff;border:2px solid #bbb;border-radius:20px;padding:6px 14px;font:bold 13px Arial,Helvetica,sans-serif;cursor:pointer;color:#222}
.hsw.on{background:var(--acc);border-color:var(--acc);color:#fff}
.accs{display:flex;gap:8px;flex-wrap:wrap}
.accb{width:30px;height:30px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 1px #aaa;cursor:pointer;padding:0}
.accb.on{box-shadow:0 0 0 3px #222}
.ico img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.rletter{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font:bold 8em Arial,Helvetica,sans-serif;color:#fff}
#home.hcompact .cgabout{display:none}
#home.hcompact .cgame{padding:10px 14px;margin-bottom:8px}
#home.hcompact .cgthumb{width:128px;height:72px;font-size:30px}
html[data-eff="dark"] #home{background:#15171c;color:#e6e8ee}
html[data-eff="dark"] .gcard,html[data-eff="dark"] .pbox,html[data-eff="dark"] .cgame,html[data-eff="dark"] .dbox{background:#232733;color:#e6e8ee}
html[data-eff="dark"] .cinfo p,html[data-eff="dark"] #hstat,html[data-eff="dark"] .psub,html[data-eff="dark"] #aboutNote,html[data-eff="dark"] .fnote,html[data-eff="dark"] .fstat,html[data-eff="dark"] .srvsub,html[data-eff="dark"] .srvcnt,html[data-eff="dark"] .rsub,html[data-eff="dark"] .cgby,html[data-eff="dark"] .cgabout,html[data-eff="dark"] .cgnote,html[data-eff="dark"] #cNote,html[data-eff="dark"] .avrow,html[data-eff="dark"] #cDocs,html[data-eff="dark"] .sub,html[data-eff="dark"] .aboutv,html[data-eff="dark"] .stv,html[data-eff="dark"] .strow small{color:#a9b1c3}
html[data-eff="dark"] .aboutv.empty{color:#7d869a}
html[data-eff="dark"] .opt,html[data-eff="dark"] .hsw{background:#2b3040;border-color:#4a5163;color:#e6e8ee}
html[data-eff="dark"] .opt.on{background:#26364f}
html[data-eff="dark"] .hsw.on{background:var(--acc);border-color:var(--acc);color:#fff}
html[data-eff="dark"] .srow input,html[data-eff="dark"] .crow input,html[data-eff="dark"] .crow select,html[data-eff="dark"] #aboutTxt,html[data-eff="dark"] .pubbox textarea,html[data-eff="dark"] .pubbox input,html[data-eff="dark"] .pubbox select{background:#1b1e27;color:#e6e8ee;border-color:#4a5163}
html[data-eff="dark"] .rrow,html[data-eff="dark"] .frow,html[data-eff="dark"] .srvrow,html[data-eff="dark"] .strow{border-color:#343a4b}
html[data-eff="dark"] .citem:hover{background:#2c3244}
html[data-eff="dark"] .citem.on{background:#26364f}
html[data-eff="dark"] .avprev,html[data-eff="dark"] .pface,html[data-eff="dark"] .pav,html[data-eff="dark"] .pubthumb,html[data-eff="dark"] #cDocs code{background:#323849}
html[data-eff="dark"] .srvbtn{background:transparent}
html[data-eff="dark"] .srvbtn:hover{background:#3a2a22}
html[data-eff="dark"] .accb{border-color:#232733}
html[data-eff="dark"] .accb.on{box-shadow:0 0 0 3px #fff}
html[data-eff="dark"] .sw{border-color:#232733}
html[data-eff="dark"] details summary{color:#e6e8ee}
.hide{display:none!important}
</style>
</head>
<body>
<div id="help">WASD / Arrows = move &nbsp;·&nbsp; Space = jump &nbsp;·&nbsp; W on ladder = climb &nbsp;·&nbsp; Drag mouse = camera &nbsp;·&nbsp; Scroll = zoom &nbsp;·&nbsp; Enter = chat &nbsp;·&nbsp; Esc = menu</div>
<button class="sq hide" id="pb" title="Party servers">&#128578;</button>
<div id="fps" class="hide">FPS</div>
<div id="tm" class="hide">
  <div class="tmtabs"><button class="tmtab on" id="tmtPlayers">Players</button><button class="tmtab" id="tmtSettings">Settings</button><button class="tmtab" id="tmtHelp">Help</button></div>
  <div class="tmbody">
    <div id="tmPlayers"></div>
    <div id="tmSettings" class="hide">
      <div class="tmrow"><b>Volume</b><input type="range" id="stVol" min="0" max="100" step="1"><span class="tmval" id="stVolV"></span></div>
      <div class="tmrow"><b>Field of view (FOV)</b><input type="range" id="stFov" min="40" max="110" step="1"><span class="tmval" id="stFovV"></span></div>
      <div class="tmrow"><b>Camera sensitivity</b><input type="range" id="stSens" min="0.2" max="3" step="0.1"><span class="tmval" id="stSensV"></span></div>
      <div class="tmrow"><b>Camera inverted</b><button class="tmsw" id="stInv">Off</button></div>
      <div class="tmrow"><b>Performance stats (FPS)</b><button class="tmsw" id="stFps">Off</button></div>
      <div class="tmrow"><b>Fullscreen</b><button class="tmsw" id="stFull">Off</button></div>
      <div class="tmrow"><b></b><button class="tmsw" id="stDef" style="min-width:0">Reset settings</button></div>
    </div>
    <div id="tmHelp" class="tmhelp hide">
      <b>Move</b>: W A S D or the arrow keys &middot; <b>Jump</b>: Space<br>
      <b>Camera</b>: drag the mouse, or press Shift to lock it &middot; scroll to zoom<br>
      <b>Chat</b>: Enter &middot; <b>This menu</b>: Esc<br>
      <b>Reset character</b>: R (while this menu is open) &middot; <b>Leave game</b>: L<br>
      <b>Resume</b>: Esc
    </div>
  </div>
  <div class="tmfoot">
    <button class="tmbtn" id="tmReset"><span class="tmkey">R</span>Reset Character</button>
    <button class="tmbtn" id="tmLeave"><span class="tmkey">L</span><span id="tmLeaveT">Leave Game</span></button>
    <button class="tmbtn" id="tmResume"><span class="tmkey">ESC</span>Resume Game</button>
  </div>
</div>
<div id="pp" class="hide">
  <div class="wt">Party servers</div>
  <div class="ptabs"><button class="ptab on" id="ptParty">Party</button><button class="ptab" id="ptInfo">Player infos</button></div>
  <div id="ptabParty">
  <div class="pd">An option that allows you and your friends to play together.</div>
  <button class="sq it" id="pj">Join party</button>
  <button class="sq it" id="ph">Host party</button>
  <div id="pjoin" class="hide"><input id="pcode" maxlength="12" placeholder="Paste code" autocomplete="off"><button class="sq it" id="pgo" style="width:100%">Join</button></div>
  <div id="pcodebox" class="hide"><div class="pc" id="pcv"></div><button class="sq it" id="pcopy" style="width:100%">Copy code</button></div>
  <div id="hset" class="hide">
    <div class="wt" style="font-size:15px;margin-bottom:6px">Host settings</div>
    <button class="sq it" id="hedit" style="width:100%">Others can edit builds: OFF</button>
    <div class="pd" style="margin:8px 0 4px">Players (Ban removes them for good):</div>
    <div id="hplist"></div>
  </div>
  <button class="sq it hide" id="pleave">Leave party</button>
  <div id="pcount" style="font-size:12px"></div>
  <div id="pstat"></div>
  <button class="sq it" id="preset" style="width:100%">Reset character</button>
  <button class="sq it" id="pgame" style="width:100%">Leave game</button>
  </div>
  <div id="ptabInfo" class="hide"><div id="plist"></div></div>
</div>
<div id="hp" class="hide"><div class="hpb"><div id="hpf"></div></div><span id="hpt">100%</span></div>
<div id="xh" class="hide"></div>
<div id="names"></div>
<div id="chat"><div id="clog"></div><input id="ci" class="hide" maxlength="100" placeholder="Say something..." autocomplete="off"></div>
<div id="wp" class="hide"><div class="wt">Wtool</div><div id="whint"></div></div>
<div id="bar" class="hide"></div>
<div id="dlg" class="hide"><div class="dbox"><div class="dmsg">You already have one player client playing, please move to that client.</div><button class="oplay" id="dok">OK</button></div></div>
<div id="login">
  <div class="lgbox">
    <div class="lglogo">W</div>
    <div class="lgtitle">Webby</div>
    <div class="lgtabs"><button class="lgtab on" id="lgTabIn">Log in</button><button class="lgtab" id="lgTabNew">Create account</button></div>
    <input type="text" id="lgUser" maxlength="16" placeholder="Username" autocomplete="username">
    <input type="password" id="lgPass" maxlength="64" placeholder="Password" autocomplete="current-password">
    <input type="password" id="lgPass2" maxlength="64" placeholder="Confirm password" autocomplete="new-password" class="hide">
    <label class="lgchk"><input type="checkbox" id="lgStay" checked> Keep me logged in on this computer</label>
    <button class="oplay lgbtn" id="lgGo">LOG IN</button>
    <div id="lgMsg"></div>
    <div class="lgnote">Accounts are saved on this computer only.</div>
  </div>
</div>
<div id="pview" class="hide">
  <div class="dbox pvbox">
    <div class="pvtop">
      <div class="pface" id="pvface"><div class="pfin" id="pvfin"></div></div>
      <div class="pvhead"><div class="ptitle" id="pvname"></div><div class="fstat" id="pvstat"></div></div>
      <button class="opt" id="pvClose">Close</button>
    </div>
    <div class="hsec">ABOUT</div>
    <div class="aboutv" id="pvAbout"></div>
    <div class="hsec">RECENTLY PLAYED</div>
    <div id="pvRecent"></div>
    <div class="hsec">AVATAR</div>
    <div class="pwear">
      <div class="avprev"><div class="avbox" id="pvbox"></div></div>
      <div class="pwinfo">
        <div>Skin colour: <i class="whoc" id="pvskin"></i></div>
        <div>Hat: <b id="pvhat"></b></div>
        <div>Face: <b id="pvfacename"></b></div>
      </div>
    </div>
    <div class="arow" id="pvAct"></div>
    <div class="fnote" id="pvnote"></div>
  </div>
</div>
<div id="cmsg" class="hide"></div><div id="chud" class="hide"></div>
<button class="sq hide" id="devBtn" title="DevTools">&lt;/&gt;</button>
<div id="devtools" class="hide">
  <div class="wt">DevTools</div>
  <div class="pd">Shared Lua scripting for this server. Everyone here sees what you build; only you ever run your code.</div>
  <textarea id="dCode" spellcheck="false">-- place a floating sign and a bouncy block
sign{x=0,y=4,z=-5,text="Made with DevTools!"}
block{x=0,y=1,z=-10,w=4,h=0.6,d=4,color="lime",bounce=20}
</textarea>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <button class="sq it" id="dRun">RUN</button>
    <button class="sq it" id="dClearMine">Clear my blocks</button>
    <button class="sq it" id="dClose">Close</button>
  </div>
  <div id="dNote"></div>
  <div id="dOut"></div>
  <details><summary>Commands</summary><div>
    <code>block{x,y,z,w,h,d,color,solid,kill,damage,bounce,visible}</code> &mdash; everyone sees it and can touch it.<br>
    <code>sign{x,y,z,text,color,bg}</code> &mdash; floating text, visuals only, no code runs from it.<br>
    <code>b:setColor(c)</code> <code>b:setPosition(x,y,z)</code> <code>b:setSize(w,h,d)</code> <code>b:setVisible(bool)</code> <code>b:destroy()</code><br>
    <code>gravity(n)</code> <code>speed(n)</code> <code>jump(n)</code> <code>sky(color)</code> &mdash; changes apply to everyone's own movement and view.<br>
    <code>message(text,secs)</code> <code>hud(text)</code> <code>playSound(name)</code> <code>print(...)</code> <code>clear()</code> <code>random(a,b)</code> <code>time()</code><br>
    <code>b:onTouch(fn)</code> &mdash; only runs for you, to help you test; other players don't run your code.<br>
    Scripts run once, top to bottom, each time you press RUN.
  </div></details>
</div>
<div id="rep" class="hide">
  <div class="dbox pubbox">
    <div class="srvtitle" id="repTitle">Report game</div>
    <div class="srvsub">Your report goes to the Webby moderator (EEEEEEEL), who can remove the game or warn its developer. Please only report real problems.</div>
    <div style="display:flex;gap:12px;align-items:center;margin-top:12px"><div class="pubthumb" id="repThumb"></div><div id="repWho" style="font-size:14px"></div></div>
    <label for="repWhy">What is wrong?</label>
    <select id="repWhy"><option value="image">The thumbnail image is inappropriate</option><option value="content">The game has sensitive or inappropriate content</option><option value="other">Something else</option></select>
    <label for="repDet">Details (optional)</label>
    <textarea id="repDet" maxlength="300" placeholder="Tell the moderator what you saw."></textarea>
    <div id="repNote" class="fnote" style="min-height:18px;margin-top:10px"></div>
    <div class="cgbtns" style="margin-top:8px"><button class="oplay small" id="repGo">SEND REPORT</button><button class="opt" id="repCancel">Cancel</button></div>
  </div>
</div>
<div id="modDlg" class="hide">
  <div class="dbox pubbox">
    <div class="srvtitle" id="modTitle">Moderator action</div>
    <div class="srvsub" id="modSub"></div>
    <label for="modTxt" id="modLbl">Message</label>
    <textarea id="modTxt" maxlength="300"></textarea>
    <div id="modNote" class="fnote" style="min-height:18px;margin-top:10px"></div>
    <div class="cgbtns" style="margin-top:8px"><button class="oplay small" id="modGo">CONFIRM</button><button class="opt" id="modCancel">Cancel</button></div>
  </div>
</div>
<div id="pub" class="hide">
  <div class="dbox pubbox">
    <div class="srvtitle" id="pubTitle">Publish to Webby</div>
    <div class="srvsub">Your game appears on the Webby homepage with your name. Players get their own servers (up to 10 each). Only Lua games can be published, because Lua runs in a safety box.</div>
    <label for="pubAbout">About your game</label>
    <textarea id="pubAbout" maxlength="400" placeholder="What is your game about? How do you play?"></textarea>
    <label>Thumbnail <span style="color:#c0392b">(required)</span></label>
    <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap"><div class="pubthumb" id="pubThumb">No image yet</div><div><button class="opt" id="pubPick">Choose image...</button><div class="fnote" style="margin-top:6px">PNG, JPG, WEBP or GIF.<br>Shown at 16:9 on the homepage.</div></div><input type="file" id="pubFile" accept="image/png,image/jpeg,image/webp,image/gif" class="hide"></div>
    <label for="pubVis">Who can play</label>
    <select id="pubVis"><option value="public">Public: everyone</option><option value="whitelist">Whitelisted: only people you list</option><option value="private">Private: only you</option></select>
    <div id="pubAllowWrap" class="hide"><label for="pubAllow">Whitelist (usernames, separated by commas)</label><input id="pubAllow" maxlength="600" placeholder="alice, bob_99" autocomplete="off"></div>
    <div id="pubNote" class="fnote" style="min-height:18px;margin-top:10px"></div>
    <div class="cgbtns" style="margin-top:8px"><button class="oplay small" id="pubGo">PUBLISH</button><button class="opt hide" id="pubRemove">Unpublish</button><button class="opt" id="pubCancel">Cancel</button></div>
  </div>
</div>
<div id="srv" class="hide">
  <div class="dbox srvbox">
    <div class="srvhead"><div class="srvtitle" id="srvTitle">Servers</div><button class="opt" id="srvRefresh">Refresh</button><button class="opt" id="srvClose">Close</button></div>
    <div class="srvsub" id="srvSub">Testing place · up to 10 players in each server</div>
    <div id="srvList"></div>
  </div>
</div>
<div id="loading" class="hide">
  <div class="ico"><div class="icoin"></div></div>
  <div class="lname">Testing place</div>
  <div class="lby">By Zino</div>
  <div class="lstat" id="lstat">Joining server...</div>
  <div class="lw">W</div>
</div>
<div id="home">
  <div class="htop"><div class="logo">W</div><button class="tab on" id="tabHome">Home</button><button class="tab" id="tabFind">Find Players</button><button class="tab" id="tabAvatar">Avatar System</button><button class="tab" id="tabCreate">Webby Create</button><button class="tab hide" id="tabMod">Moderation</button><button class="tab" id="tabSettings">Settings</button><div class="who"><div class="pface whoav" id="whoc"><div class="pfin" id="whoin"></div></div><span id="whon"></span></div></div>
  <div class="hmain" id="viewHome">
    <div class="hsec">GAMES</div>
    <div class="gcard">
      <div class="thumb"></div>
      <div class="cinfo">
        <h3>Testing</h3>
        <p>This is a testing game where you can test movement and physics.</p>
        <button class="oplay" id="hplay">PLAY</button><button class="srvbtn" id="hservers">SERVERS</button>
        <div id="hstat"></div>
      </div>
    </div>
    <div class="hsec" style="margin-top:26px;display:flex;align-items:center;gap:12px">COMMUNITY GAMES<button class="opt" id="commRefresh" style="margin-left:auto">Refresh</button></div>
    <div class="srow" style="margin-bottom:6px"><input id="commSearch" type="text" maxlength="60" placeholder="Search public games by name, developer or description..." autocomplete="off"><button class="opt" id="commClear">Clear</button></div>
    <div class="fnote" id="commHint"></div>
    <div id="commBox"></div>
    <div id="reqWrap" class="hide"><div class="hsec" style="margin-top:26px">FRIEND REQUESTS</div><div class="pbox" id="reqBox"></div></div>
    <div class="hsec" style="margin-top:26px">FRIENDS</div>
    <div class="pbox" id="friendsBox"></div>
  </div>
  <div class="hmain hide" id="viewProfile">
    <div class="pbox phead">
      <div class="pface" id="pfhead"><div class="pfin" id="pfheadin"></div></div>
      <div><div class="ptitle" id="pfname"></div><div class="psub">Your profile</div></div>
      <button class="opt" id="logoutBtn" style="margin-left:auto">Log out</button>
    </div>
    <div class="hsec">ABOUT</div>
    <div class="pbox">
      <div id="aboutView" class="aboutv"></div>
      <textarea id="aboutTxt" class="hide" maxlength="300" placeholder="Tell everyone about yourself..."></textarea>
      <div class="arow"><button class="oplay small" id="aboutEdit">EDIT</button><button class="oplay small hide" id="aboutSave">SAVE</button><button class="opt hide" id="aboutCancel">Cancel</button><span id="aboutNote"></span></div>
    </div>
    <div class="hsec">RECENTLY PLAYED</div>
    <div class="pbox" id="recentBox"></div>
    <div class="hsec">YOUR AVATAR</div>
    <div class="pbox pwear">
      <div class="avprev"><div class="avbox" id="pwbox"></div></div>
      <div class="pwinfo">
        <div>Skin colour: <i class="whoc" id="pwskin"></i></div>
        <div>Hat: <b id="pwhat"></b></div>
        <div>Face: <b id="pwface"></b></div>
        <button class="oplay small" id="pwchange">CHANGE AVATAR</button>
      </div>
    </div>
  </div>
  <div class="hmain hide" id="viewFind">
    <div class="hsec">FIND PLAYERS</div>
    <div class="pbox">
      <div class="srow"><input id="findIn" maxlength="24" placeholder="Search a username" autocomplete="off"><button class="oplay small" id="findGo">SEARCH</button></div>
      <div id="findNote" class="fnote"></div>
      <div id="findRes"></div>
    </div>
    <div class="hsec">FRIEND REQUESTS</div>
    <div class="pbox" id="reqBox2"></div>
  </div>
  <div class="hmain cmain hide" id="viewCreate">
    <div class="hsec">WEBBY CREATE</div>
    <div id="warnBox"></div>
    <div class="cwrap">
      <div class="pbox cside"><button class="oplay small" id="cNew" style="width:100%">+ NEW GAME</button><div id="cList"></div></div>
      <div class="pbox cmainbox">
        <div class="crow"><input id="cName" maxlength="40" placeholder="Game name" autocomplete="off"><select id="cLang"><option value="lua">Lua</option><option value="js">JavaScript</option></select></div>
        <textarea id="cCode" spellcheck="false"></textarea>
        <div class="crow"><button class="oplay small" id="cRun">RUN</button><button class="opt" id="cSave">Save</button><button class="opt" id="cExample">Load example</button><button class="opt" id="cDelete">Delete</button><button class="opt" id="cPublish">Publish to Webby</button><button class="opt" id="cDownload">Download .html</button><span id="cNote"></span></div>
        <div class="sub">Console</div>
        <div id="cOut"></div>
        <details><summary>How it works and all the commands</summary><div id="cDocs"><p><b>The basics.</b> Your code runs when you press RUN. The world starts as an empty flat floor. <b>x</b> goes right, <b>y</b> goes up and <b>z</b> comes toward the camera. The floor's top is at y = 0. A block's x, y, z is its <b>centre</b>, so a block that is 1 tall sitting on the floor has y = 0.5. Press <b>Esc</b> to stop your game and come back here.</p>
<p><b>Commands</b>. Lua writes <code>part{...}</code> and <code>obj:method()</code>. JavaScript writes <code>part({...})</code> and <code>obj.method()</code>.</p>
<ul>
<li><code>part{x, y, z, w, h, d, color, solid, damage, kill, bounce, name}</code> makes a block. w, h, d are its size (default 4, 1, 4). color can be "red", "#ff8800" or {255, 0, 0}. solid = false lets you walk through it. damage = % health lost every 0.35 seconds while you touch it. kill = true kills you on touch. bounce = 20 launches you upward.</li>
<li>A block can be changed later: <code>b:setColor(c)</code> <code>b:setPosition(x,y,z)</code> <code>b:setSize(w,h,d)</code> <code>b:setVisible(true or false)</code> <code>b:destroy()</code> <code>b:onTouch(function(player) ... end)</code></li>
<li><code>player.x player.y player.z player.health</code> tell you about the player. <code>player:teleport(x,y,z)</code> <code>player:damage(n)</code> <code>player:heal(n)</code> <code>player:setHealth(n)</code> <code>player:kill()</code> <code>player:setSpeed(n)</code> (normal 8) <code>player:setJump(n)</code> (normal 12)</li>
<li><code>onStart(fn)</code> runs once. <code>onUpdate(function(dt) ... end)</code> runs every frame. <code>onKey("e", fn)</code> runs when a key is pressed. <code>onDeath(fn)</code> runs when the player dies. <code>after(seconds, fn)</code> and <code>every(seconds, fn)</code> run later (they give back something with <code>:stop()</code>).</li>
<li><code>message(text, seconds)</code> shows a message. <code>hud(text)</code> keeps a line of text on screen. <code>playSound("coin")</code> (coin, win, hit, jump, pop, die). <code>setSpawn(x,y,z)</code> <code>sky(color)</code> <code>gravity(n)</code> (normal 30) <code>clear()</code> removes all blocks. <code>random(a,b)</code> <code>time()</code> <code>print(...)</code> writes to the console below the editor.</li>
</ul>
<p>Lua has the usual <code>math</code>, <code>string</code> and <code>table</code> libraries. It is a small Lua 5.3 made just for Webby, so rare things (goto, coroutines, bit operators, string.pack) are missing. Games can hold up to 400 blocks.</p>
<p><b>JavaScript has no safety box.</b> An endless loop in JavaScript can freeze Webby, and JavaScript can reach everything on your computer that a web page can. Only run JavaScript you wrote or trust. Lua is safe: it stops endless loops by itself.</p></div></details>
      </div>
    </div>
  </div>
  <div class="hmain hide" id="viewSettings">
    <div class="hsec">SETTINGS</div>
    <div class="pbox">
      <div class="sub" style="margin-top:0">Appearance</div>
      <div class="strow"><b>Theme<small>Choose how Webby looks. System follows your device.</small></b><div class="opts" id="hsTheme"><button class="opt" data-v="light">Light</button><button class="opt" data-v="dark">Dark</button><button class="opt" data-v="system">System</button></div></div>
      <div class="strow"><b>Accent color<small>The color of the top bar and highlights.</small></b><div class="accs" id="hsAccent"></div></div>
      <div class="strow"><b>Text size<small>Makes the whole homepage bigger or smaller.</small></b><div class="opts" id="hsSize"><button class="opt" data-v="90">Small</button><button class="opt" data-v="100">Normal</button><button class="opt" data-v="115">Large</button></div></div>
    </div>
    <div class="pbox">
      <div class="sub" style="margin-top:0">Community games</div>
      <div class="strow"><b>Compact list<small>Smaller cards without the about text.</small></b><button class="hsw" id="hsCompact">Off</button></div>
      <div class="strow"><b>Only show public games<small>Hide whitelisted and private games from the list.</small></b><button class="hsw" id="hsPubOnly">Off</button></div>
      <div class="strow"><b>Refresh automatically<small>Look for new community games every minute while you are on Home.</small></b><button class="hsw" id="hsAuto">On</button></div>
    </div>
    <div class="pbox">
      <div class="sub" style="margin-top:0">Game defaults</div>
      <div class="strow"><b>Volume</b><input type="range" id="hsVol" min="0" max="100" step="1"><span class="stv" id="hsVolV"></span></div>
      <div class="strow"><b>Field of view (FOV)</b><input type="range" id="hsFov" min="40" max="110" step="1"><span class="stv" id="hsFovV"></span></div>
      <div class="strow"><b>Camera sensitivity</b><input type="range" id="hsSens" min="0.2" max="3" step="0.1"><span class="stv" id="hsSensV"></span></div>
      <div class="strow"><b>Camera inverted</b><button class="hsw" id="hsInv">Off</button></div>
      <div class="strow"><b>Show FPS in games</b><button class="hsw" id="hsFps">Off</button></div>
    </div>
    <div class="arow"><button class="opt" id="hsReset">Reset all settings</button><span class="fnote" id="hsNote"></span></div>
  </div>
  <div class="hmain hide" id="viewMod">
    <div class="hsec" style="display:flex;align-items:center;gap:12px">MODERATION<button class="opt" id="modRefresh" style="margin-left:auto">Refresh</button></div>
    <div class="pbox" id="modInfo" style="margin-bottom:14px;font-size:14px;line-height:1.5"></div>
    <div id="modList"></div>
  </div>
  <div class="hmain hide" id="viewAvatar">
    <div class="hsec">AVATAR SYSTEM</div>
    <div class="gcard avc">
      <div class="avprev"><div class="avbox" id="avbox"></div><div class="avname" id="avname"></div></div>
      <div class="cinfo">
        <h3>Skin colour</h3>
        <p>Pick a colour for your character's head and arms. Other players will see it too.</p>
        <div id="swatches"></div>
        <div class="avrow">Custom colour:<input type="color" id="skinpick"></div>
        <div class="sub">Hat</div><div class="opts" id="hatopts"></div>
        <div class="sub">Face</div><div class="opts" id="faceopts"></div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const WEBBY_PRISTINE='<!DOCTYPE html>\n'+document.documentElement.outerHTML;   // untouched copy of this page, used for the Download .html button
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x9fd3f0);
const camera = new THREE.PerspectiveCamera(60, innerWidth/innerHeight, 0.1, 200);
const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth, innerHeight);
document.body.prepend(renderer.domElement);
scene.add(new THREE.AmbientLight(0xffffff, 0.7));
const sun = new THREE.DirectionalLight(0xffffff, 0.6);
sun.position.set(10, 20, 10);
scene.add(sun);

// ---------- World ----------
const boxes = [], worldMeshes = [], hazards = [];
function addBox(x, top, z, w, d, h, color){
  const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), new THREE.MeshLambertMaterial({color}));
  m.position.set(x, top - h/2, z);
  m.userData.dw=true; scene.add(m); worldMeshes.push(m);
  boxes.push({minx:x-w/2, maxx:x+w/2, minz:z-d/2, maxz:z+d/2, miny:top-h, maxy:top});
}
addBox(0, 0, 0, 80, 80, 1, 0x4caf50);

// Stairs (8 steps) + top landing
for(let i=0;i<8;i++) addBox(-12, 0.6*(i+1), 14-1.5*i, 4, 1.5, 0.6*(i+1), 0xbdbdbd);
addBox(-12, 4.8, 1, 4, 3.5, 1, 0x9e9e9e);

// Jump blocks of rising height
addBox(8, 1, 8, 3, 3, 1, 0xb0bec5);
addBox(12, 1.8, 8, 3, 3, 1.8, 0x90a4ae);
addBox(16, 2.0, 8, 3, 3, 2.0, 0x78909c);

// Floating hop platforms
[[6,1.5,-6],[11,2.5,-9],[16,3.5,-6],[20,4.5,-10]].forEach(([x,t,z])=>addBox(x,t,z,3.5,3.5,1,0x9e9e9e));

// Ladder tower (ladder on the front face)
addBox(0, 8, -20, 6, 5.9, 8, 0x8d6e63);
const wood = new THREE.MeshLambertMaterial({color:0xd7b377});
[-0.55,0.55].forEach(x=>{
  const r = new THREE.Mesh(new THREE.BoxGeometry(0.15,8,0.15), wood);
  r.position.set(x,4,-17.0); r.userData.dw=true; scene.add(r);
});
for(let y=0.5;y<8;y+=0.6){
  const r = new THREE.Mesh(new THREE.BoxGeometry(1.1,0.12,0.12), wood);
  r.position.set(0,y,-16.95); r.userData.dw=true; scene.add(r);
}

// Orange damage blocks (touch = lose 5% health)
addBox(-5, 1.2, 7, 3, 3, 1.2, 0xff6d00); hazards.push(boxes[boxes.length-1]);

// Red brick (touch = die)
const brickBox = {minx:3.5,maxx:6.5,miny:0,maxy:1.2,minz:4.2,maxz:5.8};
const brick = new THREE.Mesh(new THREE.BoxGeometry(3,1.2,1.6), new THREE.MeshLambertMaterial({color:0xc62828}));
brick.position.set(5,0.6,5); brick.userData.dw=true; scene.add(brick);

// ---------- Character ----------
const player = new THREE.Group();
const body = new THREE.Group(); player.add(body);
const mat = c => new THREE.MeshLambertMaterial({color:c});
const Y=0xe8c92b, B=0x1b5fa8, G=0x7a9a2a;
function part(w,h,d,c,x,y,z){ const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat(c)); m.position.set(x,y,z); return m; }
body.add(part(1.2,1.2,0.6,B,0,1.6,0));
body.add(part(0.9,0.8,0.9,Y,0,2.6,0));
function limb(w,h,d,c,x,y,z){ const g=new THREE.Group(); g.position.set(x,y,z); g.add(part(w,h,d,c,0,-h/2,0)); body.add(g); return g; }
const armL = limb(0.5,1.2,0.6,Y,-0.85,2.2,0), armR = limb(0.5,1.2,0.6,Y,0.85,2.2,0);
const legL = limb(0.55,1,0.6,G,-0.3,1,0),     legR = limb(0.55,1,0.6,G,0.3,1,0);
scene.add(player);

// Ragdoll pieces: [w,h,d,color,x,y,z]
const pieceDefs = [[0.9,0.8,0.9,Y,0,2.6,0],[1.2,1.2,0.6,B,0,1.6,0],[0.5,1.2,0.6,Y,-0.85,1.6,0],[0.5,1.2,0.6,Y,0.85,1.6,0],[0.55,1,0.6,G,-0.3,0.5,0],[0.55,1,0.6,G,0.3,0.5,0]];
let pieces = [];
function die(){
  if(dead) return;
  sfx.die(); setHp(0); dancing = false; dead = true; deathTimer = 7; body.visible = false;
  pieces = pieceDefs.map(([w,h,d,c,x,y,z])=>{
    const m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), mat(c===Y?mySkin:c));
    const off = new THREE.Vector3(x,y,z).applyAxisAngle(new THREE.Vector3(0,1,0), facing);
    m.position.copy(p).add(off); m.rotation.y = facing; scene.add(m);
    return {m, half:Math.min(w,h,d)/2, vel:new THREE.Vector3((Math.random()-.5)*6, 3+Math.random()*4, (Math.random()-.5)*6),
            spin:new THREE.Vector3((Math.random()-.5)*10,(Math.random()-.5)*10,(Math.random()-.5)*10)};
  });
}
function respawn(){
  pieces.forEach(o=>scene.remove(o.m)); pieces = [];
  dead = false; body.visible = true; setHp(100); shieldT = 5;
  p.copy(spawnPos); v.set(0,0,0); facing = 0; camera.position.set(p.x,p.y+9,p.z+13);
}

// ---------- Multiplayer ----------
// ---- Account + profile: one profile per account, saved on this computer ----
let acct=null;
const UID_RE=/^(?=.{3,16}$)[A-Za-z0-9]+(?:_[A-Za-z0-9]+)*$/;
function uidOf(t){ t=String(t||'').trim().replace(/^@/,''); return UID_RE.test(t) ? t.toLowerCase() : null; }
function freshProfile(){ return {skin:Y,hat:0,face:0,about:'',recent:[],friends:[],outgoing:[],incoming:[],declined:[],fcache:{},met:{},games:[],warnings:[],reported:[],repQ:[],modOut:[],inbox:[],modKey:null}; }
let profile=freshProfile();
function isThumb(x){ return typeof x==='string' && x.length<=32000 && /^data:image\/jpeg;base64,[A-Za-z0-9+\/=]+$/.test(x); }
function cleanRecent(x){
  const o={n:String(x.n).slice(0,40),t:x.t};
  o.by=typeof x.by==='string'?x.by.slice(0,24):(o.n==='Testing place'?'Zino':'');
  if(typeof x.k==='string' && /^[A-Za-z0-9_-]{1,40}:[A-Za-z0-9_-]{1,40}$/.test(x.k)) o.k=x.k;
  return o;
}
function recentRow(g){
  const row=document.createElement('div'); row.className='rrow';
  row.innerHTML='<div class="ico ricon"></div><div><div class="rname"></div><div class="rsub"></div></div>';
  const ico=row.querySelector('.ico');
  const testing=g.n==='Testing place' && !g.k;
  const en=testing ? null : (g.k && catalog[g.k]) || Object.values(catalog).find(e=>!e.rm && !e.ban && e.n===g.n) || null;
  if(testing){ ico.innerHTML='<div class="icoin"></div>'; ico.firstChild.innerHTML=thumbHTML(); }
  else if(en && en.th){ const im=document.createElement('img'); im.alt=''; im.src=en.th; ico.appendChild(im); }
  else { const hue=hueOf(g.k||g.n); ico.style.background='linear-gradient(135deg,hsl('+hue+',60%,55%),hsl('+((hue+50)%360)+',55%,38%))'; const l=document.createElement('div'); l.className='rletter'; l.textContent=(g.n.trim()[0]||'?').toUpperCase(); ico.appendChild(l); }
  row.querySelector('.rname').textContent=censor(g.n).text;
  const by=g.by || (en && en.dn) || (testing?'Zino':'a Webby player');
  row.querySelector('.rsub').textContent='By '+censor(by).text+' \u00b7 played '+ago(g.t);
  return row;
}
function cleanReport(r,by){
  if(!r || typeof r!=='object') return null;
  const u=uidOf(r.u); if(!u || typeof r.id!=='string' || !/^[A-Za-z0-9_-]{1,40}$/.test(r.id)) return null;
  const o={k:u+':'+r.id,u,id:r.id,gn:String(r.gn||'').slice(0,40),dn:String(r.dn||u).slice(0,24),why:['image','content','other'].includes(r.why)?r.why:'other',
    det:typeof r.det==='string'?r.det.slice(0,300):'',by:by!==undefined?by:(uidOf(r.by)||''),ts:Number.isFinite(r.ts)?r.ts:Date.now()};
  if(isThumb(r.th)) o.th=r.th;
  if(typeof r.code==='string' && r.code.length<=20000) o.code=r.code;
  return o;
}
function cleanPub(o){
  if(!o || typeof o!=='object' || !['public','private','whitelist'].includes(o.vis)) return null;
  const al=Array.isArray(o.al)?[...new Set(o.al.map(x=>typeof x==='string'?uidOf(x):null).filter(Boolean))].slice(0,50):[];
  return {vis:o.vis, about:typeof o.about==='string'?o.about.slice(0,400):'', al, th:isThumb(o.th)?o.th:'', t:Number.isFinite(o.t)?o.t:Date.now()};
}
function parseProfile(sv){
  const p=freshProfile(); if(!sv || typeof sv!=='object') return p;
  const ok=(v,a,b)=>Number.isInteger(v) && v>=a && v<=b;
  if(ok(sv.skin,0,0xffffff)) p.skin=sv.skin;
  if(ok(sv.hat,0,3)) p.hat=sv.hat;
  if(ok(sv.face,0,3)) p.face=sv.face;
  if(typeof sv.about==='string') p.about=sv.about.slice(0,300);
  if(Array.isArray(sv.recent)) p.recent=sv.recent.filter(x=>x && typeof x.n==='string' && Number.isFinite(x.t)).slice(0,5).map(cleanRecent);
  const ids=a=>Array.isArray(a) ? [...new Set(a.map(x=>typeof x==='string'?uidOf(x):null).filter(Boolean))] : [];
  p.friends=ids(sv.friends).slice(0,50); p.outgoing=ids(sv.outgoing).slice(0,30); p.incoming=ids(sv.incoming).slice(0,30); p.declined=ids(sv.declined).slice(0,100);
  const cm=o=>{
    const out={};
    if(o && typeof o==='object') for(const k of Object.keys(o)){
      const u=uidOf(k), c=o[k];
      if(u && c && typeof c.name==='string' && Number.isInteger(c.skin) && Number.isInteger(c.hat) && Number.isInteger(c.face))
        { const e={name:c.name.slice(0,24), skin:c.skin&0xffffff, hat:Math.min(3,Math.max(0,c.hat)), face:Math.min(3,Math.max(0,c.face)), t:Number.isFinite(c.t)?c.t:0};
          if(typeof c.about==='string') e.about=c.about.slice(0,300);
          if(Array.isArray(c.recent)) e.recent=c.recent.filter(x=>x && typeof x.n==='string' && Number.isFinite(x.t)).slice(0,5).map(cleanRecent);
          out[u]=e; }
    }
    return out;
  };
  p.fcache=cm(sv.fcache); p.met=cm(sv.met);
  if(Array.isArray(sv.games)) p.games=sv.games.filter(g=>g && typeof g.id==='string' && typeof g.name==='string' && typeof g.code==='string').slice(0,20)
    .map(g=>({id:g.id.slice(0,40), name:g.name.slice(0,40), lang:g.lang==='js'?'js':'lua', code:g.code.slice(0,20000), pub:cleanPub(g.pub), banned:typeof g.banned==='string'?g.banned.slice(0,200):''}));
  p.warnings=Array.isArray(sv.warnings)?sv.warnings.filter(w=>w && typeof w.text==='string').slice(0,20).map(w=>({text:w.text.slice(0,300),game:String(w.game||'').slice(0,40),kind:w.kind==='removed'?'removed':'warning',t:Number.isFinite(w.t)?w.t:0,seen:!!w.seen})):[];
  p.reported=Array.isArray(sv.reported)?sv.reported.filter(x=>typeof x==='string').slice(0,100).map(x=>x.slice(0,80)):[];
  p.repQ=Array.isArray(sv.repQ)?sv.repQ.map(r=>cleanReport(r,'')).filter(Boolean).slice(0,5):[];
  p.inbox=Array.isArray(sv.inbox)?sv.inbox.map(r=>cleanReport(r)).filter(Boolean).slice(0,25):[];
  p.modOut=Array.isArray(sv.modOut)?sv.modOut.map(w=>({u:uidOf(w&&w.u),gn:String((w&&w.gn)||'').slice(0,40),text:String((w&&w.text)||'').slice(0,300)})).filter(w=>w.u&&w.text).slice(0,30):[];
  if(sv.modKey && typeof sv.modKey==='object' && ['x','y','d'].every(k=>typeof sv.modKey[k]==='string' && sv.modKey[k].length<200)) p.modKey={x:sv.modKey.x,y:sv.modKey.y,d:sv.modKey.d};
  return p;
}
function saveProfile(){ if(!acct) return; try{ localStorage.setItem('webbyProfile:'+acct.uid, JSON.stringify(profile)); }catch(e){} }
let myName='Guest', mySkin=Y, myHat=0, myFace=0;
player.traverse(o=>{ if(o.material && o.material.color && o.material.color.getHex()===Y) o.userData.skin=true; });
function setSkin(root,hex){ root.traverse(o=>{ if(o.userData.skin && o.material) o.material.color.setHex(hex); }); }
setSkin(player,mySkin);

// ---- Hats (1 pirate, 2 baseball cap, 3 fedora) and faces (1 smiley, 2 angry, 3 surprised), all made of blocks ----
function makeHat(k){
  const g=new THREE.Group();
  const add=(w,h,d,c,x,y,z)=>{ g.add(part(w,h,d,c,x,y,z)); };
  if(k===1){          // pirate hat
    add(0.96,0.22,0.96,0x212121,0,3.11,0);
    add(1.5,0.1,0.78,0x212121,0,3.24,0);
    add(1.2,0.22,0.6,0x212121,0,3.4,0);
    add(1.52,0.05,0.8,0xffca28,0,3.2,0);
    add(0.2,0.16,0.02,0xffffff,0,3.38,0.31);
    add(0.04,0.05,0.02,0x212121,-0.05,3.4,0.325);
    add(0.04,0.05,0.02,0x212121,0.05,3.4,0.325);
  } else if(k===2){   // baseball cap
    add(0.98,0.3,0.98,0xd32f2f,0,3.15,0);
    add(0.86,0.06,0.55,0xb71c1c,0,3.03,0.72);
    add(0.1,0.06,0.1,0xb71c1c,0,3.33,0);
  } else if(k===3){   // fedora
    add(1.5,0.06,1.5,0x6d4c41,0,3.03,0);
    add(0.82,0.38,0.82,0x6d4c41,0,3.25,0);
    add(0.86,0.1,0.86,0x3e2723,0,3.13,0);
  }
  return g;
}
function makeFace(k){
  const g=new THREE.Group(), D=0x1a1a1a, Z=0.46;
  const add=(w,h,x,y,rz)=>{ const m=part(w,h,0.02,D,x,y,Z); if(rz) m.rotation.z=rz; g.add(m); };
  if(k===1){          // smiley
    add(0.1,0.15,-0.2,2.68); add(0.1,0.15,0.2,2.68);
    add(0.34,0.05,0,2.4); add(0.05,0.08,-0.2,2.45); add(0.05,0.08,0.2,2.45);
  } else if(k===2){   // angry
    add(0.1,0.1,-0.2,2.62); add(0.1,0.1,0.2,2.62);
    add(0.24,0.05,-0.2,2.76,-0.45); add(0.24,0.05,0.2,2.76,0.45);
    add(0.3,0.05,0,2.38); add(0.05,0.08,-0.18,2.33); add(0.05,0.08,0.18,2.33);
  } else if(k===3){   // surprised
    add(0.12,0.2,-0.2,2.66); add(0.12,0.2,0.2,2.66);
    add(0.2,0.04,-0.2,2.88); add(0.2,0.04,0.2,2.88);
    add(0.16,0.2,0,2.38);
  }
  return g;
}
function setLook(c,hat,face){
  if(c.hatObj){ c.b.remove(c.hatObj); c.hatObj=null; }
  if(c.faceObj){ c.b.remove(c.faceObj); c.faceObj=null; }
  if(hat>0){ c.hatObj=makeHat(hat); c.b.add(c.hatObj); }
  if(face>0){ c.faceObj=makeFace(face); c.b.add(c.faceObj); }
  c.hat=hat; c.face=face;
}
const myChar={b:body};
setLook(myChar,myHat,myFace);

// Name tags above players
const _v = new THREE.Vector3();
function mkLabel(txt){
  const d=document.createElement('div'); d.className='nm'; d.style.display='none';
  d.innerHTML='<div class="t"></div><div class="hb"><div class="hf"></div></div>';
  d.firstChild.textContent=txt; document.getElementById('names').appendChild(d); return d;
}
function setName(d,n){ const t=d.firstChild; if(t.textContent!==n) t.textContent=n; }
function setHealth(d,h){ const f=d.lastChild.firstChild; h=Math.max(0,Math.min(100,h)); f.style.width=h+'%'; f.style.background=h>50?'#4caf50':h>25?'#fbc02d':'#e53935'; }
// Respawn force field
const shGeo=new THREE.SphereGeometry(2.1,20,14);
function mkShield(){ return new THREE.Mesh(shGeo,new THREE.MeshBasicMaterial({color:0x66ccff,transparent:true,opacity:0.22,depthWrite:false})); }
const myShield=mkShield(); myShield.position.y=1.5; myShield.visible=false; player.add(myShield);
function setLabel(d,x,y,z,show){
  if(!d) return;
  _v.set(x,y,z).project(camera);
  if(!show || _v.z>1 || Math.abs(_v.x)>1.2 || Math.abs(_v.y)>1.2){ d.style.display='none'; return; }
  d.style.display='block';
  d.style.transform='translate('+((_v.x*0.5+0.5)*innerWidth)+'px,'+((-_v.y*0.5+0.5)*innerHeight)+'px) translate(-50%,-100%)';
}
const myLbl = mkLabel('');
// Chat bubbles above heads
const bubbles = new Map();
function showBubble(key,text){
  let b=bubbles.get(key);
  if(!b){ const el=document.createElement('div'); el.className='bub'; el.style.display='none'; document.getElementById('names').appendChild(el); b={el,until:0}; bubbles.set(key,b); }
  b.el.textContent=String(text).slice(0,100); b.until=performance.now()+6000;
}
function dropBubble(key){ const b=bubbles.get(key); if(b){ b.el.remove(); bubbles.delete(key); } }
function updateBubble(key,x,y,z,show){
  const b=bubbles.get(key); if(!b) return;
  const left=b.until-performance.now();
  if(left<=0){ dropBubble(key); return; }
  _v.set(x,y,z).project(camera);
  if(!show || _v.z>1 || Math.abs(_v.x)>1.2 || Math.abs(_v.y)>1.2){ b.el.style.display='none'; return; }
  b.el.style.display='block'; b.el.style.opacity = left<500 ? left/500 : 1;
  b.el.style.transform='translate('+((_v.x*0.5+0.5)*innerWidth)+'px,'+((-_v.y*0.5+0.5)*innerHeight)+'px) translate(-50%,-100%) translateY(-48px)';
}
const remotes = new Map(); let rpieces = [], room = null, lastSend = 0;
const palette = [0xd32f2f,0x7b1fa2,0xf57c00,0x00897b,0xc2185b,0x5d4037,0x455a64,0x6d4c41];
function colorFor(peer){ let h=0; for(const ch of peer) h=(h*31+ch.charCodeAt(0))>>>0; return palette[h%palette.length]; }
function makeChar(torso){
  const g=new THREE.Group(), b=new THREE.Group(); g.add(b);
  b.add(part(1.2,1.2,0.6,torso,0,1.6,0)); b.add(part(0.9,0.8,0.9,Y,0,2.6,0));
  const lb=(w,h,d,c,x,y)=>{ const q=new THREE.Group(); q.position.set(x,y,0); q.add(part(w,h,d,c,0,-h/2,0)); b.add(q); return q; };
  const r={g,b,aL:lb(0.5,1.2,0.6,Y,-0.85,2.2),aR:lb(0.5,1.2,0.6,Y,0.85,2.2),lL:lb(0.55,1,0.6,G,-0.3,1),lR:lb(0.55,1,0.6,G,0.3,1)};
  g.traverse(o=>{ if(o.material && o.material.color && o.material.color.getHex()===Y) o.userData.skin=true; });
  return r;
}
function spawnPieces(pos,f,torso,skin){
  pieceDefs.forEach(([w,h,d,c,x,y,z],i)=>{
    const m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), mat(i===1?torso:(c===Y && skin!==undefined ? skin : c)));
    m.position.copy(pos).add(new THREE.Vector3(x,y,z).applyAxisAngle(new THREE.Vector3(0,1,0),f)); m.rotation.y=f; scene.add(m);
    rpieces.push({m, half:Math.min(w,h,d)/2, ttl:7, vel:new THREE.Vector3((Math.random()-.5)*6,3+Math.random()*4,(Math.random()-.5)*6), spin:new THREE.Vector3((Math.random()-.5)*10,(Math.random()-.5)*10,(Math.random()-.5)*10)});
  });
}
function wireRoom(){
  room.on('obj', m=>{ if(!m.isMe) applyObj(m.data); });
  room.on('chat', m=>{ const d=m.data; if(!m.isMe && d && typeof d.text==='string') { const ct=censor(d.text.slice(0,100)).text; addChat(nameFor(d.from||'?', d.name), ct); if(remotes.has(d.from)) showBubble(d.from, ct); } });
  room.on('dev', m=>{ if(!m.isMe) devApplyObj(m.data,m.peer); });
  room.on('need', m=>{
    if(m.isMe) return;
    const payload={};
    if(objs.size) payload.list=[...objs.values()].map(o=>({op:'set',id:o.id,t:o.t,own:o.own,r:o.r,x:o.x,y:o.y,z:o.z}));
    if(devBlocks.size) payload.devBlocks=[...devBlocks.values()].map(o=>({op:'setBlock',id:o.id,owner:o.owner,x:o.x,y:o.y,z:o.z,w:o.w,h:o.h,d:o.d,color:o.color,solid:o.solid,kill:o.kill,damage:o.damage,bounce:o.bounce,visible:o.visible}));
    if(devSigns.size) payload.devSigns=[...devSigns.values()].map(o=>({op:'setSign',id:o.id,owner:o.owner,x:o.x,y:o.y,z:o.z,text:o.el.textContent,color:parseInt((o.el.style.color||'#ffffff').slice(1),16)||0xffffff,bg:parseInt((o.el.style.background||'#000000').slice(1),16)||0}));
    if(devCfgs.size) payload.devCfgs=[...devCfgs.entries()].map(([owner,c])=>Object.assign({owner},c));
    if(Object.keys(payload).length) room.emit('world',payload).catch(()=>{});
  });
  room.on('world', m=>{
    if(m.isMe||synced) return; synced=true;
    const d=m.data||{};
    if(Array.isArray(d.list)) d.list.slice(0,200).forEach(applyObj);
    if(Array.isArray(d.devBlocks)) d.devBlocks.forEach(x=>devApplyObj(x));
    if(Array.isArray(d.devSigns)) d.devSigns.forEach(x=>devApplyObj(x));
    if(Array.isArray(d.devCfgs)) d.devCfgs.forEach(c=>devApplyCfg(c,c.owner));
  });
  room.emit('need').catch(()=>{});
  room.onPeers(({peers,left})=>{
    left.forEach(pe=>{ [...objs.values()].filter(o=>o.own===pe.peer).forEach(o=>applyObj({op:'del',id:o.id,force:true})); devClearOwner(pe.peer); const r=remotes.get(pe.peer); if(r){ scene.remove(r.c.g); if(r.lbl) r.lbl.remove(); dropBubble(pe.peer); remotes.delete(pe.peer); } });
    peers.forEach(pe=>{
      if(pe.isMe) return;
      const s = pe.presence; if(!s || typeof s.x!=='number') return;
      let r = remotes.get(pe.peer);
      if(!r){ r={c:makeChar(colorFor(pe.peer)),dead:false,x:s.x,y:s.y,z:s.z,f:s.f||0}; scene.add(r.c.g); r.lbl=mkLabel(tagOf(pe.peer)); r.sh=mkShield(); r.sh.position.y=1.5; r.sh.visible=false; r.c.g.add(r.sh); remotes.set(pe.peer,r); }
      r.tx=s.x; r.ty=s.y; r.tz=s.z; r.tf=s.f||0; r.an=s.a||0; r.hp=typeof s.h==='number'?s.h:100; r.shield=!!s.sh;
      r.skin=(Number.isInteger(s.sk) && s.sk>=0 && s.sk<=0xffffff) ? s.sk : Y;
      r.name=(typeof s.nm==='string' && s.nm) ? censor(s.nm.slice(0,24)).text : undefined;
      if(r.appliedSkin!==r.skin){ setSkin(r.c.g,r.skin); r.appliedSkin=r.skin; }
      const ht=(s.ht>=1 && s.ht<=3)?(s.ht|0):0, fc=(s.fc>=1 && s.fc<=3)?(s.fc|0):0;
      if(r.c.hat!==ht || r.c.face!==fc) setLook(r.c,ht,fc);
      { const nn=uidOf(r.name); if(nn && acct && nn!==acct.uid) metSeen(nn,{name:r.name,skin:r.skin,hat:ht,face:fc}); }
      if(s.d && !r.dead){ r.dead=true; r.c.g.visible=false; spawnPieces(new THREE.Vector3(s.x,s.y,s.z), s.f||0, colorFor(pe.peer), r.skin); }
      else if(!s.d && r.dead){ r.dead=false; r.c.g.visible=true; r.x=s.x; r.y=s.y; r.z=s.z; }
    });
  });
}

// ---------- Wtool ----------
const TYPES = [{n:'Block',w:2,h:2,d:2,c:0x26a69a},{n:'Big Block',w:4,h:4,d:4,c:0x2196f3},{n:'Plank',w:6,h:0.5,d:2,c:0x8d6e63},{n:'Wall',w:6,h:4,d:0.6,c:0x9e9e9e},{n:'Pillar',w:1.2,h:6,d:1.2,c:0xab47bc}];
const objs = new Map();
// Particles
const parts=[], pgeo=new THREE.BoxGeometry(0.2,0.2,0.2);
function burst(x,y,z,color,n,sp){
  for(let i=0;i<n && parts.length<400;i++){
    const m=new THREE.Mesh(pgeo,new THREE.MeshBasicMaterial({color,transparent:true}));
    m.position.set(x+(Math.random()-.5)*sp,y+(Math.random()-.5)*sp,z+(Math.random()-.5)*sp);
    scene.add(m); const life=0.6+Math.random()*0.4;
    parts.push({m,life,ttl:life,v:new THREE.Vector3((Math.random()-.5)*7,2+Math.random()*5,(Math.random()-.5)*7)});
  }
}
// Health
function setHp(v){
  hp=Math.max(0,Math.min(100,v)); const f=document.getElementById('hpf');
  f.style.width=hp+'%'; f.style.background=hp>50?'#4caf50':hp>25?'#fbc02d':'#e53935';
  document.getElementById('hpt').textContent=Math.round(hp)+'%';
}
let tool='Move', toolOn=false, grabbed=null, lastObjSend=0, synced=false, pendR=0;
// Player settings (Esc menu): saved on this computer
const SET_DEF={vol:100,fov:60,sens:1,inv:false,fps:false};
let SET=Object.assign({},SET_DEF);
try{ const sv=JSON.parse(localStorage.getItem('webbySettings')||'null'); if(sv && typeof sv==='object'){
  if(Number.isFinite(sv.vol)) SET.vol=Math.max(0,Math.min(100,sv.vol)); if(Number.isFinite(sv.fov)) SET.fov=Math.max(40,Math.min(110,sv.fov));
  if(Number.isFinite(sv.sens)) SET.sens=Math.max(0.2,Math.min(3,sv.sens)); SET.inv=!!sv.inv; SET.fps=!!sv.fps; } }catch(e){}
function saveSettings(){ try{ localStorage.setItem('webbySettings',JSON.stringify(SET)); }catch(e){} }
camera.fov=SET.fov; camera.updateProjectionMatrix();
// Sound effects (made with the browser's audio, no files needed)
let ac=null;
function initAudio(){ try{ ac=ac||new (window.AudioContext||window.webkitAudioContext)(); if(ac.state==='suspended') ac.resume(); }catch(e){} }
addEventListener('pointerdown', initAudio); addEventListener('keydown', initAudio);
function beep(f1,f2,dur,type,vol){
  try{
    initAudio(); if(!ac) return;
    const o=ac.createOscillator(), g=ac.createGain(), t0=ac.currentTime;
    o.type=type; o.frequency.setValueAtTime(f1,t0); o.frequency.exponentialRampToValueAtTime(f2,t0+dur);
    vol=vol*SET.vol/100; if(vol<=0.0005) return;
    g.gain.setValueAtTime(vol,t0); g.gain.exponentialRampToValueAtTime(0.0005,t0+dur);
    o.connect(g); g.connect(ac.destination); o.start(t0); o.stop(t0+dur);
  }catch(e){}
}
const sfx = {
  place:()=>beep(300,120,0.12,'square',0.15),
  pick:()=>beep(400,700,0.08,'triangle',0.18),
  drop:()=>beep(250,100,0.12,'square',0.15),
  rotate:()=>beep(500,800,0.07,'triangle',0.14),
  del:()=>beep(300,60,0.2,'sawtooth',0.1),
  hurt:()=>beep(200,90,0.12,'sawtooth',0.15),
  coin:()=>beep(900,1400,0.1,'square',0.15),
  win:()=>{ beep(520,520,0.12,'square',0.15); setTimeout(()=>beep(660,660,0.12,'square',0.15),130); setTimeout(()=>beep(880,880,0.25,'square',0.15),260); },
  die:()=>{ beep(500,40,0.6,'sawtooth',0.2); setTimeout(()=>beep(120,30,0.5,'square',0.15),150); }
};
function dim(t,r){ const T=TYPES[t]; return (r&1) ? {w:T.d,h:T.h,d:T.w} : {w:T.w,h:T.h,d:T.d}; }

// Dance music (made with the browser's audio)
let musicTimer=null, mStep=0, mg=null, nbuf=null;
function mTone(f1,f2,dur,type,vol,t){
  const o=ac.createOscillator(), g=ac.createGain(); o.type=type;
  o.frequency.setValueAtTime(f1,t); if(f2!==f1) o.frequency.exponentialRampToValueAtTime(f2,t+dur);
  g.gain.setValueAtTime(vol,t); g.gain.exponentialRampToValueAtTime(0.001,t+dur);
  o.connect(g); g.connect(mg); o.start(t); o.stop(t+dur+0.02);
}
function mNoise(dur,vol,hp,t){
  if(!nbuf){ nbuf=ac.createBuffer(1,ac.sampleRate*0.3,ac.sampleRate); const d=nbuf.getChannelData(0); for(let i=0;i<d.length;i++) d[i]=Math.random()*2-1; }
  const s=ac.createBufferSource(), f=ac.createBiquadFilter(), g=ac.createGain();
  s.buffer=nbuf; f.type='highpass'; f.frequency.value=hp;
  g.gain.setValueAtTime(vol,t); g.gain.exponentialRampToValueAtTime(0.001,t+dur);
  s.connect(f); f.connect(g); g.connect(mg); s.start(t); s.stop(t+dur);
}
const CH=[[220,261.63,329.63],[174.61,220,261.63],[261.63,329.63,392],[196,246.94,293.66]], BASS=[55,43.65,65.41,49];
function mStepPlay(s,t){
  const bar=Math.floor(s/16)%4, c=CH[bar], b=BASS[bar]*(s%4===2?2:1);
  if(s%4===0) mTone(160,45,0.18,'sine',0.7,t);
  if(s%4===2) mNoise(0.05,0.12,7000,t);
  if(s%8===4) mNoise(0.12,0.2,1500,t);
  if(s%2===0) mTone(b,b,0.2,'triangle',0.35,t);
  const a=c[[0,1,2,1][s%4]]*(s%16>=8?2:1); mTone(a,a,0.1,'square',0.05,t);
}
function startMusic(){
  initAudio(); if(!ac || musicTimer) return;
  mg=ac.createGain(); mg.gain.value=0.5; mg.connect(ac.destination);
  mStep=0; let next=ac.currentTime+0.05; const sd=60/124/4;
  const tick=()=>{ while(next<ac.currentTime+0.25){ mStepPlay(mStep,next); mStep++; next+=sd; } };
  tick(); musicTimer=setInterval(tick,80);
}
function stopMusic(){
  clearInterval(musicTimer); musicTimer=null;
  if(mg){ const g=mg; g.gain.cancelScheduledValues(ac.currentTime); g.gain.setTargetAtTime(0,ac.currentTime,0.05); setTimeout(()=>g.disconnect(),500); mg=null; }
}
function setBox(o){ const T=dim(o.t,o.r||0), b=o.box; b.minx=o.x-T.w/2; b.maxx=o.x+T.w/2; b.minz=o.z-T.d/2; b.maxz=o.z+T.d/2; b.miny=o.y-T.h/2; b.maxy=o.y+T.h/2; o.mesh.position.set(o.x,o.y,o.z); o.mesh.rotation.y=(o.r||0)*Math.PI/2; }
function applyObj(d){
  if(!d || typeof d!=='object' || typeof d.id!=='string') return;
  if(d.op==='del'){
    const o=objs.get(d.id); if(!o) return;
    if(!d.force && d.own!==o.own) return;
    burst(o.x,o.y,o.z,TYPES[o.t].c,22,Math.max(TYPES[o.t].w,TYPES[o.t].d));
    scene.remove(o.mesh); worldMeshes.splice(worldMeshes.indexOf(o.mesh),1); boxes.splice(boxes.indexOf(o.box),1); objs.delete(d.id);
    if(grabbed===d.id) grabbed=null; return;
  }
  if(d.op!=='set' || !TYPES[d.t] || !(Math.abs(d.x)<100 && Math.abs(d.z)<100 && d.y>-5 && d.y<100)) return;
  let o=objs.get(d.id); const fresh=!o;
  if(o && d.own!==o.own && o.own!=='local') return;
  if(!o){
    if(objs.size>=200) return;
    const T=TYPES[d.t], mesh=new THREE.Mesh(new THREE.BoxGeometry(T.w,T.h,T.d), mat(T.c));
    mesh.userData.id=d.id; scene.add(mesh); worldMeshes.push(mesh);
    const box={}; boxes.push(box); o={id:d.id,t:d.t,own:(typeof d.own==='string'?d.own.slice(0,100):'local'),mesh,box}; objs.set(d.id,o);
  }
  o.x=d.x; o.y=d.y; o.z=d.z; o.r=(d.r|0)&3; setBox(o);
  const T0=TYPES[o.t];
  if(fresh) burst(o.x,o.y,o.z,T0.c,22,Math.max(T0.w,T0.d));
  else if(performance.now()-(o.pt||0)>120){ o.pt=performance.now(); burst(o.x,o.y,o.z,T0.c,3,1); }
}
function send(d){ if(room) room.emit('obj',d).catch(()=>{}); }
function myId(){ const me = room && room.peers().find(x=>x.isMe); return me ? me.peer : 'local'; }
function sendObj(o){ send({op:'set',id:o.id,t:o.t,own:o.own,r:o.r,x:o.x,y:o.y,z:o.z}); }
const ray = new THREE.Raycaster(), mouse = new THREE.Vector2();
function pick(e, skipId){
  const r = renderer.domElement.getBoundingClientRect();
  if(shiftLock) mouse.set(0,0); else mouse.set((e.clientX-r.left)/r.width*2-1, -((e.clientY-r.top)/r.height*2-1));
  ray.setFromCamera(mouse, camera);
  return ray.intersectObjects(worldMeshes.filter(m=>!skipId || m.userData.id!==skipId), false)[0] || null;
}
function spot(h,T){
  const n=h.face.normal;
  return {x:Math.round((h.point.x+n.x*T.w/2)*2)/2, y:Math.max(h.point.y+n.y*T.h/2, T.h/2), z:Math.round((h.point.z+n.z*T.d/2)*2)/2};
}
function hitsPlayer(s,T){
  return p.x+HW>s.x-T.w/2 && p.x-HW<s.x+T.w/2 && p.z+HW>s.z-T.d/2 && p.z-HW<s.z+T.d/2 && p.y+H>s.y-T.h/2 && p.y<s.y+T.h/2;
}
function drop(){
  const o=objs.get(grabbed); grabbed=null;
  if(o){ o.mesh.material.emissive.setHex(0); sendObj(o); sfx.drop(); burst(o.x,o.y,o.z,TYPES[o.t].c,8,1.5); }
}
function wClick(e){
  if(!toolOn || !running) return;
  if(tool==='Move'){
    if(grabbed){ drop(); return; }
    const h=pick(e), id=h && h.object.userData.id;
    if(id && !isMine(objs.get(id))) notYours();
    else if(id){ grabbed=id; objs.get(id).mesh.material.emissive.setHex(0x444444); sfx.pick(); const g=objs.get(id); burst(g.x,g.y,g.z,TYPES[g.t].c,8,1.5); }
  } else if(tool==='Delete'){
    const h=pick(e), id=h && h.object.userData.id;
    if(id && !isMine(objs.get(id))) notYours();
    else if(id){ const dd={op:'del',id,own:objs.get(id).own}; applyObj(dd); send(dd); sfx.del(); }
  } else {
    const ti=TYPES.findIndex(t=>t.n===tool), T=dim(ti,pendR), h=pick(e);
    if(!h) return;
    const s=spot(h,T); if(hitsPlayer(s,T)) return;
    const d={op:'set',id:'o'+Math.random().toString(36).slice(2,9),t:ti,own:myId(),r:pendR,x:s.x,y:s.y,z:s.z};
    applyObj(d); send(d); sfx.place();
  }
}
const cvw = renderer.domElement; let sx=0, sy=0;
cvw.addEventListener('pointerdown', e=>{ sx=e.clientX; sy=e.clientY; });
cvw.addEventListener('pointerup', e=>{ if(Math.hypot(e.clientX-sx,e.clientY-sy)<5) wClick(e); });
cvw.addEventListener('pointermove', e=>{
  if(!grabbed || !toolOn) return;
  const o=objs.get(grabbed); if(!o){ grabbed=null; return; }
  const T=dim(o.t,o.r), h=pick(e,grabbed); if(!h) return;
  const s=spot(h,T); if(hitsPlayer(s,T)) return;
  o.x=s.x; o.y=s.y; o.z=s.z; setBox(o);
  if(performance.now()-(o.pt||0)>120){ o.pt=performance.now(); burst(o.x,o.y,o.z,TYPES[o.t].c,3,1); }
  if(performance.now()-lastObjSend>80){ lastObjSend=performance.now(); sendObj(o); }
});
// Wtool UI: hotbar (press 1) + panel
const wp=document.getElementById('wp'), bar=document.getElementById('bar'), whint=document.getElementById('whint');
let slot1=null;
'1234567890'.split('').forEach(k=>{
  const s=document.createElement('div'); s.className='slot'; s.innerHTML='<i>'+k+'</i>'+(k==='1'?'Wtool':'');
  bar.appendChild(s); if(k==='1') slot1=s;
});
function mark(){
  [...wp.querySelectorAll('.it')].forEach(b=>b.classList.toggle('on', b.textContent===tool));
  whint.textContent = tool==='Move' ? 'Click an object to pick it up, move the mouse, click again to drop it. Press R to rotate it.' : tool==='Delete' ? 'Click an object to delete it.' : 'Click the world to place a '+tool+'. Press R to rotate it first.';
}
['Move','Delete',...TYPES.map(t=>t.n)].forEach(n=>{
  const b=document.createElement('button'); b.className='sq it'; b.textContent=n;
  b.onclick=()=>{ if(grabbed) drop(); tool=n; mark(); }; wp.appendChild(b);
});
mark();
function toggleTool(){
  if(!running || customMode) return;
  toolOn=!toolOn; if(!toolOn && grabbed) drop();
  wp.classList.toggle('hide',!toolOn); slot1.classList.toggle('on',toolOn);
}
addEventListener('keydown', e=>{
  if(customMode) engine.key(e);
  if(e.code==='Enter' && !e.repeat && running) openChat();
  if((e.code==='ShiftLeft' || e.code==='ShiftRight') && !e.repeat && running) toggleLock();
  if(e.code==='Escape' && !e.repeat && running){ if(!devPanel.classList.contains('hide')) devPanel.classList.add('hide'); else if(pv){ closeProfile(); } }
  if(e.code==='Digit1'||e.code==='Numpad1') toggleTool();
  if(e.code==='KeyR' && toolOn && running){
    if(grabbed){
      const o=objs.get(grabbed);
      if(o){ const old=o.r||0; o.r=(old+1)&3; if(hitsPlayer(o,dim(o.t,o.r))) o.r=old; else { setBox(o); sendObj(o); sfx.rotate(); } }
    } else if(tool!=='Move' && tool!=='Delete'){ pendR=(pendR+1)&3; sfx.rotate(); }
  }
});
slot1.onclick = toggleTool;

// ---------- DevTools: shared-world Lua scripting for a live party ----------
// Scripts run once, top to bottom. Every change goes out as plain data (a block's
// position, colour, size...) over the same room channel parties already use, and
// every other client applies that data locally. No one else's browser ever runs
// your Lua or JS - only you do, which is what keeps it safe to share.
const devBlocks=new Map(), devSigns=new Map();
const devCfgs=new Map();                 // owner -> {g,s,j,sky} (only the fields that player set) -- every player keeps their own settings
let devCfgStamp=0, devSeq=0, devToastT=null;
const devNonce=Math.random().toString(36).slice(2,8);   // keeps block ids unique even if two players ever share a peer id
const devLocalTouch=new Map();           // id -> {fn, was} -- onTouch only ever runs for the author, locally
function devOwner(){ return (typeof room!=='undefined' && room) ? myId() : 'local'; }
function devNextId(){ return 'd'+devOwner()+'-'+devNonce+'-'+(devSeq++); }
function devSkyHex(){ return (scene.background && scene.background.getHex) ? scene.background.getHex() : 0x9fd3f0; }
let devQ=[], devQT=null;
function devFlush(){
  devQT=null; if(!(typeof room!=='undefined' && room)){ devQ=[]; return; }
  while(devQ.length){ const chunk=devQ.splice(0,60); room.emit('dev',{op:'batch',list:chunk}).catch(()=>{}); }
}
function devSend(d){ if(!(typeof room!=='undefined' && room)) return; devQ.push(d); if(!devQT) devQT=setTimeout(devFlush,25); }

function devReadBlockProps(o){
  const num=(v,d)=>{ const n=Number(v); return (v===undefined||v===null||!isFinite(n))?d:n; };
  const clampP=v=>Math.max(-300,Math.min(300,v));
  return {
    x:clampP(num(o.x,0)), y:clampP(num(o.y,0.5)), z:clampP(num(o.z,0)),
    w:Math.max(0.1,Math.min(60,num(o.w,4))), h:Math.max(0.1,Math.min(60,num(o.h,1))), d:Math.max(0.1,Math.min(60,num(o.d,4))),
    color:parseColor(o.color), solid:o.solid!==false, kill:!!o.kill, damage:Math.max(0,num(o.damage,0)), bounce:Math.max(0,num(o.bounce,0)),
    visible:o.visible!==false
  };
}
function devReadSignProps(o){
  const num=(v,d)=>{ const n=Number(v); return (v===undefined||v===null||!isFinite(n))?d:n; };
  const clampP=v=>Math.max(-300,Math.min(300,v));
  return { x:clampP(num(o.x,0)), y:clampP(num(o.y,2)), z:clampP(num(o.z,0)),
           text:String(o.text===undefined?'':o.text).slice(0,120),
           color:o.color!==undefined?parseColor(o.color):0xffffff, bg:o.bg!==undefined?parseColor(o.bg):0x000000 };
}

function devRemoveBlock(id){
  const o=devBlocks.get(id); if(!o) return;
  scene.remove(o.mesh); o.mesh.geometry.dispose(); o.mesh.material.dispose();
  const i=boxes.indexOf(o.box); if(i>=0) boxes.splice(i,1);
  devBlocks.delete(id); devLocalTouch.delete(id);
}
function devRemoveSign(id){
  const o=devSigns.get(id); if(!o) return;
  o.el.remove(); devSigns.delete(id);
}
function devEffectiveCfg(){
  const eff={g:30,s:8,j:12,sky:0x9fd3f0}, best={};
  devCfgs.forEach(c=>{ ['g','s','j','sky'].forEach(k=>{ if(c[k]!==undefined && (best[k]===undefined || c.t>=best[k])){ best[k]=c.t; eff[k]=c[k]; } }); });
  GRAV=Math.max(0,Math.min(200,eff.g)); SPEED=Math.max(0,Math.min(60,eff.s)); JUMPV=Math.max(0,Math.min(80,eff.j));
  scene.background=new THREE.Color(Number.isInteger(eff.sky)?eff.sky:0x9fd3f0);
}
// d holds only the fields a player changed, so one player's gravity() never overwrites another player's sky() or speed()
function devApplyCfg(d,owner){
  if(!d) return; const c=devCfgs.get(owner)||{t:0};
  if(isFinite(d.g)) c.g=Math.max(0,Math.min(200,d.g));
  if(isFinite(d.s)) c.s=Math.max(0,Math.min(60,d.s));
  if(isFinite(d.j)) c.j=Math.max(0,Math.min(80,d.j));
  if(Number.isInteger(d.sky)) c.sky=d.sky;
  c.t=++devCfgStamp; devCfgs.set(owner,c); devEffectiveCfg();
}
function devRevertCfg(){ devCfgs.clear(); devEffectiveCfg(); }
function devClearOwner(owner){
  [...devBlocks.entries()].forEach(([id,o])=>{ if(o.owner===owner) devRemoveBlock(id); });
  [...devSigns.entries()].forEach(([id,o])=>{ if(o.owner===owner) devRemoveSign(id); });
  if(devCfgs.delete(owner)) devEffectiveCfg();
}
function devWipeAll(){
  [...devBlocks.keys()].forEach(devRemoveBlock); [...devSigns.keys()].forEach(devRemoveSign);
  devLocalTouch.clear(); devRevertCfg();
}
function devApplyObj(d,sender){
  if(!d || typeof d!=='object') return;
  if(d.op==='batch'){ if(Array.isArray(d.list)) d.list.forEach(x=>devApplyObj(x,sender)); return; }
  // a message from another player can only ever touch that player's own stuff (their real peer id is the owner)
  if(sender && sender!=='local'){ d=Object.assign({},d); if(d.op!=='delBlock' && d.op!=='delSign') d.owner=sender; }
  if(d.op==='clear'){ devClearOwner(d.owner); return; }
  if(d.op==='cfg'){ devApplyCfg(d,d.owner); return; }
  if(d.op==='delBlock'){ const o=devBlocks.get(d.id); if(o && (!sender || o.owner===sender)) devRemoveBlock(d.id); return; }
  if(d.op==='delSign'){ const o=devSigns.get(d.id); if(o && (!sender || o.owner===sender)) devRemoveSign(d.id); return; }
  if(d.op==='setBlock'){
    const props=devReadBlockProps(d);
    if(!(Math.abs(props.x)<=300 && Math.abs(props.y)<=300 && Math.abs(props.z)<=300)) return;
    let o=devBlocks.get(d.id);
    if(o && o.owner!==d.owner) return;   // never let one player overwrite another player's block
    if(!o){
      const mesh=new THREE.Mesh(new THREE.BoxGeometry(1,1,1), new THREE.MeshLambertMaterial({color:props.color}));
      scene.add(mesh); o={id:d.id, owner:d.owner, mesh, box:{}, solid:false, hurtT:0}; devBlocks.set(d.id,o);
    }
    const wasSolid=o.solid, box=o.box;
    Object.assign(o,props);
    if(props.solid!==wasSolid){ const i=boxes.indexOf(box); if(props.solid && i<0) boxes.push(box); if(!props.solid && i>=0) boxes.splice(i,1); }
    box.minx=o.x-o.w/2; box.maxx=o.x+o.w/2; box.miny=o.y-o.h/2; box.maxy=o.y+o.h/2; box.minz=o.z-o.d/2; box.maxz=o.z+o.d/2;
    o.mesh.position.set(o.x,o.y,o.z); o.mesh.scale.set(o.w,o.h,o.d); o.mesh.material.color.setHex(o.color); o.mesh.visible=o.visible && !customMode;
    return;
  }
  if(d.op==='setSign'){
    const props=devReadSignProps(d);
    if(!(Math.abs(props.x)<=300 && Math.abs(props.y)<=300 && Math.abs(props.z)<=300)) return;
    let o=devSigns.get(d.id);
    if(o && o.owner!==d.owner) return;
    if(!o){
      const el=document.createElement('div'); el.className='sign'; el.style.display='none';
      document.getElementById('names').appendChild(el); o={id:d.id, owner:d.owner, el}; devSigns.set(d.id,o);
    }
    o.x=props.x; o.y=props.y; o.z=props.z; o.el.textContent=props.text;
    o.el.style.color='#'+props.color.toString(16).padStart(6,'0'); o.el.style.background='#'+props.bg.toString(16).padStart(6,'0');
    return;
  }
}
function devSendApply(id,op,props){ const owner=devOwner(); const d=Object.assign({op,id,owner},props); devApplyObj(d); devSend(d); }
function devMessage(text,secs){
  const el=document.getElementById('cmsg'); el.textContent=String(text).slice(0,140); el.classList.remove('hide');
  clearTimeout(devToastT); devToastT=setTimeout(()=>el.classList.add('hide'),Math.max(0.5,Number(secs)||3)*1000);
}
function devHud(text){ const el=document.getElementById('chud'); text=String(text).slice(0,140); el.textContent=text; el.classList.toggle('hide',!text); }
function devClearMine(){
  const own=devOwner(); devClearOwner(own);
  devSend({op:'clear',owner:own});
}
function devPrint(t,isErr){
  const out=document.getElementById('dOut'); const d=document.createElement('div');
  if(isErr) d.className='err'; d.textContent=String(t).slice(0,300); out.appendChild(d);
  while(out.children.length>80) out.firstChild.remove(); out.scrollTop=out.scrollHeight;
}
function bindDevLua(vm){
  const G=vm.G, N=(n,f)=>G.set(n,f), owner=devOwner();
  const lp=new LuaTable(); lp.set('x',p.x); lp.set('y',p.y); lp.set('z',p.z); lp.set('health',hp); G.set('player',lp);
  function handle(kind,id,props){
    const t=new LuaTable();
    const sync=()=>{ ['x','y','z','w','h','d'].forEach(k=>{ if(props[k]!==undefined) t.set(k,props[k]); }); };
    sync();
    if(kind==='block'){
      t.set('setColor',(s,c)=>{ props.color=parseColor(luaToJS(c)); devSendApply(id,'setBlock',props); });
      t.set('setPosition',(s,x,y,z)=>{ if(x!==undefined)props.x=Number(x); if(y!==undefined)props.y=Number(y); if(z!==undefined)props.z=Number(z); sync(); devSendApply(id,'setBlock',props); });
      t.set('setSize',(s,w,h,d)=>{ if(w!==undefined)props.w=Number(w); if(h!==undefined)props.h=Number(h); if(d!==undefined)props.d=Number(d); sync(); devSendApply(id,'setBlock',props); });
      t.set('setVisible',(s,on)=>{ props.visible=luaTruthy(on); devSendApply(id,'setBlock',props); });
      t.set('destroy',()=>{ devRemoveBlock(id); devSend({op:'delBlock',id}); });
      t.set('onTouch',(s,fn)=>{
        if(!(fn instanceof LuaFunction) && typeof fn!=='function') throw vm.err('expected a function');
        devLocalTouch.set(id,{was:false,fn:()=>{ vm.steps=0; vm.depth=0; try{ vm.call(fn,[lp]); }catch(e){ devPrint((e.lua&&e.line?'Line '+e.line+': ':'')+e.message,true); } }});
      });
    } else {
      t.set('setText',(s,txt)=>{ props.text=vm.tostr(txt).slice(0,120); devSendApply(id,'setSign',props); });
      t.set('setPosition',(s,x,y,z)=>{ if(x!==undefined)props.x=Number(x); if(y!==undefined)props.y=Number(y); if(z!==undefined)props.z=Number(z); devSendApply(id,'setSign',props); });
      t.set('destroy',()=>{ devRemoveSign(id); devSend({op:'delSign',id}); });
    }
    return t;
  }
  N('block',raw=>{
    const props=devReadBlockProps(raw instanceof LuaTable?luaToJS(raw):{}); const id=devNextId();
    devApplyObj(Object.assign({op:'setBlock',id,owner},props)); devSend(Object.assign({op:'setBlock',id,owner},props));
    return handle('block',id,props);
  });
  N('sign',raw=>{
    const props=devReadSignProps(raw instanceof LuaTable?luaToJS(raw):{}); const id=devNextId();
    devApplyObj(Object.assign({op:'setSign',id,owner},props)); devSend(Object.assign({op:'setSign',id,owner},props));
    return handle('sign',id,props);
  });
  N('gravity',n=>{ const d={g:Math.max(0,Math.min(200,Number(n)||30))}; devApplyCfg(d,owner); devSend(Object.assign({op:'cfg',owner},d)); });
  N('speed',n=>{ const d={s:Math.max(0,Math.min(60,Number(n)||8))}; devApplyCfg(d,owner); devSend(Object.assign({op:'cfg',owner},d)); });
  N('jump',n=>{ const d={j:Math.max(0,Math.min(80,Number(n)||12))}; devApplyCfg(d,owner); devSend(Object.assign({op:'cfg',owner},d)); });
  N('sky',c=>{ const d={sky:parseColor(luaToJS(c))}; devApplyCfg(d,owner); devSend(Object.assign({op:'cfg',owner},d)); });
  N('clear',()=>devClearMine());
  N('message',(t,s)=>devMessage(vm.tostr(t),s));
  N('hud',t=>devHud(vm.tostr(t)));
  N('playSound',n=>{ const f={coin:sfx.coin,win:sfx.win,hit:sfx.hurt,hurt:sfx.hurt,jump:()=>beep(300,600,0.12,'square',0.15),pop:sfx.place,place:sfx.place,pick:sfx.pick,die:sfx.die}[vm.tostr(n)]; if(f) f(); });
  N('print',(...a)=>devPrint(a.map(x=>vm.tostr(x)).join('\t')));
  N('random',vm.G.get('math').get('random'));
  N('time',()=>performance.now()/1000);
}


// ---------- Chat ----------
const ci = document.getElementById('ci'), clog = document.getElementById('clog'); let typing = false;
// ---------- Swear filter + build ownership helpers ----------
const _rot=s=>s.replace(/[a-z]/g,c=>String.fromCharCode((c.charCodeAt(0)-97+13)%26+97));
const STEMS=_rot("shpx,fuvg,ovgpu,phag,juber,fyhg,jnax,gjng,avtt,sntt,onfgneq,zbgures,ergneq,qvpxurnq,nffubyr,qhzonff,wnpxnff").split(','), WORDS=_rot("nff,nefr,qnza,penc,qvpx,pbpx,pbpxf,chffl,cvff,qbhpur,cevpx,gvgf,obyybpxf,snt,fcvp,puvax,xvxr,genaal,pbba").split(',');
const STEMS_ND=STEMS.filter(s=>!/(.)\1/.test(s)), WORDS_ND=WORDS.filter(s=>!/(.)\1/.test(s));
const OKAYW=['scunthorpe','shiitake','shitake'];
const _leet={'@':'a','$':'s','0':'o','1':'i','3':'e','4':'a','5':'s','7':'t'};
function isSwear(tok){
  const n=tok.toLowerCase().replace(/[@$013457]/g,c=>_leet[c]).replace(/[^a-z]/g,'');
  if(!n || OKAYW.some(o=>n.includes(o))) return false;
  const a=n.replace(/(.)\1{2,}/g,'$1$1'), b=n.replace(/(.)\1+/g,'$1');
  if(WORDS.includes(a) || WORDS.includes(n)) return true;
  if(STEMS.some(s=>a.includes(s))) return true;
  return STEMS_ND.some(s=>b.includes(s)) || WORDS_ND.includes(b);
}
function censor(text){
  let count=0;
  const out=String(text).replace(/[A-Za-z0-9@$]+/g, t=>{ if(isSwear(t)){ count++; return '####'; } return t; });
  return {text:out,count};
}
let strikes=0;
function swearWarn(n){
  strikes+=n;
  if(strikes>=3){
    strikes=0;
    if(typeof kickPublic==='function' && typeof party!=='undefined' && party && party.pub) kickPublic();
    else addChat('Warning','Please stop swearing. Your warnings were reset.');
  } else addChat('Warning','Warning '+strikes+'/3: Please do not swear.');
}
let allowEdit=false;
function isMine(o){ return !!o && (allowEdit || (typeof party!=='undefined' && party && party.host) || o.own===myId() || o.own==='local'); }
let _ny=0;
function notYours(){ if(performance.now()-_ny>1500){ _ny=performance.now(); addChat('Game',"That build isn't yours."); } sfx.hurt(); }
function nameOf(id){ const r=remotes.get(id); return (r && r.name) || tagOf(id); }
function nameFor(id,nm){ return (typeof nm==='string' && nm) ? censor(nm.slice(0,24)).text : nameOf(id); }
function tagOf(id){ if(id==='local') return 'You'; let h=0; for(const ch of String(id)) h=(h*31+ch.charCodeAt(0))>>>0; return 'Player '+(h%900+100); }
function addChat(name,text){
  const d=document.createElement('div'); d.className='cm';
  const b=document.createElement('b'); b.textContent=name+': ';
  d.appendChild(b); d.appendChild(document.createTextNode(text));
  clog.appendChild(d);
  while(clog.children.length>6) clog.firstChild.remove();
  setTimeout(()=>d.remove(), 12000);
}
function openChat(){ releaseLock(); Object.keys(keys).forEach(k=>keys[k]=false); typing=true; ci.classList.remove('hide'); ci.value=''; ci.focus(); }
function closeChat(){ typing=false; ci.classList.add('hide'); ci.blur(); }
function submitChat(){
  const text = ci.value.trim().slice(0,100); closeChat();
  if(!text) return;
  if(text.toLowerCase()==='/e dance'){ if(running && !dead && onGround && !climbing) dancing = true; return; }
  const cr=censor(text);
  addChat('You', cr.text);
  if(cr.text) showBubble('me', cr.text);
  if(room) room.emit('chat',{from:myId(),text:cr.text,name:myName}).catch(()=>{});
  if(cr.count) swearWarn(cr.count);
}
ci.addEventListener('keydown', e=>{
  e.stopPropagation();
  if(e.key==='Enter') submitChat(); else if(e.key==='Escape') closeChat();
});
ci.addEventListener('keyup', e=>e.stopPropagation());
ci.addEventListener('blur', ()=>{ if(typing) closeChat(); });

// ---------- Party servers (PeerJS, direct player-to-player) ----------
const pp=document.getElementById('pp'), pstat=document.getElementById('pstat'), pcode=document.getElementById('pcode');
let party=null;
function pshow(id,on){ document.getElementById(id).classList.toggle('hide',!on); }
function setStat(t){ if(pstat.textContent!==t) pstat.textContent=t; }
function partyUI(st){
  const idle = st==='idle' || st==='public';
  pshow('pj',idle); pshow('ph',idle); pshow('pcodebox',st==='host'); pshow('hset',st==='host');
  pshow('pleave',st==='host' || st==='client');
  if(!idle) pshow('pjoin',false);
}
function setCount(t){ const c=document.getElementById('pcount'); if(c.textContent!==t) c.textContent=t; }
document.getElementById('pb').onclick=()=>pp.classList.toggle('hide');
function loadPeer(){
  return new Promise((res,rej)=>{
    if(window.Peer) return res();
    const sc=document.createElement('script');
    sc.src='https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js';
    sc.onload=res; sc.onerror=()=>rej(new Error('load'));
    document.head.appendChild(sc);
  });
}
// A small object that looks like the "room" the published page uses, but runs over PeerJS.
function makeShim(peer,isHost,hconn,cb){
  const me=peer.id, handlers={}, states=new Map(), conns=[]; let myPres={}, peersCb=null, closed=false, cfg={edit:false}; const banned=new Set();
  const list=()=>[{peer:me,isMe:true,presence:myPres},...[...states].map(([id,st])=>({peer:id,isMe:false,presence:st}))];
  const notify=left=>{ if(peersCb) peersCb({peers:list(),left:left||[]}); cb.count(states.size+1); };
  const sendAll=(m,except)=>{ conns.forEach(c=>{ if(c!==except && c.open) c.send(m); }); };
  const out=m=>{ if(isHost) sendAll(m); else if(hconn && hconn.open) hconn.send(m); };
  function dropPeer(id){
    const i=conns.findIndex(x=>x.peer===id);
    if(i>=0){ const c=conns[i]; conns.splice(i,1); try{ c.close(); }catch(e){} }
    if(states.has(id)){ states.delete(id); notify([{peer:id}]); sendAll({k:'l',id}); }
  }
  function onMsg(m,from){
    if(closed || !m || typeof m!=='object') return;
    if(isHost && from){
      if(m.k==='bye'){ dropPeer(from.peer); return; }
      if(m.k==='hello'){
        if(from.verified) return;
        if(banned.has(m.uid)){ try{ from.send({k:'kick',why:'You were banned from this party by the host.'}); }catch(e){} setTimeout(()=>{ try{from.close();}catch(e){} },300); return; }
        from.uid=m.uid; from.verified=true; from.send({k:'cfg',c:cfg}); return;
      }
      if(!from.verified) return;
      m.f=from.peer;
    }
    if(m.k==='e'){ const h=handlers[m.t]; if(h) h({isMe:false,peer:m.f,data:m.d}); if(isHost) sendAll(m,from); }
    else if(m.k==='p'){ if(typeof m.f!=='string'||m.f===me) return; states.set(m.f,m.s); notify(); if(isHost) sendAll(m,from); }
    else if(m.k==='l' && !isHost){ states.delete(m.id); notify([{peer:m.id}]); }
    else if(m.k==='bye' && !isHost){ closed=true; const ids=[...states.keys()]; states.clear(); notify(ids.map(id=>({peer:id}))); peersCb=null; try{ peer.destroy(); }catch(e){} cb.end('The host left the party.'); }
    else if(m.k==='cfg' && !isHost){ cb.cfg(m.c); }
    else if(m.k==='kick' && !isHost){ closed=true; const ids=[...states.keys()]; states.clear(); notify(ids.map(id=>({peer:id}))); peersCb=null; try{ peer.destroy(); }catch(e){} cb.end(m.why||'You were removed from the party.'); }
  }
  if(isHost){
    peer.on('connection', c=>{
      c.on('open', ()=>{
        conns.push(c);
        states.forEach((st,id)=>c.send({k:'p',f:id,s:st}));
        c.send({k:'p',f:me,s:myPres});
      });
      c.on('data', d=>onMsg(d,c));
      const gone=()=>{ const i=conns.indexOf(c); if(i<0) return; conns.splice(i,1); states.delete(c.peer); notify([{peer:c.peer}]); sendAll({k:'l',id:c.peer}); };
      c.on('close',gone); c.on('error',gone);
    });
  } else {
    hconn.on('data', d=>onMsg(d,null)); try{ hconn.send({k:'hello',uid:getUid()}); }catch(e){}
    hconn.on('close', ()=>{ if(closed) return; const ids=[...states.keys()]; states.clear(); notify(ids.map(id=>({peer:id}))); cb.end('The host left the party.'); });
  }
  return {
    on:(t,fn)=>{ handlers[t]=fn; },
    emit:(t,d)=>{ out({k:'e',t,d,f:me}); return Promise.resolve(); },
    presence:st=>{ myPres=st; out({k:'p',f:me,s:st}); return Promise.resolve(); },
    onPeers:fn=>{ peersCb=fn; notify(); },
    peers:list,
    setCfg:o=>{ cfg=o; sendAll({k:'cfg',c:o}); },
    kick(id){
      const c=conns.find(x=>x.peer===id); if(!c) return;
      if(c.uid) banned.add(c.uid);
      try{ c.send({k:'kick',why:'You were banned from this party by the host.'}); }catch(e){}
      setTimeout(()=>{ try{c.close();}catch(e){} },300);
    },
    close(){ try{ out({k:'bye'}); }catch(e){} closed=true; const ids=[...states.keys()]; states.clear(); notify(ids.map(id=>({peer:id}))); peersCb=null; conns.forEach(c=>{ try{c.close();}catch(e){} }); try{ peer.destroy(); }catch(e){} }
  };
}
// Public parties: no host. Each public party has 5 fixed slots (webby-pub-<party>-<slot>).
// Claiming a slot's ID is the lock, so a party can never hold more than 5 players.
// Everyone connects to everyone (full mesh). When all 5 slots are taken, the next party number is tried.
const PUB_MAX=10;
function makeMesh(peer,cb){
  const me=peer.id, handlers={}, states=new Map(), conns=[]; let myPres={}, peersCb=null, closed=false;
  const list=()=>[{peer:me,isMe:true,presence:myPres},...[...states].map(([id,st])=>({peer:id,isMe:false,presence:st}))];
  const notify=left=>{ if(peersCb) peersCb({peers:list(),left:left||[]}); cb.count(states.size+1); };
  const out=m=>{ conns.forEach(c=>{ if(c.open) c.send(m); }); };
  function onMsg(m,c){
    if(closed || !m || typeof m!=='object') return;
    if(m.k==='bye'){ drop(c); return; }
    if(m.k==='e'){ const h=handlers[m.t]; if(h) h({isMe:false,peer:c.peer,data:m.d}); }
    else if(m.k==='p'){ states.set(c.peer,m.s); notify(); }
  }
  function drop(c){
    const i=conns.indexOf(c); if(i>=0) conns.splice(i,1);
    try{ c.close(); }catch(e){}
    if(!conns.some(x=>x.peer===c.peer) && states.has(c.peer)){ states.delete(c.peer); notify([{peer:c.peer}]); }
  }
  function add(c){
    if(c.metadata && c.metadata.probe){   // someone is only looking at this server (the server list): tell them who we are, don't treat them as a player
      c.on('open', ()=>{ try{ c.send({k:'whoami',info:partyInfo()}); }catch(e){} });
      return;
    }
    c.on('open', ()=>{
      const init=(c.metadata&&c.metadata.from)||c.peer, keep=me<c.peer?me:c.peer;
      const dup=conns.find(x=>x.peer===c.peer);
      if(dup){
        const dinit=(dup.metadata&&dup.metadata.from)||dup.peer;
        if(init===keep && dinit!==keep){ conns.splice(conns.indexOf(dup),1); try{dup.close();}catch(e){} }
        else { try{c.close();}catch(e){} return; }
      }
      conns.push(c); c.send({k:'p',s:myPres});
      if(c.metadata && c.metadata.from===me) c.send({k:'e',t:'need',d:null}); // newcomer asks each player for the existing builds
    });
    c.on('data', d=>onMsg(d,c));
    const gone=()=>{
      const i=conns.indexOf(c); if(i<0) return;
      conns.splice(i,1);
      if(conns.some(x=>x.peer===c.peer)) return;
      states.delete(c.peer); notify([{peer:c.peer}]);
    };
    c.on('close',gone); c.on('error',gone);
  }
  peer.on('connection', add);
  return {
    on:(t,fn)=>{ handlers[t]=fn; },
    emit:(t,d)=>{ out({k:'e',t,d}); return Promise.resolve(); },
    presence:st=>{ myPres=st; out({k:'p',s:st}); return Promise.resolve(); },
    onPeers:fn=>{ peersCb=fn; notify(); },
    peers:list,
    connectTo:id=>{ if(id!==me) add(peer.connect(id,{reliable:true,metadata:{from:me}})); },
    close(){ try{ out({k:'bye'}); }catch(e){} closed=true; const ids=[...states.keys()]; states.clear(); notify(ids.map(id=>({peer:id}))); peersCb=null; conns.slice().forEach(c=>{ try{c.close();}catch(e){} }); try{ peer.destroy(); }catch(e){} }
  };
}
function claimSlot(id){
  return new Promise((resolve,reject)=>{
    const peer=new Peer(id); let settled=false;
    const to=setTimeout(()=>{ if(settled) return; settled=true; try{ peer.destroy(); }catch(e){} reject({type:'timeout'}); },10000);
    peer.on('open', ()=>{ clearTimeout(to); if(settled) return; settled=true; resolve(peer); });
    peer.on('error', err=>{
      if(settled) return; settled=true; clearTimeout(to);
      try{ peer.destroy(); }catch(e){}
      if(err.type==='unavailable-id') resolve(null); else reject(err);
    });
  });
}
let finding=false;
async function joinPublic(target,gk){
  const pfx=gk ? 'webby-gs-'+gk+'-' : 'webby-pub-';
  if(finding) return 'fail';
  if(party) return 'ok';
  let until=0; try{ until=+localStorage.getItem('webbyBan')||0; }catch(e){}
  if(Date.now()<until){ const sec=Math.ceil((until-Date.now())/1000); setStat('You are banned from public parties for '+Math.floor(sec/60)+':'+String(sec%60).padStart(2,'0')+' more.'); return 'banned'; }
  finding=true; setStat(target ? 'Joining server '+target+'...' : 'Finding a public party...');
  try{
    try{ await loadPeer(); }catch(e){ setStat('Could not load the party service. Check your internet.'); return 'fail'; }
    for(let n=(target||1); n<=(target||30); n++){
      for(let sl=1;sl<=PUB_MAX;sl++){
        let peer;
        try{ peer=await claimSlot(pfx+n+'-'+sl); }
        catch(err){ setStat('Could not reach the party service ('+err.type+').'); return 'fail'; }
        if(!peer) continue;
        const shim=makeMesh(peer,partyCb);
        room=shim; party={peer,shim,pub:n,gk:gk||null}; synced=false; wireRoom();
        partyUI('public'); pp.classList.add('hide'); addChat('Party','Joined '+(gk?'server ':'public party ')+n+'.');
        for(let j=1;j<=PUB_MAX;j++) if(j!==sl) shim.connectTo(pfx+n+'-'+j);
        return 'ok';
      }
    }
    setStat(target ? 'That server is full.' : 'All public parties are full right now. Try again soon.');
    return target ? 'full' : 'fail';
  } finally { finding=false; }
}
function getUid(){
  try{ let u=localStorage.getItem('webbyUid'); if(!u){ u=Math.random().toString(36).slice(2)+Date.now().toString(36); localStorage.setItem('webbyUid',u); } return u; }
  catch(e){ return 'anon-'+Math.random().toString(36).slice(2); }
}
let _hkey='';
function renderHost(){
  if(!party || !party.host) return;
  const ps=party.shim.peers().filter(x=>!x.isMe).map(x=>x.peer), key=ps.map(id=>id+nameOf(id)).join(',');
  if(key===_hkey) return; _hkey=key;
  const box=document.getElementById('hplist'); box.innerHTML='';
  if(!ps.length){ box.textContent='No one else is here yet.'; return; }
  ps.forEach(id=>{
    const row=document.createElement('div'); row.className='hrow';
    const nm=document.createElement('span'); nm.textContent=nameOf(id);
    const b=document.createElement('button'); b.className='sq it'; b.textContent='Ban';
    b.onclick=()=>{ party.shim.kick(id); addChat('Party',nameOf(id)+' was banned.'); };
    row.appendChild(nm); row.appendChild(b); box.appendChild(row);
  });
}
function setEditBtn(){ document.getElementById('hedit').textContent='Others can edit builds: '+(party && party.cfgEdit ? 'ON' : 'OFF'); }
document.getElementById('hedit').onclick=()=>{ if(!party || !party.host) return; party.cfgEdit=!party.cfgEdit; party.shim.setCfg({edit:party.cfgEdit}); setEditBtn(); };
function kickPublic(){
  try{ localStorage.setItem('webbyBan', String(Date.now()+5*60*1000)); }catch(e){}
  if(party){ party.shim.close(); partyEnded('You were removed from the public party for swearing. You can rejoin in 5 minutes.'); }
}
function leaveNow(){ try{ if(party && party.shim) party.shim.close(); }catch(e){} }
addEventListener('pagehide', leaveNow);
addEventListener('beforeunload', leaveNow);
function partyEnded(msg,noRejoin){
  const oldId=myId(); objs.forEach(o=>{ if(o.own===oldId) o.own='local'; }); // keep ownership of my builds after leaving
  devBlocks.forEach(o=>{ if(o.owner===oldId) o.owner='local'; }); devSigns.forEach(o=>{ if(o.owner===oldId) o.owner='local'; });
  if(devCfgs.has(oldId)){ devCfgs.set('local',devCfgs.get(oldId)); devCfgs.delete(oldId); }
  [...devBlocks.keys()].forEach(id=>{ if(devBlocks.get(id).owner!=='local') devRemoveBlock(id); });
  [...devSigns.keys()].forEach(id=>{ if(devSigns.get(id).owner!=='local') devRemoveSign(id); });
  [...devCfgs.keys()].forEach(k=>{ if(k!=='local') devCfgs.delete(k); }); devEffectiveCfg();
  [...remotes.keys()].forEach(id=>{ const r=remotes.get(id); scene.remove(r.c.g); if(r.lbl) r.lbl.remove(); dropBubble(id); });
  remotes.clear();
  rpieces.forEach(o=>scene.remove(o.m)); rpieces=[];
  [...objs.values()].forEach(o=>{ if(o.own!=='local') applyObj({op:'del',id:o.id,force:true}); });
  room=null; party=null; allowEdit=false; synced=false; partyUI('idle'); setStat(msg||''); setCount(''); if(msg) addChat('Party',msg);
  if(!noRejoin && running) setTimeout(()=>{ if(running && !party) joinPublic(); },400);
}
const partyCb={
  count:n=>{ if(party){ setCount(party.pub ? (party.gk?'Server ':'Public party ')+party.pub+' · players: '+n+'/'+PUB_MAX : 'Players in the party: '+n); renderHost(); } },
  end:partyEnded,
  cfg:c=>{ const v=!!(c&&c.edit); if(v!==allowEdit){ allowEdit=v; addChat('Party', v ? 'The host now lets everyone edit all builds.' : 'Builds can only be edited by their owners now.'); } }
};
function startParty(peer,conn,code,isHost){
  if(party){ party.shim.close(); partyEnded('',true); } // switching from the public party
  const shim=makeShim(peer,isHost,conn,partyCb);
  allowEdit=false; _hkey=''; room=shim; party={peer,shim,host:isHost,cfgEdit:false,code:code}; synced=false; wireRoom(); if(isHost) setEditBtn();
  partyUI(isHost?'host':'client');
  if(isHost){ document.getElementById('pcv').textContent=code; addChat('Party','Hosting! Code: '+code); }
  else { pp.classList.add('hide'); addChat('Party','Joined the party!'); }
}
function newCode(){ const a='ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; let c=''; for(let i=0;i<5;i++) c+=a[Math.floor(Math.random()*a.length)]; return c; }
async function hostParty(){
  setStat('Starting party...');
  try{ await loadPeer(); }catch(e){ setStat('Could not load the party service. Check your internet.'); return; }
  const attempt=n=>{
    const code=newCode(), peer=new Peer('webby-'+code); let opened=false;
    peer.on('open', ()=>{ opened=true; startParty(peer,null,code,true); });
    peer.on('error', err=>{
      if(opened) return;
      if(err.type==='unavailable-id' && n<5) attempt(n+1); else setStat('Could not start the party ('+err.type+').');
    });
  };
  attempt(0);
}
function joinPrivate(code){
  return new Promise(async resolve=>{
    try{ await loadPeer(); }catch(e){ setStat('Could not load the party service. Check your internet.'); resolve('fail'); return; }
    const peer=new Peer(); let done=false, to=null;
    const fail=m=>{ if(done) return; done=true; clearTimeout(to); try{ peer.destroy(); }catch(e){} setStat(m); resolve('fail'); };
    peer.on('error', err=>fail(err.type==='peer-unavailable' ? 'No party found with that code.' : 'Could not join ('+err.type+').'));
    peer.on('open', ()=>{
      const c=peer.connect('webby-'+code,{reliable:true});
      to=setTimeout(()=>fail('Could not connect. The host may be offline, or your network blocks this.'),12000);
      c.on('open', ()=>{ if(done) return; done=true; clearTimeout(to); startParty(peer,c,code,false); resolve('ok'); });
      c.on('error', ()=>fail('Connection failed.'));
    });
  });
}
async function joinParty(){
  const code=pcode.value.trim().toUpperCase().replace(/[^A-Z0-9]/g,'');
  if(code.length<4){ setStat('Paste the code first.'); return; }
  setStat('Joining...');
  await joinPrivate(code);
}
document.getElementById('ph').onclick=hostParty;
document.getElementById('pj').onclick=()=>{ pshow('pjoin',true); pcode.focus(); };
document.getElementById('pgo').onclick=joinParty;
document.getElementById('pcopy').onclick=()=>{
  const c=document.getElementById('pcv').textContent;
  (navigator.clipboard ? navigator.clipboard.writeText(c) : Promise.reject()).then(()=>setStat('Code copied!')).catch(()=>setStat('Select the code and copy it.'));
};
document.getElementById('pleave').onclick=()=>{
  if(!party) return;
  party.shim.close(); partyEnded('You left the party.');
};
pcode.addEventListener('focus', ()=>Object.keys(keys).forEach(k=>keys[k]=false));
pcode.addEventListener('keydown', e=>{ e.stopPropagation(); if(e.key==='Enter') joinParty(); });
pcode.addEventListener('keyup', e=>e.stopPropagation());

// ---------- Shift lock ----------
let lockExitByUs=false;
function releaseLock(){ if(document.pointerLockElement){ lockExitByUs=true; document.exitPointerLock(); } }
function toggleLock(){
  const cvs=renderer.domElement;
  if(document.pointerLockElement===cvs) releaseLock();
  else if(!typing && cvs.requestPointerLock) cvs.requestPointerLock();
}
document.addEventListener('pointerlockchange', ()=>{
  const was=shiftLock;
  shiftLock = document.pointerLockElement===renderer.domElement;
  document.getElementById('xh').classList.toggle('hide', !shiftLock);
  if(shiftLock){ dragging=false; lockExitByUs=false; }
  else if(was){ if(!lockExitByUs && running) openTM(); lockExitByUs=false; } // Esc freed the mouse: show the menu
});
document.addEventListener('mousemove', e=>{
  if(!shiftLock) return;
  camYaw -= e.movementX*0.004*SET.sens;
  camPitch = Math.max(0.1, Math.min(1.35, camPitch + e.movementY*0.004*SET.sens*(SET.inv?-1:1)));
});

const spawnPos=new THREE.Vector3(0,0,0);

// ---------- State ----------
const p = new THREE.Vector3(0,0,0), v = new THREE.Vector3();
const HW = 0.5, H = 3.1;
let customMode=false, GRAV=30, SPEED=8, JUMPV=12, shiftLock=false, lockOff=0, hp=100, hurtT=0, shieldT=0, dancing=false, animState=0, onGround=false, running=false, dead=false, deathTimer=0, climbing=false, climbCool=0, climbPhase=0, t=0, facing=0;
const keys = {};
addEventListener('keydown', e=>{ const tg=e.target; if(tg && (tg.tagName==='INPUT'||tg.tagName==='TEXTAREA'||tg.tagName==='SELECT')) return; keys[e.code]=true; if(e.code==='Space'||e.code.startsWith('Arrow')) e.preventDefault(); });
addEventListener('keyup', e=>{ keys[e.code]=false; });
// ---------- Homepage ----------
const home=document.getElementById('home'), hplay=document.getElementById('hplay'), hstat=document.getElementById('hstat');
function thumbHTML(){
  const b=(l,bt,w,h,c)=>'<div style="left:'+l+'em;bottom:'+bt+'em;width:'+w+'em;height:'+h+'em;background:'+c+'"></div>';
  return b(0,0,22,4,'#4caf50')+b(0,3.6,22,0.4,'#66bb6a')
    +b(13.5,4,2,1,'#9e9e9e')+b(15.5,4,2,2,'#9e9e9e')+b(17.5,4,2,3,'#9e9e9e')+b(19.5,4,2.5,4,'#9e9e9e')
    +b(2,4,3.2,1.4,'#ff6d00')+b(6,4,3,1.2,'#c62828')
    +b(10.2,4,0.9,1.6,'#7a9a2a')+b(11.2,4,0.9,1.6,'#7a9a2a')+b(10,5.6,2.2,2,'#1b5fa8')
    +b(9.2,5.6,0.8,2,'#e8c92b')+b(12.2,5.6,0.8,2,'#e8c92b')+b(10.3,7.7,1.6,1.4,'#e8c92b');
}
document.querySelectorAll('.thumb, .icoin').forEach(t=>{ t.innerHTML=thumbHTML(); });
const SKINS=[0xe8c92b,0xffe0bd,0xf1c27d,0xc68642,0x8d5524,0x5c3a21,0x7cc65a,0x4aa3ff,0xe0524d,0xf48fb1,0x9c6bd6,0xffa24a,0xbdbdbd,0xf5f5f5,0x2b2b2b];
const hex6=n=>'#'+n.toString(16).padStart(6,'0');
function avatarHTML(sk,hat,face){
  const b=(l,bt,w,h,c,rot)=>'<div style="left:'+l+'em;bottom:'+bt+'em;width:'+w+'em;height:'+h+'em;background:'+c+(rot?';transform:rotate('+rot+'deg)':'')+'"></div>';
  const D='#1a1a1a';
  let o=b(4.6,0,2.4,4,'#7a9a2a')+b(7,0,2.4,4,'#7a9a2a')+b(4.6,4,4.8,4.8,'#1b5fa8')+b(2.6,4,2,4.8,sk)+b(9.4,4,2,4.8,sk)+b(5.2,8.8,3.6,3.2,sk);
  if(face===1) o+=b(5.9,10.9,.45,.6,D)+b(7.65,10.9,.45,.6,D)+b(6.1,9.45,1.8,.25,D)+b(5.9,9.7,.25,.35,D)+b(8.05,9.7,.25,.35,D);
  else if(face===2) o+=b(5.9,10.4,.45,.45,D)+b(7.65,10.4,.45,.45,D)+b(5.7,11.2,1.1,.25,D,20)+b(7.2,11.2,1.1,.25,D,-20)+b(6.2,9.3,1.6,.25,D)+b(6.0,8.95,.25,.4,D)+b(7.95,8.95,.25,.4,D);
  else if(face===3) o+=b(5.9,10.7,.5,.9,D)+b(7.6,10.7,.5,.9,D)+b(5.8,11.8,.9,.2,D)+b(7.5,11.8,.9,.2,D)+b(6.65,9.2,.7,1,D);
  if(hat===1) o+=b(5.0,12,4,1,'#212121')+b(3.4,12.7,7.2,.5,'#212121')+b(4.3,13.1,5.4,.9,'#212121')+b(3.4,12.9,7.2,.2,'#ffca28')+b(6.5,13.2,.8,.6,'#fff')+b(6.65,13.5,.15,.18,'#212121')+b(7.0,13.5,.15,.18,'#212121');
  else if(hat===2) o+=b(4.9,12,4.2,1.2,'#d32f2f')+b(5.1,11.55,3.8,.35,'#b71c1c')+b(6.9,13.2,.4,.25,'#b71c1c');
  else if(hat===3) o+=b(3.2,12,7.6,.35,'#6d4c41')+b(5.3,12.35,3.4,1.5,'#6d4c41')+b(5.2,12.45,3.6,.4,'#3e2723');
  return o;
}
const swBox=document.getElementById('swatches'), skinpick=document.getElementById('skinpick'), hatBox=document.getElementById('hatopts'), faceBox=document.getElementById('faceopts');
function renderAvatar(){
  document.getElementById('avbox').innerHTML=avatarHTML(hex6(mySkin),myHat,myFace);
  document.getElementById('avname').textContent=myName;
  document.getElementById('whon').textContent=myName;
  document.getElementById('whoin').innerHTML=avatarHTML(hex6(mySkin),myHat,myFace);
  skinpick.value=hex6(mySkin);
  [...swBox.children].forEach((b,i)=>b.classList.toggle('on', SKINS[i]===mySkin));
  [...hatBox.children].forEach((b,i)=>b.classList.toggle('on', i===myHat));
  [...faceBox.children].forEach((b,i)=>b.classList.toggle('on', i===myFace));
}
function setMySkin(hex){ mySkin=hex; profile.skin=hex; saveProfile(); setSkin(player,hex); renderAvatar(); }
SKINS.forEach(c=>{ const b=document.createElement('button'); b.className='sw'; b.style.background=hex6(c); b.title=hex6(c); b.onclick=()=>setMySkin(c); swBox.appendChild(b); });
skinpick.addEventListener('input', ()=>setMySkin(parseInt(skinpick.value.slice(1),16)));
function showTab(t){
  document.getElementById('viewHome').classList.toggle('hide',t!=='home');
  document.getElementById('viewAvatar').classList.toggle('hide',t!=='avatar');
  document.getElementById('viewProfile').classList.toggle('hide',t!=='profile');
  document.getElementById('tabHome').classList.toggle('on',t==='home');
  document.getElementById('tabAvatar').classList.toggle('on',t==='avatar');
  document.getElementById('viewFind').classList.toggle('hide',t!=='find');
  document.getElementById('viewCreate').classList.toggle('hide',t!=='create');
  document.getElementById('tabCreate').classList.toggle('on',t==='create');
  if(t==='create'){ renderCreate(); renderWarnings(); }
  document.getElementById('viewSettings').classList.toggle('hide',t!=='settings');
  document.getElementById('tabSettings').classList.toggle('on',t==='settings');
  if(t==='settings') syncHomeSettings();
  document.getElementById('viewMod').classList.toggle('hide',t!=='mod');
  document.getElementById('tabMod').classList.toggle('on',t==='mod');
  if(t==='mod') renderMod();
  if(t==='home'){ renderCommunity(); if(acct) syncCatalog(); }
  document.getElementById('tabFind').classList.toggle('on',t==='find');
  if(t==='home' || t==='find') tickSoon();
  if(t==='find') renderFindResult();
  if(t==='profile'){ aboutMode(false); document.getElementById('aboutNote').textContent=''; renderProfile(); }
}
document.getElementById('tabHome').onclick=()=>showTab('home');
document.getElementById('tabAvatar').onclick=()=>showTab('avatar');
document.getElementById('tabFind').onclick=()=>showTab('find');
function setMyLook(h,f){
  if(h!==undefined) myHat=h;
  if(f!==undefined) myFace=f;
  profile.hat=myHat; profile.face=myFace; saveProfile(); setLook(myChar,myHat,myFace); renderAvatar();
}
['None','Pirate hat','Baseball cap','Fedora'].forEach((n,i)=>{ const b=document.createElement('button'); b.className='opt'; b.textContent=n; b.onclick=()=>setMyLook(i,undefined); hatBox.appendChild(b); });
['None','Smiley','Angry','Surprised'].forEach((n,i)=>{ const b=document.createElement('button'); b.className='opt'; b.textContent=n; b.onclick=()=>setMyLook(undefined,i); faceBox.appendChild(b); });
renderAvatar();

// ---- Party servers menu: tabs + Player infos (everyone in the lobby with their avatar, face and name) ----
let pTab='party', _pkey='';
function showPTab(t){
  pTab=t;
  document.getElementById('ptabParty').classList.toggle('hide',t!=='party');
  document.getElementById('ptabInfo').classList.toggle('hide',t!=='info');
  document.getElementById('ptParty').classList.toggle('on',t==='party');
  document.getElementById('ptInfo').classList.toggle('on',t==='info');
  if(t==='info'){ _pkey=''; renderPlayers(); }
}
document.getElementById('ptParty').onclick=()=>showPTab('party');
document.getElementById('ptInfo').onclick=()=>showPTab('info');
function renderPlayers(){
  const list=[{name:myName+' (you)',skin:mySkin,hat:myHat,face:myFace,n:null}];
  remotes.forEach((r,id)=>{ const nm=r.name||tagOf(id); list.push({name:nm, skin:(r.skin===undefined?Y:r.skin), hat:r.c.hat|0, face:r.c.face|0, n:uidOf(nm)}); });
  const key=list.map(x=>[x.name,x.skin,x.hat,x.face,!x.n?'':friendState(x.n)].join('|')).join(';')+'#'+profile.incoming.join(',')+(userPeer?1:0);
  if(key===_pkey) return; _pkey=key;
  const box=document.getElementById('plist'); box.innerHTML='';
  if(profile.incoming.length){
    const rq=document.createElement('div'); rq.className='pd'; rq.style.marginBottom='8px'; rq.textContent='Friend requests'; box.appendChild(rq);
    profile.incoming.forEach(n=>{
      const row=document.createElement('div'); row.className='prow'; row.style.flexWrap='wrap';
      row.innerHTML='<div class="pname" style="flex:1"></div><button class="sq it" style="padding:4px 8px;font-size:12px">Accept</button><button class="sq it" style="padding:4px 8px;font-size:12px">Decline</button>';
      row.querySelector('.pname').textContent=dispName(n);
      const bs=row.querySelectorAll('button'); bs[0].onclick=()=>acceptFriend(n); bs[1].onclick=()=>declineFriend(n);
      box.appendChild(row);
    });
  }
  const head=document.createElement('div'); head.className='pd'; head.style.marginBottom='8px';
  head.textContent='Players in this lobby: '+list.length; box.appendChild(head);
  list.forEach(x=>{
    const inner=avatarHTML(hex6(x.skin),x.hat,x.face);
    const row=document.createElement('div'); row.className='prow';
    row.innerHTML='<div class="pav">'+inner+'</div><div><div class="pface"><div class="pfin">'+inner+'</div></div><div class="pname"></div></div>';
    row.querySelector('.pname').textContent=x.name;
    if(x.n && acct && x.n!==acct.uid){ const op=()=>openProfile(x.n,{name:x.name,skin:x.skin,hat:x.hat,face:x.face}); ['.pav','.pface','.pname'].forEach(sel=>{ const e=row.querySelector(sel); e.style.cursor='pointer'; e.onclick=op; }); }
    if(x.n && acct && x.n!==acct.uid){
      const st=friendState(x.n), bt=document.createElement('button');
      bt.className='sq it'; bt.style.cssText='margin-top:6px;padding:4px 8px;font-size:12px';
      if(st==='f'){ bt.textContent='Friends'; bt.disabled=true; }
      else if(st==='o'){ bt.textContent='Request sent'; bt.disabled=true; }
      else if(st==='i'){ bt.textContent='Accept'; bt.onclick=()=>acceptFriend(x.n); }
      else { bt.textContent='Add friend'; bt.onclick=()=>{ if(!userPeer){ addChat('Friends',socialMsg()); return; } sendRequest(x.n); }; }
      row.lastElementChild.appendChild(bt);
    }
    box.appendChild(row);
  });
}
setInterval(()=>{ if(pTab==='info' && !pp.classList.contains('hide')) renderPlayers(); },400);
// ---- Profile page (opened by clicking your name at the top right) ----
const aboutView=document.getElementById('aboutView'), aboutTxt=document.getElementById('aboutTxt');
function ago(t){
  const m=Math.floor((Date.now()-t)/60000);
  if(m<1) return 'just now';
  if(m<60) return m+' minute'+(m===1?'':'s')+' ago';
  const h=Math.floor(m/60); if(h<24) return h+' hour'+(h===1?'':'s')+' ago';
  const d=Math.floor(h/24); return d+' day'+(d===1?'':'s')+' ago';
}
function renderProfile(){
  const av=avatarHTML(hex6(mySkin),myHat,myFace);
  document.getElementById('pfheadin').innerHTML=av;
  document.getElementById('pfname').textContent=myName;
  const empty=!profile.about;
  aboutView.textContent=empty ? "You haven't written anything about yourself yet." : profile.about;
  aboutView.classList.toggle('empty',empty);
  const rb=document.getElementById('recentBox'); rb.innerHTML='';
  if(!profile.recent.length) rb.textContent="You haven't played any games yet.";
  profile.recent.forEach(g=>rb.appendChild(recentRow(g)));
  document.getElementById('pwbox').innerHTML=av;
  document.getElementById('pwskin').style.background=hex6(mySkin);
  document.getElementById('pwhat').textContent=['None','Pirate hat','Baseball cap','Fedora'][myHat];
  document.getElementById('pwface').textContent=['None','Smiley','Angry','Surprised'][myFace];
}
function aboutMode(edit){
  aboutView.classList.toggle('hide',edit); aboutTxt.classList.toggle('hide',!edit);
  document.getElementById('aboutEdit').classList.toggle('hide',edit);
  document.getElementById('aboutSave').classList.toggle('hide',!edit);
  document.getElementById('aboutCancel').classList.toggle('hide',!edit);
}
document.getElementById('aboutEdit').onclick=()=>{ aboutTxt.value=profile.about; aboutMode(true); document.getElementById('aboutNote').textContent=''; aboutTxt.focus(); };
document.getElementById('aboutCancel').onclick=()=>aboutMode(false);
document.getElementById('aboutSave').onclick=()=>{
  const r=censor(aboutTxt.value.slice(0,300));          // swear words become ####
  profile.about=r.text; saveProfile(); aboutMode(false); renderProfile();
  document.getElementById('aboutNote').textContent = r.count ? 'Saved. Some words were censored.' : 'Saved!';
};
document.getElementById('pwchange').onclick=()=>showTab('avatar');
document.querySelector('.who').onclick=()=>showTab('profile');
function recordPlayed(name,x){
  x=x||{}; const k=x.k||'';
  profile.recent=profile.recent.filter(g=>!(g.n===name && (g.k||'')===k));
  profile.recent.unshift(cleanRecent({n:name,t:Date.now(),by:x.by||'',k:k||undefined}));
  profile.recent=profile.recent.slice(0,5); saveProfile();
}
function showHud(on){ ['bar','hp','pb','help','devBtn'].forEach(id=>document.getElementById(id).classList.toggle('hide',!on)); if(!on) document.getElementById('devtools').classList.add('hide'); }
showHud(false);
function enterGame(){ home.classList.add('hide'); showHud(true); running=true; recordPlayed('Testing place',{by:'Zino'}); }
let joining=false, playing=false, playingName='';
// Only one client per player: a heartbeat in shared browser storage tells other Webby windows that this one is playing
const clientId=Math.random().toString(36).slice(2)+Date.now().toString(36);
function activeOther(){ try{ const a=JSON.parse(localStorage.getItem('webbyActive:'+(acct?acct.uid:''))||'null'); return !!a && a.id!==clientId && Date.now()-a.t<4000; }catch(e){ return false; } }
function claimActive(){ try{ localStorage.setItem('webbyActive:'+(acct?acct.uid:''), JSON.stringify({id:clientId,t:Date.now()})); }catch(e){} }
function releaseActive(){ try{ const a=JSON.parse(localStorage.getItem('webbyActive:'+(acct?acct.uid:''))||'null'); if(a && a.id===clientId) localStorage.removeItem('webbyActive:'+(acct?acct.uid:'')); }catch(e){} }
setInterval(()=>{ if(playing) claimActive(); },1000);
addEventListener('pagehide', releaseActive);
addEventListener('beforeunload', releaseActive);
function showDlg(msg){ document.querySelector('#dlg .dmsg').textContent = msg || 'You already have one player client playing, please move to that client.'; document.getElementById('dlg').classList.remove('hide'); }
document.getElementById('dok').onclick=()=>document.getElementById('dlg').classList.add('hide');
async function playGame(opts){
  if(joining) return;
  joining=true;
  if(activeOther()){ joining=false; showDlg(); return; }
  claimActive();
  await new Promise(r=>setTimeout(r,150));   // if another window claimed at the same moment, the later one wins
  if(activeOther()){ joining=false; showDlg(); return; }
  playing=true; hplay.disabled=true;
  const ld=document.getElementById('loading'), lstat=document.getElementById('lstat');
  lstat.textContent='Joining server...'; ld.classList.remove('hide');
  const t0=performance.now();
  const iv=setInterval(()=>{ lstat.textContent=document.getElementById('pstat').textContent||'Joining server...'; },300);
  let res='fail';
  try{ res = (opts && opts.code) ? await joinPrivate(opts.code) : await joinPublic(opts && opts.pub); }catch(e){}
  clearInterval(iv); lstat.textContent='Entering the server...';
  const wait=Math.max(0, 2800-(performance.now()-t0));   // show the loading screen for at least ~3 seconds
  await new Promise(r=>setTimeout(r,wait));
  ld.classList.add('hide'); joining=false; hplay.disabled=false; hstat.textContent='';
  if(opts && res!=='ok'){      // joining a chosen server failed: stay on the homepage
    playing=false; releaseActive();
    showDlg(res==='full' ? 'That server is full.' : res==='banned' ? document.getElementById('pstat').textContent : 'Could not join that server. It may have closed.');
    return;
  }
  if(res==='banned') addChat('Party', document.getElementById('pstat').textContent+' You can still host or join a party from the smiley button.');
  else if(res!=='ok') addChat('Party','Could not join a public party, so you are playing alone. Use the smiley button to host or join a party.');
  enterGame();
}
hplay.onclick=()=>playGame();
function goHome(){
  running=false; playing=false; releaseActive();
  releaseLock();
  if(typing) closeChat();
  if(party){ party.shim.close(); partyEnded('',true); }
  [...objs.values()].forEach(o=>applyObj({op:'del',id:o.id,force:true}));
  grabbed=null; toolOn=false; wp.classList.add('hide'); slot1.classList.remove('on');
  rpieces.forEach(o=>scene.remove(o.m)); rpieces=[];
  pieces.forEach(o=>scene.remove(o.m)); pieces=[];
  p.set(0,0,0); v.set(0,0,0); dead=false; deathTimer=0; body.visible=true; setHp(100);
  shieldT=0; hurtT=0; climbing=false; dancing=false; camYaw=0; camPitch=0.6; camDist=16;
  clog.innerHTML=''; pp.classList.add('hide'); setStat(''); setCount('');
  devWipeAll(); document.getElementById('devtools').classList.add('hide'); showHud(false); showTab('home'); showPTab('party'); home.classList.remove('hide'); hstat.textContent='';
}
document.getElementById('pgame').onclick=goHome;
document.getElementById('preset').onclick=()=>{ pp.classList.add('hide'); if(running && !dead) die(); };

// ---------- Social: Find Players + friends ----------
// Your username is your identity. Every open Webby registers "webby-user-<username>" with the free PeerJS service so other
// players can look it up and talk to it. There is no server of our own, so players can only be found live, and friend
// requests are delivered, while both Webbys are open.
const USER='webby-user-';
let userPeer=null, userMsg='Connecting...', userBusy=false, findU=null, findInfo=null, findLive=false, lastTick=0, pv=null;
const fstat=new Map(), waiters=new Map();
const uidFromPeer=id=>{ const m=/^webby-user-([A-Za-z0-9_]+)$/.exec(String(id)); return m?uidOf(m[1]):null; };
const isFriend=u=>profile.friends.includes(u);
function friendState(u){ return isFriend(u)?'f':profile.incoming.includes(u)?'i':profile.outgoing.includes(u)?'o':'n'; }
function dispName(u){ const c=profile.fcache[u]||profile.met[u]; return (c && c.name) ? censor(c.name).text : u; }
function socialMsg(){
  return userMsg==='other' ? 'Friends are running in your other Webby window.'
       : userMsg==='taken' ? 'This account is already online on another computer, so friends are switched off here.'
       : userMsg==='offline' ? 'Could not connect to the friends service. Check your internet.'
       : 'Connecting to the friends service...';
}
function cleanJoin(j){
  if(!j || typeof j!=='object') return null;
  if(Number.isInteger(j.pub) && j.pub>=1 && j.pub<=30) return {pub:j.pub};
  if(typeof j.code==='string' && /^[A-Z0-9]{4,8}$/.test(j.code)) return {code:j.code};
  return null;
}
function cleanInfo(i){
  if(!i || typeof i!=='object') return null;
  const ok=(v,a,b)=>Number.isInteger(v) && v>=a && v<=b;
  return {name:String(i.name||'').slice(0,24), skin:ok(i.skin,0,0xffffff)?i.skin:Y, hat:ok(i.hat,0,3)?i.hat:0, face:ok(i.face,0,3)?i.face:0,
          playing:typeof i.playing==='string'?i.playing.slice(0,40):null, lobby:typeof i.lobby==='string'?i.lobby.slice(0,40):null, join:cleanJoin(i.join)};
}
// friends (and only friends) also get told which server this player is in, so they can join it
function myInfo(forFriend){
  return {name:myName, skin:mySkin, hat:myHat, face:myFace, playing:playing?(playingName||'Testing place'):null,
          lobby:party?(party.gk?'Server '+party.pub:party.pub?'Public party '+party.pub:(party.host?'Hosting a party':'In a party')):null,
          join:(forFriend && party && !party.gk) ? (party.pub ? {pub:party.pub} : (party.code ? {code:party.code} : null)) : null};
}
function partyInfo(){ return {name:myName, skin:mySkin, hat:myHat, face:myFace}; }
function metSeen(u,i,extra){
  const o=profile.met[u];
  const same=o && o.name===i.name && o.skin===i.skin && o.hat===i.hat && o.face===i.face;
  if(same && !extra) return;
  const n={name:String(i.name).slice(0,24), skin:i.skin, hat:i.hat, face:i.face, t:Date.now()};
  if(extra){ n.about=extra.about; n.recent=extra.recent; }
  else if(o){ if(o.about!==undefined) n.about=o.about; if(o.recent) n.recent=o.recent; }
  profile.met[u]=n;
  const ks=Object.keys(profile.met);
  if(ks.length>100){ ks.sort((a,b)=>profile.met[a].t-profile.met[b].t); delete profile.met[ks[0]]; }
  saveProfile();
}
// send one message to another address and wait (up to 6s) for the answer; null = not reachable
function askRaw(pe,id,msg,meta,accept){
  return new Promise(resolve=>{
    if(!pe || !pe.open){ resolve(null); return; }
    let done=false, c=null;
    const cb=()=>fin(null);
    const to=setTimeout(()=>fin(null),6000);
    function fin(v){
      if(done) return; done=true; clearTimeout(to);
      waiters.set(id,(waiters.get(id)||[]).filter(f=>f!==cb));
      try{ if(c) c.close(); }catch(e){}
      resolve(v);
    }
    waiters.set(id,(waiters.get(id)||[]).concat(cb));
    try{ c=pe.connect(id,{reliable:true,metadata:meta}); }catch(e){ fin(null); return; }
    c.on('open',()=>{ if(msg) c.send(msg); });
    c.on('data',d=>{ if(!accept || accept(d)) fin(d); });
    c.on('error',()=>fin(null)); c.on('close',()=>fin(null));
  });
}
function ask(u,msg){ return askRaw(userPeer,USER+u,msg); }
function onPeerErr(err){ const m=/webby-[A-Za-z0-9_-]+/.exec(err.message||''); if(m) (waiters.get(m[0])||[]).slice().forEach(f=>f()); }
function addFriend(u){
  profile.outgoing=profile.outgoing.filter(x=>x!==u); profile.incoming=profile.incoming.filter(x=>x!==u); profile.declined=profile.declined.filter(x=>x!==u);
  if(!isFriend(u) && profile.friends.length<50){ profile.friends.push(u); addChat('Friends','You and '+dispName(u)+' are now friends!'); }
  saveProfile(); renderSocial();
}
function removeFriendLocal(u){ profile.friends=profile.friends.filter(x=>x!==u); delete profile.fcache[u]; fstat.delete(u); saveProfile(); renderSocial(); }
function removeFriend(u){ removeFriendLocal(u); ask(u,{t:'remove'}); }
function acceptFriend(u){ addFriend(u); ask(u,{t:'accept'}); }
function declineFriend(u){ profile.incoming=profile.incoming.filter(x=>x!==u); if(!profile.declined.includes(u)) profile.declined.push(u); saveProfile(); renderSocial(); }
async function sendRequest(u){
  if(!acct || u===acct.uid || isFriend(u)) return 'friend';
  if(profile.incoming.includes(u)){ acceptFriend(u); return 'accepted'; }
  if(!profile.outgoing.includes(u) && profile.outgoing.length<30){ profile.outgoing.push(u); profile.declined=profile.declined.filter(x=>x!==u); saveProfile(); renderSocial(); }
  const r=await ask(u,{t:'req',name:myName});
  if(r && r.t==='accept'){ addFriend(u); return 'accepted'; }
  if(r && r.t==='decline'){ profile.outgoing=profile.outgoing.filter(x=>x!==u); saveProfile(); renderSocial(); return 'declined'; }
  return r ? 'sent' : 'queued';
}
// what other players ask us
function handleUser(m,c){
  if(!acct || !m || typeof m!=='object') return;
  const u=uidFromPeer(c.peer); if(!u || u===acct.uid) return;
  if(m.t==='info'){ c.send({t:'info', info:myInfo(isFriend(u)), fr:isFriend(u), pd:profile.outgoing.includes(u)}); }
  else if(m.t==='req'){
    if(typeof m.name==='string' && !profile.met[u] && !profile.fcache[u]) metSeen(u,{name:m.name.slice(0,24),skin:Y,hat:0,face:0});
    if(isFriend(u)) c.send({t:'accept'});
    else if(profile.declined.includes(u)) c.send({t:'decline'});
    else if(profile.outgoing.includes(u)){ addFriend(u); c.send({t:'accept'}); }
    else {
      if(!profile.incoming.includes(u) && profile.incoming.length<30){ profile.incoming.push(u); saveProfile(); addChat('Friends',dispName(u)+' sent you a friend request.'); renderSocial(); }
      c.send({t:'ack'});
    }
  }
  else if(m.t==='profile'){ c.send({t:'profile', info:myInfo(isFriend(u)), about:profile.about, recent:profile.recent.slice(0,5)}); }
  else if(m.t==='report'){   // only the moderator account keeps reports
    if(isMod()){ addInbox(m,u); c.send({t:'repAck'}); }
  }
  else if(m.t==='warn'){     // only the moderator can warn (the sender is the real moderator peer)
    if(u===MOD_UID && typeof m.text==='string'){ addWarning({text:m.text,game:m.gn,kind:'warning'}); c.send({t:'warnAck'}); }
  }
  else if(m.t==='game'){
    const g=profile.games.find(q=>q.id===m.id);
    if(!g || !g.pub || g.lang!=='lua'){ c.send({t:'game',ok:false,why:'gone'}); return; }
    const ok=g.pub.vis==='public' || u===MOD_UID || (g.pub.vis==='whitelist' && g.pub.al.includes(u));
    c.send(ok ? {t:'game',ok:true,lang:'lua',code:g.code} : {t:'game',ok:false,why:'denied'});
  }
  else if(m.t==='accept'){ if(profile.outgoing.includes(u)) addFriend(u); c.send({t:'ack'}); }
  else if(m.t==='remove'){ if(isFriend(u)) removeFriendLocal(u); c.send({t:'ack'}); }
}
// every 20 seconds: deliver waiting requests and check what friends are doing
async function socialTick(){
  lastTick=Date.now();
  if(!acct || !userPeer || !userPeer.open) return;
  const jobs=[];
  profile.outgoing.slice().forEach(u=>jobs.push(sendRequest(u)));
  jobs.push(flushOut());
  profile.friends.slice().forEach(u=>jobs.push(ask(u,{t:'info'}).then(r=>{
    if(r && r.t==='info'){
      const info=cleanInfo(r.info);
      if(info){ fstat.set(u,{online:true,info}); profile.fcache[u]={name:info.name,skin:info.skin,hat:info.hat,face:info.face,t:Date.now()}; if(r.fr===false && r.pd!==true) removeFriendLocal(u); }
    } else fstat.set(u,{online:false});
  })));
  await Promise.all(jobs); saveProfile(); renderSocial();
}
function tickSoon(){ if(Date.now()-lastTick>4000) socialTick(); }
// ----- screens -----
function statusText(info){ return info.playing ? 'Playing '+info.playing+(info.lobby?' \u00b7 '+info.lobby:'') : 'Online \u00b7 On the homepage'; }
function renderFriends(){
  const box=document.getElementById('friendsBox'); box.innerHTML='';
  if(!acct){ return; }
  if(!userPeer || !userPeer.open){ const nt=document.createElement('div'); nt.className='fnote'; nt.textContent=socialMsg()+' Friend statuses may be out of date.'; box.appendChild(nt); }
  if(!profile.friends.length){ const e=document.createElement('div'); e.textContent='No friends yet. Use the Find Players tab to add some!'; box.appendChild(e); return; }
  const rows=profile.friends.map(u=>({u, st:fstat.get(u)||{online:false}, c:profile.fcache[u]||profile.met[u]||null}));
  rows.sort((a,b)=>(b.st.online?1:0)-(a.st.online?1:0) || a.u.localeCompare(b.u));
  rows.forEach(({u,st,c})=>{
    const info=st.online ? st.info : c;
    const row=document.createElement('div'); row.className='frow';
    row.innerHTML='<div class="pface"><div class="pfin">'+(info?avatarHTML(hex6(info.skin),info.hat,info.face):'')+'</div></div><div class="fgrow"><div class="fname"></div><div class="fstat"></div></div><button class="oplay small fjoin hide">JOIN</button><button class="opt fremove">Remove</button>';
    row.querySelector('.fname').textContent=(info && info.name) ? censor(info.name).text : u;
    const fs=row.querySelector('.fstat'); fs.innerHTML='<span class="dot'+(st.online?' on':'')+'"></span>';
    fs.appendChild(document.createTextNode(st.online ? statusText(st.info) : 'Offline'));
    row.querySelector('.fremove').onclick=()=>removeFriend(u);
    { const op=()=>openProfile(u,info); row.querySelector('.pface').onclick=op; row.querySelector('.fname').onclick=op; }
    if(st.online && st.info.join){ const jb=row.querySelector('.fjoin'); jb.classList.remove('hide'); jb.onclick=()=>playGame(st.info.join.pub ? {pub:st.info.join.pub} : {code:st.info.join.code}); }
    box.appendChild(row);
  });
}
function fillReqs(box){
  box.innerHTML='';
  if(!profile.incoming.length){ box.textContent='No friend requests right now.'; return; }
  profile.incoming.forEach(u=>{
    const row=document.createElement('div'); row.className='frow';
    row.innerHTML='<div class="fgrow"><div class="fname"></div><div class="fstat">wants to be your friend</div></div><button class="oplay small">ACCEPT</button><button class="opt">Decline</button>';
    row.querySelector('.fname').textContent=dispName(u);
    row.querySelector('.fname').onclick=()=>openProfile(u);
    const bs=row.querySelectorAll('button'); bs[0].onclick=()=>acceptFriend(u); bs[1].onclick=()=>declineFriend(u);
    box.appendChild(row);
  });
}
function renderReqs(){
  fillReqs(document.getElementById('reqBox')); fillReqs(document.getElementById('reqBox2'));
  document.getElementById('reqWrap').classList.toggle('hide',!profile.incoming.length);
}
async function doFind(){
  const note=document.getElementById('findNote'); document.getElementById('findRes').innerHTML=''; findU=null;
  const u=uidOf(document.getElementById('findIn').value);
  if(!u){ note.textContent='Type a username (3 to 16 letters, numbers or underscores).'; return; }
  if(acct && u===acct.uid){ note.textContent="That's you!"; return; }
  note.textContent='Searching...';
  let info=null;
  if(userPeer && userPeer.open){ const r=await ask(u,{t:'info'}); if(r && r.t==='info') info=cleanInfo(r.info); }
  findLive=!!info;
  if(info){ metSeen(u,info); note.textContent=''; }
  else {
    const c=profile.fcache[u] || profile.met[u];
    info = c ? {name:c.name,skin:c.skin,hat:c.hat,face:c.face,playing:null,lobby:null,join:null} : {name:u,skin:Y,hat:0,face:0,playing:null,lobby:null,join:null};
    note.textContent = (c ? info.name+' is offline right now. ' : u+" is offline, so we can't see if that account exists yet. ")+'You can still send a friend request. It is delivered when they are online.'+((userPeer&&userPeer.open)?'':' ('+socialMsg()+')');
  }
  findU=u; findInfo=info; renderFindResult();
}
function renderFindResult(){
  const res=document.getElementById('findRes'); res.innerHTML=''; if(!findU) return;
  const u=findU, info=findInfo, row=document.createElement('div'); row.className='frow';
  row.innerHTML='<div class="pface"><div class="pfin">'+avatarHTML(hex6(info.skin),info.hat,info.face)+'</div></div><div class="fgrow"><div class="fname"></div><div class="fstat"></div></div><button class="oplay small"></button>';
  row.querySelector('.fname').textContent=censor(info.name||u).text;
  { const op=()=>openProfile(u,info); row.querySelector('.pface').onclick=op; row.querySelector('.fname').onclick=op; }
  const fs=row.querySelector('.fstat'); fs.innerHTML='<span class="dot'+(findLive?' on':'')+'"></span>'; fs.appendChild(document.createTextNode(findLive ? statusText(info) : 'Offline'));
  const b=row.querySelector('button'), st=friendState(u);
  if(st==='f'){ b.textContent='FRIENDS'; b.disabled=true; }
  else if(st==='i'){ b.textContent='ACCEPT'; b.onclick=()=>acceptFriend(u); }
  else if(st==='o'){ b.textContent='CANCEL REQUEST'; b.onclick=()=>{ profile.outgoing=profile.outgoing.filter(x=>x!==u); saveProfile(); document.getElementById('findNote').textContent='Request cancelled.'; renderSocial(); }; }
  else { b.textContent='ADD FRIEND'; b.onclick=async()=>{
    b.disabled=true; const r=await sendRequest(u);
    document.getElementById('findNote').textContent = r==='accepted' ? 'You are now friends!' : r==='declined' ? 'That player declined your request.' : r==='sent' ? 'Friend request sent!' : 'Request saved. It will be sent when you are both online.';
    renderFindResult();
  }; }
  res.appendChild(row);
}
function renderSocial(){
  renderFriends(); renderReqs(); renderFindResult(); renderPV(); _pkey='';
  if(pTab==='info' && !pp.classList.contains('hide')) renderPlayers();
}
// ----- other players' profiles -----
function friendMsg(r){ return r==='accepted' ? 'You are now friends!' : r==='declined' ? 'That player declined your request.' : r==='sent' ? 'Friend request sent!' : 'Request saved. It will be sent when you are both online.'; }
async function openProfile(u,hint){
  if(!u) return;
  if(acct && u===acct.uid){ if(!running){ document.getElementById('pview').classList.add('hide'); pv=null; showTab('profile'); } return; }
  const fc=profile.fcache[u], mt=profile.met[u], look=fc||mt||null;
  const base = hint ? {name:hint.name||u, skin:hint.skin, hat:hint.hat, face:hint.face}
             : look ? {name:look.name, skin:look.skin, hat:look.hat, face:look.face} : {name:u, skin:Y, hat:0, face:0};
  const token=pv={u, info:Object.assign({playing:null,lobby:null,join:null},base), live:false, loading:true, note:'',
                  about:(mt && mt.about!==undefined)?mt.about:null, recent:(mt && mt.recent)?mt.recent:null};
  document.getElementById('pview').classList.remove('hide'); renderPV();
  let r=null; if(userPeer && userPeer.open) r=await ask(u,{t:'profile'});
  if(pv!==token) return;                      // closed or switched to someone else meanwhile
  token.loading=false;
  if(r && r.t==='profile'){
    const info=cleanInfo(r.info);
    if(info){
      token.info=info; token.live=true;
      token.about=typeof r.about==='string' ? censor(r.about.slice(0,300)).text : '';
      token.recent=Array.isArray(r.recent) ? r.recent.filter(x=>x && typeof x.n==='string' && Number.isFinite(x.t)).slice(0,5).map(cleanRecent) : [];
      metSeen(u,info,{about:token.about,recent:token.recent});
    }
  }
  if(!token.live) token.note=(userPeer && userPeer.open) ? 'Offline right now. Showing what we last saw.' : socialMsg();
  renderPV();
}
function closeProfile(){ pv=null; document.getElementById('pview').classList.add('hide'); }
function renderPV(){
  if(!pv) return;
  const u=pv.u, info=pv.info, av=avatarHTML(hex6(info.skin),info.hat,info.face);
  document.getElementById('pvfin').innerHTML=av;
  document.getElementById('pvname').textContent=censor(info.name||u).text;
  const st=document.getElementById('pvstat'); st.innerHTML='<span class="dot'+(pv.live?' on':'')+'"></span>';
  st.appendChild(document.createTextNode(pv.loading ? 'Loading...' : pv.live ? statusText(info) : 'Offline'));
  const ab=document.getElementById('pvAbout');
  if(pv.about===null){ ab.textContent=pv.loading ? 'Loading...' : "Their About page can't be shown while they are offline."; ab.className='aboutv empty'; }
  else if(!pv.about){ ab.textContent="This player hasn't written anything about themselves yet."; ab.className='aboutv empty'; }
  else { ab.textContent=pv.about; ab.className='aboutv'; }
  const rb=document.getElementById('pvRecent'); rb.innerHTML='';
  if(pv.recent===null) rb.textContent=pv.loading ? 'Loading...' : "Their recent games can't be shown while they are offline.";
  else if(!pv.recent.length) rb.textContent="This player hasn't played any games yet.";
  else pv.recent.forEach(g=>rb.appendChild(recentRow(g)));
  document.getElementById('pvbox').innerHTML=av;
  document.getElementById('pvskin').style.background=hex6(info.skin);
  document.getElementById('pvhat').textContent=['None','Pirate hat','Baseball cap','Fedora'][info.hat];
  document.getElementById('pvfacename').textContent=['None','Smiley','Angry','Surprised'][info.face];
  document.getElementById('pvnote').textContent=pv.note||'';
  const act=document.getElementById('pvAct'); act.innerHTML='';
  const fs=friendState(u), b=document.createElement('button'); b.className='oplay small';
  if(fs==='f'){ b.textContent='FRIENDS'; b.disabled=true; }
  else if(fs==='i'){ b.textContent='ACCEPT'; b.onclick=()=>acceptFriend(u); }
  else if(fs==='o'){ b.textContent='CANCEL REQUEST'; b.onclick=()=>{ profile.outgoing=profile.outgoing.filter(x=>x!==u); saveProfile(); pv.note='Request cancelled.'; renderSocial(); }; }
  else { b.textContent='ADD FRIEND'; b.onclick=async()=>{ b.disabled=true; const tk=pv, r=await sendRequest(u); if(pv===tk){ pv.note=friendMsg(r); renderPV(); } }; }
  act.appendChild(b);
  if(!running && pv.live && info.join){
    const jb=document.createElement('button'); jb.className='oplay small'; jb.textContent='JOIN';
    jb.onclick=()=>{ const j=info.join; closeProfile(); playGame(j.pub ? {pub:j.pub} : {code:j.code}); };
    act.appendChild(jb);
  }
}
document.getElementById('pvClose').onclick=closeProfile;
document.getElementById('pview').addEventListener('click',e=>{ if(e.target===document.getElementById('pview')) closeProfile(); });
document.getElementById('findGo').onclick=doFind;
const findIn=document.getElementById('findIn');
findIn.addEventListener('keydown',e=>{ e.stopPropagation(); if(e.key==='Enter') doFind(); });
findIn.addEventListener('keyup',e=>e.stopPropagation());
// ----- go online -----
function claimUser(uid){
  return new Promise(resolve=>{
    let settled=false;
    const p=new Peer(USER+uid);
    const to=setTimeout(()=>{ if(settled) return; settled=true; try{ p.destroy(); }catch(e){} resolve('err'); },10000);
    p.on('open',()=>{ clearTimeout(to); if(settled) return; settled=true; userPeer=p; wireUser(p); resolve('ok'); });
    p.on('error',err=>{ if(settled) return; settled=true; clearTimeout(to); try{ p.destroy(); }catch(e){} resolve(err.type==='unavailable-id'?'taken':'err'); });
  });
}
function wireUser(p){
  p.on('connection',c=>{ c.on('data',m=>handleUser(m,c)); });
  p.on('error',onPeerErr);
  p.on('disconnected',()=>{ try{ p.reconnect(); }catch(e){} });
  p.on('close',()=>{ if(userPeer===p){ userPeer=null; userMsg='Connecting...'; renderSocial(); } });
}
async function initUser(){
  if(!acct || userPeer || userBusy) return; userBusy=true;
  const uid=acct.uid;
  try{
    try{ const h=JSON.parse(localStorage.getItem('webbyUserHold:'+uid)||'null'); if(h && h.id!==clientId && Date.now()-h.t<4000){ userMsg='other'; renderSocial(); return; } }catch(e){}
    try{ await loadPeer(); }catch(e){ userMsg='offline'; renderSocial(); return; }
    let r='taken';
    for(let t=0;t<4 && r==='taken';t++){ r=await claimUser(uid); if(r==='taken') await new Promise(x=>setTimeout(x,3000)); }   // maybe our own old session is still closing
    if(!acct || acct.uid!==uid){ if(r==='ok' && userPeer){ try{ userPeer.destroy(); }catch(e){} userPeer=null; } return; }   // logged out meanwhile
    if(r==='ok'){ userMsg=''; renderSocial(); socialTick(); }
    else { userMsg = r==='taken' ? 'taken' : 'offline'; renderSocial(); }
  } finally { userBusy=false; }
}
setInterval(()=>{ if(userPeer && acct){ try{ localStorage.setItem('webbyUserHold:'+acct.uid,JSON.stringify({id:clientId,t:Date.now()})); }catch(e){} } },1000);
addEventListener('pagehide',()=>{ if(!acct) return; try{ const k='webbyUserHold:'+acct.uid, h=JSON.parse(localStorage.getItem(k)||'null'); if(h && h.id===clientId) localStorage.removeItem(k); }catch(e){} });
setInterval(()=>{ if(acct && !userPeer) initUser(); },8000);
setInterval(socialTick,20000);
// ----- server list: how many players are in each public server, and who -----
let probeP=null, scanning=false;
function probePeer(){
  if(userPeer && userPeer.open) return userPeer;
  if(probeP && probeP.open) return probeP;
  if(!probeP && window.Peer){ probeP=new Peer(); probeP.on('error',onPeerErr); probeP.on('close',()=>{ probeP=null; }); }
  return probeP;
}
async function scanServers(gk){
  const pfx=gk ? 'webby-gs-'+gk+'-' : 'webby-pub-';
  await loadPeer();
  const pe=probePeer(); if(!pe) return null;
  for(let i=0;i<30 && !pe.open;i++) await new Promise(r=>setTimeout(r,200));
  if(!pe.open) return null;
  const MAXS=6, jobs=[];
  for(let n=1;n<=MAXS;n++) for(let sl=1;sl<=PUB_MAX;sl++)
    jobs.push(askRaw(pe,pfx+n+'-'+sl,null,{probe:true},d=>d && d.k==='whoami').then(d=>({n,info:d?cleanInfo(d.info):null})));
  const res=await Promise.all(jobs), by={};
  res.forEach(x=>{ if(x.info) (by[x.n]=by[x.n]||[]).push(x.info); });
  const out=[]; let emptyAdded=false;
  for(let n=1;n<=MAXS;n++){ const pl=by[n]||[]; if(pl.length) out.push({n,players:pl}); else if(!emptyAdded){ out.push({n,players:[]}); emptyAdded=true; } }
  return out;
}
let srvGame=null;
async function refreshServers(){
  if(scanning) return; scanning=true;
  const box=document.getElementById('srvList'); box.textContent='Looking for servers...';
  let servers=null;
  try{ servers=await scanServers(srvGame?srvGame.gk:null); }catch(e){}
  scanning=false; box.innerHTML='';
  if(!servers){ box.textContent='Could not reach the servers. Check your internet.'; return; }
  servers.forEach(sv=>{
    const row=document.createElement('div'); row.className='srvrow';
    row.innerHTML='<div class="srvinfo"><div class="srvname"></div><div class="srvcnt"></div></div><div class="srvpl"></div><button class="oplay small"></button>';
    row.querySelector('.srvname').textContent='Server '+sv.n;
    row.querySelector('.srvcnt').textContent=sv.players.length+' / '+PUB_MAX+' players';
    const pl=row.querySelector('.srvpl');
    if(!sv.players.length){ pl.textContent='Empty'; pl.style.color='#888'; }
    sv.players.forEach(p=>{
      const d=document.createElement('div'); d.className='pcard';
      d.innerHTML='<div class="pface"><div class="pfin">'+avatarHTML(hex6(p.skin),p.hat,p.face)+'</div></div><span></span>';
      d.querySelector('span').textContent=censor(p.name).text; pl.appendChild(d);
      d.onclick=()=>{ const pu=uidOf(p.name); if(pu && acct && pu!==acct.uid) openProfile(pu,p); };
    });
    const b=row.querySelector('button');
    if(sv.players.length>=PUB_MAX){ b.textContent='FULL'; b.disabled=true; }
    else { b.textContent='JOIN'; b.onclick=()=>{ document.getElementById('srv').classList.add('hide'); if(srvGame) playCommunity(srvGame,{pub:sv.n}); else playGame({pub:sv.n}); }; }
    box.appendChild(row);
  });
}
function openServers(en){
  srvGame=en||null;
  document.getElementById('srvTitle').textContent=en?en.n:'Servers';
  document.getElementById('srvSub').textContent=en?('By '+en.dn+' \u00b7 up to '+PUB_MAX+' players in each server'):('Testing place \u00b7 up to '+PUB_MAX+' players in each server');
  document.getElementById('srv').classList.remove('hide'); refreshServers();
}
document.getElementById('hservers').onclick=()=>openServers(null);
document.getElementById('srvRefresh').onclick=refreshServers;
document.getElementById('srvClose').onclick=()=>document.getElementById('srv').classList.add('hide');
renderSocial();

// Camera control: drag to orbit, scroll to zoom
let camYaw = 0, camPitch = 0.6, camDist = 16, dragging = false;
const cv = renderer.domElement;
cv.addEventListener('pointerdown', e=>{ dragging = true; cv.setPointerCapture(e.pointerId); });
cv.addEventListener('pointerup', ()=>{ dragging = false; });
cv.addEventListener('pointermove', e=>{
  if(!dragging || shiftLock) return;
  camYaw -= e.movementX*0.006*SET.sens;
  camPitch = Math.max(0.1, Math.min(1.35, camPitch + e.movementY*0.006*SET.sens*(SET.inv?-1:1)));
});
cv.addEventListener('wheel', e=>{ e.preventDefault(); camDist = Math.max(6, Math.min(30, camDist + e.deltaY*0.022)); }, {passive:false});

function overlaps(b){
  return p.x+HW>b.minx && p.x-HW<b.maxx && p.z+HW>b.minz && p.z-HW<b.maxz && p.y+H>b.miny && p.y<b.maxy;
}
function stepOrPush(b, push){
  if(v.y<=0 && b.maxy-p.y<=0.75) p.y = b.maxy;   // auto step up small stairs
  else push();
}

let last = performance.now();
function loop(now){
  requestAnimationFrame(loop);
  const dt = Math.min((now-last)/1000, 0.05); last = now; t += dt;

  if(running && !dead){
    const up = keys.KeyW||keys.ArrowUp, down = keys.KeyS||keys.ArrowDown;
    let mx = (keys.KeyD||keys.ArrowRight?1:0) - (keys.KeyA||keys.ArrowLeft?1:0);
    let mz = (down?1:0) - (up?1:0);
    const len = Math.hypot(mx,mz) || 1;
    const wx = mx*Math.cos(camYaw) + mz*Math.sin(camYaw), wz = -mx*Math.sin(camYaw) + mz*Math.cos(camYaw);
    climbCool -= dt;

    // ladder
    const inLadder = !customMode && Math.abs(p.x)<0.9 && p.z>-17.6 && p.z<-16 && p.y>=-0.1 && p.y<8;
    if(!climbing && inLadder && up && climbCool<=0) climbing = true;
    let climbMoving = false;
    if(climbing){
      if(!inLadder){ climbing = false; }
      else if(keys.Space){ climbing=false; climbCool=0.4; v.y=10; v.z=5; }
      else if(p.y>=7.5 && up){ climbing=false; climbCool=0.6; v.y=8; }
      else if(down && onGround){ climbing=false; climbCool=0.3; }
      else {
        v.x = 0; v.z = 0; v.y = up?5 : down?-5 : 0;
        climbMoving = v.y!==0;
        p.x = 0; p.z = -16.55; facing = Math.PI;
      }
    }

    if(!climbing){
      v.x = wx/len*SPEED; v.z = wz/len*SPEED;
      if(keys.Space && onGround){ v.y = JUMPV; onGround = false; }
      v.y -= GRAV*dt;
    }

    p.x += v.x*dt; for(const b of boxes) if(overlaps(b)) stepOrPush(b, ()=>{ p.x = v.x>0 ? b.minx-HW : b.maxx+HW; });
    p.z += v.z*dt; for(const b of boxes) if(overlaps(b)) stepOrPush(b, ()=>{ p.z = v.z>0 ? b.minz-HW : b.maxz+HW; });
    p.y += v.y*dt; onGround = false;
    for(const b of boxes) if(overlaps(b)){
      if(v.y<=0){ p.y = b.maxy; onGround = true; } else { p.y = b.miny-H; }
      v.y = 0;
    }
    if(p.y < -15){ p.copy(spawnPos); v.set(0,0,0); climbing=false; shieldT=5; }

    // shared DevTools blocks: damage/kill/bounce apply to every player who touches them
    if(!customMode && shieldT<=0){
      devBlocks.forEach(o=>{
        if(!o.visible) { o.hurtT=0; return; }
        const b=o.box;
        const dtouch=p.x+HW+0.15>b.minx && p.x-HW-0.15<b.maxx && p.z+HW+0.15>b.minz && p.z-HW-0.15<b.maxz && p.y+H>b.miny-0.05 && p.y<b.maxy+0.1;
        if(dtouch){
          if(o.kill) die();
          else if(o.damage>0){ o.hurtT=(o.hurtT||0)-dt; if(o.hurtT<=0){ o.hurtT=0.35; setHp(hp-o.damage); sfx.hurt(); burst(p.x,p.y+1.5,p.z,o.color,5,1); if(hp<=0) die(); } }
          if(o.bounce>0){ v.y=o.bounce; onGround=false; }
        } else o.hurtT=0;
      });
      devLocalTouch.forEach((t,id)=>{
        const o=devBlocks.get(id); if(!o){ devLocalTouch.delete(id); return; }
        const b=o.box, dtouch=p.x+HW+0.15>b.minx && p.x-HW-0.15<b.maxx && p.z+HW+0.15>b.minz && p.z-HW-0.15<b.maxz && p.y+H>b.miny-0.05 && p.y<b.maxy+0.1;
        if(dtouch && !t.was) t.fn(); t.was=dtouch;
      });
    }

    // orange damage blocks: 5% every 0.35s while touching
    hurtT -= dt;
    let touching=false;
    for(const b of hazards) if(p.x+HW+0.15>b.minx && p.x-HW-0.15<b.maxx && p.z+HW+0.15>b.minz && p.z-HW-0.15<b.maxz && p.y+H>b.miny && p.y<b.maxy+0.1){ touching=true; break; }
    if(touching && shieldT<=0){
      if(hurtT<=0){ hurtT=0.35; setHp(hp-5); sfx.hurt(); burst(p.x,p.y+1.5,p.z,0xff6d00,6,1); if(hp<=0) die(); }
    } else hurtT=0;

    // touch the red brick
    if(!customMode && shieldT<=0 && p.x+HW>brickBox.minx && p.x-HW<brickBox.maxx && p.z+HW>brickBox.minz && p.z-HW<brickBox.maxz && p.y+H>brickBox.miny && p.y<brickBox.maxy) die();

    // animation
    if(dancing && (mx!==0 || mz!==0 || keys.Space || climbing || !onGround)) dancing = false;
    const moving = !climbing && (mx!==0 || mz!==0);
    animState = dancing?4 : climbing?2 : !onGround?3 : (moving?1:0);
    if(shiftLock && !climbing) facing = camYaw + Math.PI;
    else if(moving){
      const target = Math.atan2(wx, wz);
      let d = target - facing; d = Math.atan2(Math.sin(d), Math.cos(d));
      facing += d*Math.min(1, dt*15);
    }
    body.position.y = 0; body.rotation.z = 0;
    if(dancing){
      const s=Math.sin(t*10);
      body.position.y=Math.abs(s)*0.35; body.rotation.z=s*0.15;
      armL.rotation.x=Math.PI+s*0.6; armR.rotation.x=Math.PI-s*0.6;
      legL.rotation.x=s*0.6; legR.rotation.x=-s*0.6;
    } else if(climbing){
      if(climbMoving) climbPhase += dt*9*Math.sign(v.y);
      const s = Math.sin(climbPhase);
      armL.rotation.x = Math.PI - 0.4 + s*0.7;  armR.rotation.x = Math.PI - 0.4 - s*0.7;
      legL.rotation.x = -s*0.8;                  legR.rotation.x =  s*0.8;
    } else {
      const sw = moving && onGround ? Math.sin(t*12)*0.8 : 0;
      legL.rotation.x = sw; legR.rotation.x = -sw;
      armL.rotation.x = -sw; armR.rotation.x = sw;
      if(!onGround){ armL.rotation.x = armR.rotation.x = Math.PI; }
    }
  }

  // death / ragdoll / respawn
  if(dead){
    pieces.forEach(o=>{
      o.vel.y -= 30*dt;
      o.m.position.addScaledVector(o.vel, dt);
      o.m.rotation.x += o.spin.x*dt; o.m.rotation.y += o.spin.y*dt; o.m.rotation.z += o.spin.z*dt;
      if(o.m.position.y < o.half){
        o.m.position.y = o.half; o.vel.y *= -0.3;
        o.vel.x *= 0.7; o.vel.z *= 0.7; o.spin.multiplyScalar(0.7);
      }
    });
    deathTimer -= dt;
    if(deathTimer<=0) respawn();
  }

  // other players
  remotes.forEach(r=>{
    if(r.tx===undefined) return;
    const k=Math.min(1,dt*12);
    r.x+=(r.tx-r.x)*k; r.y+=(r.ty-r.y)*k; r.z+=(r.tz-r.z)*k;
    let d=r.tf-r.f; d=Math.atan2(Math.sin(d),Math.cos(d)); r.f+=d*k;
    const c=r.c; c.g.position.set(r.x,r.y,r.z); c.b.rotation.y=r.f; c.b.position.y=0; c.b.rotation.z=0;
    if(r.an===4){ const s=Math.sin(t*10); c.b.position.y=Math.abs(s)*0.35; c.b.rotation.z=s*0.15; c.aL.rotation.x=Math.PI+s*0.6; c.aR.rotation.x=Math.PI-s*0.6; c.lL.rotation.x=s*0.6; c.lR.rotation.x=-s*0.6; }
    else if(r.an===2){ const s=Math.sin(t*9); c.aL.rotation.x=Math.PI-0.4+s*0.7; c.aR.rotation.x=Math.PI-0.4-s*0.7; c.lL.rotation.x=-s*0.8; c.lR.rotation.x=s*0.8; }
    else if(r.an===3){ c.aL.rotation.x=c.aR.rotation.x=Math.PI; c.lL.rotation.x=c.lR.rotation.x=0; }
    else { const sw=r.an===1?Math.sin(t*12)*0.8:0; c.lL.rotation.x=sw; c.lR.rotation.x=-sw; c.aL.rotation.x=-sw; c.aR.rotation.x=sw; }
  });
  for(let i=parts.length-1;i>=0;i--){
    const o=parts[i]; o.v.y-=20*dt; o.m.position.addScaledVector(o.v,dt); o.ttl-=dt;
    o.m.material.opacity=Math.max(0,o.ttl/o.life); o.m.rotation.x+=dt*6;
    if(o.ttl<=0){ scene.remove(o.m); o.m.material.dispose(); parts.splice(i,1); }
  }
  rpieces = rpieces.filter(o=>{
    o.vel.y -= 30*dt; o.m.position.addScaledVector(o.vel, dt);
    o.m.rotation.x += o.spin.x*dt; o.m.rotation.y += o.spin.y*dt; o.m.rotation.z += o.spin.z*dt;
    if(o.m.position.y < o.half){ o.m.position.y=o.half; o.vel.y*=-0.3; o.vel.x*=0.7; o.vel.z*=0.7; o.spin.multiplyScalar(0.7); }
    o.ttl -= dt;
    if(o.ttl<=0){ scene.remove(o.m); return false; }
    return true;
  });
  // share my state
  if(room && running && now-lastSend>66){
    lastSend = now;
    room.presence({x:+p.x.toFixed(2), y:+p.y.toFixed(2), z:+p.z.toFixed(2), f:+facing.toFixed(2), a:animState, d:dead?1:0, h:Math.round(hp), sh:shieldT>0?1:0, sk:mySkin, nm:myName, ht:myHat, fc:myFace}).catch(()=>{});
  }

  if(customMode && running) customTick(dt);
  if(dancing && !musicTimer) startMusic(); else if(!dancing && musicTimer) stopMusic();
  player.position.copy(p); body.rotation.y = facing;
  lockOff += ((shiftLock?1.7:0) - lockOff) * Math.min(1, dt*10);
  const rx = Math.cos(camYaw)*lockOff, rz = -Math.sin(camYaw)*lockOff;
  const want = new THREE.Vector3(p.x + rx + Math.sin(camYaw)*Math.cos(camPitch)*camDist, p.y + Math.sin(camPitch)*camDist, p.z + rz + Math.cos(camYaw)*Math.cos(camPitch)*camDist);
  camera.position.lerp(want, Math.min(1, dt*(shiftLock?25:5)));
  camera.lookAt(p.x + rx, p.y+1.5, p.z + rz);
  camera.updateMatrixWorld();
  if(shieldT>0) shieldT-=dt;
  myShield.visible = shieldT>0 && !dead && (shieldT>1 || Math.floor(t*8)%2===0);
  setName(myLbl, myName); setHealth(myLbl, hp);
  setLabel(myLbl, p.x, p.y+3.6, p.z, running && !dead);
  updateBubble('me', p.x, p.y+3.6, p.z, running && !dead);
  devSigns.forEach(o=>{ _v.set(o.x,o.y,o.z).project(camera); if(_v.z>1||Math.abs(_v.x)>1.2||Math.abs(_v.y)>1.2||!running){ o.el.style.display='none'; } else { o.el.style.display='block'; o.el.style.transform='translate('+((_v.x*0.5+0.5)*innerWidth)+'px,'+((-_v.y*0.5+0.5)*innerHeight)+'px) translate(-50%,-50%)'; } });
  remotes.forEach((r,id)=>{ if(r.name) setName(r.lbl,r.name); setHealth(r.lbl, r.hp===undefined?100:r.hp); if(r.sh) r.sh.visible=!!r.shield && !r.dead; setLabel(r.lbl, r.x, r.y+3.6, r.z, !r.dead); updateBubble(id, r.x, r.y+3.6, r.z, !r.dead); });
  renderer.render(scene, camera);
}
requestAnimationFrame(loop);
addEventListener('resize', ()=>{
  camera.aspect = innerWidth/innerHeight; camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

// ---------- Webby Create: a small Lua interpreter (Lua 5.3 style) ----------
class LuaError extends Error{ constructor(m,line){ super(m); this.lua=true; this.line=line||0; this.fatal=false; } }
class LuaTable{
  constructor(){ this.h=new Map(); this.meta=null; this.n=0; }
  get(k){ const v=this.h.get(k); return v===undefined?null:v; }
  set(k,v){
    if(k===null||k===undefined) throw new LuaError('table index is nil');
    if(typeof k==='number' && k!==k) throw new LuaError('table index is NaN');
    if(v===null||v===undefined){ this.h.delete(k); if(typeof k==='number' && k>=1 && k<=this.n) this.n=k-1; }
    else{ this.h.set(k,v); if(k===this.n+1){ this.n=k; while(this.h.has(this.n+1)) this.n++; } }
  }
  length(){ return this.n; }
}
class LuaFunction{ constructor(node,scope,name){ this.node=node; this.scope=scope; this.name=name||'?'; } }
class LuaScope{ constructor(parent){ this.v=new Map(); this.parent=parent; }
  find(n){ let s=this; while(s){ if(s.v.has(n)) return s; s=s.parent; } return null; } }
const LUA_BRK={brk:true};
const luaTruthy=v=>v!==null && v!==false && v!==undefined;
const LUA_KW=new Set(['and','break','do','else','elseif','end','false','for','function','if','in','local','nil','not','or','repeat','return','then','true','until','while']);

function luaLex(src){
  const toks=[]; let i=0, line=1; const n=src.length;
  const err=m=>{ throw new LuaError(m,line); };
  const push=(t,v)=>toks.push({t,v,line});
  while(i<n){
    const c=src[i];
    if(c==='\n'){ line++; i++; continue; }
    if(c===' '||c==='\t'||c==='\r'){ i++; continue; }
    if(c==='-' && src[i+1]==='-'){
      i+=2;
      const m=/^\[(=*)\[/.exec(src.slice(i,i+40));
      if(m){ const close=']'+m[1]+']'; const e=src.indexOf(close,i+m[0].length); if(e<0) err('unfinished long comment'); for(const ch of src.slice(i,e)) if(ch==='\n') line++; i=e+close.length; }
      else{ while(i<n && src[i]!=='\n') i++; }
      continue;
    }
    if(/[A-Za-z_]/.test(c)){ let j=i+1; while(j<n && /[A-Za-z0-9_]/.test(src[j])) j++; const w=src.slice(i,j); push(LUA_KW.has(w)?'kw':'name',w); i=j; continue; }
    if(/[0-9]/.test(c) || (c==='.' && /[0-9]/.test(src[i+1]||''))){
      let m=/^0[xX][0-9a-fA-F]+/.exec(src.slice(i,i+40));
      if(m){ push('num',parseInt(m[0],16)); i+=m[0].length; continue; }
      m=/^(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?/.exec(src.slice(i,i+60));
      push('num',Number(m[0])); i+=m[0].length; continue;
    }
    if(c==='"'||c==="'"){
      let j=i+1, out='';
      for(;;){
        if(j>=n || src[j]==='\n') err('unfinished string');
        const d=src[j];
        if(d===c){ j++; break; }
        if(d==='\\'){
          j++; const e=src[j];
          if(e==='n') out+='\n'; else if(e==='t') out+='\t'; else if(e==='r') out+='\r'; else if(e==='a') out+='\x07'; else if(e==='b') out+='\b'; else if(e==='f') out+='\f'; else if(e==='v') out+='\v';
          else if(e==='\\') out+='\\'; else if(e==='"') out+='"'; else if(e==="'") out+="'";
          else if(e==='\n'){ out+='\n'; line++; }
          else if(e==='x'){ out+=String.fromCharCode(parseInt(src.substr(j+1,2),16)); j+=2; }
          else if(e==='z'){ while(j+1<n && /\s/.test(src[j+1])){ if(src[j+1]==='\n') line++; j++; } }
          else if(/[0-9]/.test(e)){ let k=j, num=''; while(k<j+3 && /[0-9]/.test(src[k]||'')){ num+=src[k]; k++; } out+=String.fromCharCode(parseInt(num,10)); j=k-1; }
          else err('invalid escape sequence \\'+e);
          j++;
        } else { out+=d; j++; }
      }
      push('str',out); i=j; continue;
    }
    if(c==='['){
      const m=/^\[(=*)\[/.exec(src.slice(i,i+40));
      if(m){
        const close=']'+m[1]+']'; const e=src.indexOf(close,i+m[0].length); if(e<0) err('unfinished long string');
        let s=src.slice(i+m[0].length,e); const startLine=line; for(const ch of s) if(ch==='\n') line++;
        if(s[0]==='\n') s=s.slice(1);
        toks.push({t:'str',v:s,line:startLine}); i=e+close.length; continue;
      }
    }
    if(src.substr(i,3)==='...'){ push('op','...'); i+=3; continue; }
    const two=src.substr(i,2);
    if(['==','~=','<=','>=','//','..'].includes(two)){ push('op',two); i+=2; continue; }
    if('+-*/%^#<>=(){}[];:,.'.includes(c)){ push('op',c); i++; continue; }
    err("unexpected symbol near '"+c+"'");
  }
  push('eof','<eof>'); return toks;
}

function luaParse(src){
  const T=luaLex(src); let p=0;
  const isOp=v=>T[p].t==='op'&&T[p].v===v, isKw=v=>T[p].t==='kw'&&T[p].v===v;
  const fail=m=>{ throw new LuaError(m||("unexpected symbol near '"+T[p].v+"'"),T[p].line); };
  const expectOp=v=>{ if(!isOp(v)) fail("'"+v+"' expected near '"+T[p].v+"'"); return T[p++]; };
  const expectKw=v=>{ if(!isKw(v)) fail("'"+v+"' expected near '"+T[p].v+"'"); return T[p++]; };
  const acceptOp=v=>{ if(isOp(v)){ p++; return true; } return false; };
  const acceptKw=v=>{ if(isKw(v)){ p++; return true; } return false; };
  const name=()=>{ if(T[p].t!=='name') fail("<name> expected near '"+T[p].v+"'"); return T[p++].v; };
  const blockEnd=()=>{ const t=T[p]; return t.t==='eof' || (t.t==='kw' && (t.v==='end'||t.v==='else'||t.v==='elseif'||t.v==='until')); };
  function block(){ const out=[]; while(!blockEnd()){ if(isKw('return')){ out.push(retStat()); break; } const s=stat(); if(s) out.push(s); } return out; }
  function retStat(){ const line=T[p++].line; let exprs=[]; if(!blockEnd() && !isOp(';')) exprs=exprList(); acceptOp(';'); return {k:'Return',exprs,line}; }
  function funcBody(isMethod,line){
    expectOp('('); const params=isMethod?['self']:[]; let vararg=false;
    if(!isOp(')')){ do{ if(isOp('...')){ p++; vararg=true; break; } params.push(name()); }while(acceptOp(',')); }
    expectOp(')'); const body=block(); expectKw('end'); return {k:'Function',params,vararg,body,line};
  }
  function stat(){
    const t=T[p], line=t.line;
    if(acceptOp(';')) return null;
    if(t.t==='kw'){
      switch(t.v){
        case 'if': {
          p++; const clauses=[]; const c0=expr(); expectKw('then'); clauses.push({cond:c0,body:block()}); let els=null;
          for(;;){
            if(acceptKw('elseif')){ const c=expr(); expectKw('then'); clauses.push({cond:c,body:block()}); }
            else if(acceptKw('else')){ els=block(); expectKw('end'); break; }
            else { expectKw('end'); break; }
          }
          return {k:'If',clauses,els,line};
        }
        case 'while': { p++; const cond=expr(); expectKw('do'); const body=block(); expectKw('end'); return {k:'While',cond,body,line}; }
        case 'do': { p++; const body=block(); expectKw('end'); return {k:'Do',body,line}; }
        case 'for': {
          p++; const n1=name();
          if(isOp('=')){ p++; const a=expr(); expectOp(','); const b=expr(); let c=null; if(acceptOp(',')) c=expr(); expectKw('do'); const body=block(); expectKw('end'); return {k:'NumFor',v:n1,a,b,c,body,line}; }
          const names=[n1]; while(acceptOp(',')) names.push(name()); expectKw('in'); const exprs=exprList(); expectKw('do'); const body=block(); expectKw('end');
          return {k:'GenFor',names,exprs,body,line};
        }
        case 'repeat': { p++; const body=block(); expectKw('until'); const cond=expr(); return {k:'Repeat',body,cond,line}; }
        case 'function': {
          p++; let target={k:'Name',name:name(),line}; let isMethod=false;
          while(isOp('.')||isOp(':')){ const colon=isOp(':'); p++; const key=name(); target={k:'Index',obj:target,key:{k:'Str',v:key},line}; if(colon){ isMethod=true; break; } }
          const f=funcBody(isMethod,line); return {k:'Assign',targets:[target],exprs:[f],line};
        }
        case 'local': {
          p++;
          if(acceptKw('function')){ const n=name(); const f=funcBody(false,line); return {k:'LocalFunction',name:n,f,line}; }
          const names=[]; do{ names.push(name()); if(isOp('<')){ p++; name(); expectOp('>'); } }while(acceptOp(','));
          let exprs=[]; if(acceptOp('=')) exprs=exprList(); return {k:'Local',names,exprs,line};
        }
        case 'break': p++; return {k:'Break',line};
        default: fail();
      }
    }
    const e=suffixed();
    if(isOp('=')||isOp(',')){
      const targets=[e]; while(acceptOp(',')) targets.push(suffixed()); expectOp('=');
      const exprs=exprList();
      for(const tg of targets) if(tg.k!=='Name'&&tg.k!=='Index') fail('cannot assign to this expression');
      return {k:'Assign',targets,exprs,line};
    }
    if(e.k!=='Call'&&e.k!=='MCall') fail("syntax error near '"+T[p].v+"'");
    return {k:'ExprStat',e,line};
  }
  function exprList(){ const l=[expr()]; while(acceptOp(',')) l.push(expr()); return l; }
  function primary(){
    const t=T[p];
    if(t.t==='name'){ p++; return {k:'Name',name:t.v,line:t.line}; }
    if(acceptOp('(')){ const e=expr(); expectOp(')'); return {k:'Paren',e,line:t.line}; }
    fail();
  }
  function callArgs(){
    const t=T[p];
    if(t.t==='str'){ p++; return [{k:'Str',v:t.v}]; }
    if(isOp('{')) return [tableCons()];
    expectOp('('); let args=[]; if(!isOp(')')) args=exprList(); expectOp(')'); return args;
  }
  function suffixed(){
    let e=primary();
    for(;;){
      const t=T[p], line=t.line;
      if(isOp('.')){ p++; e={k:'Index',obj:e,key:{k:'Str',v:name()},line}; }
      else if(isOp('[')){ p++; const key=expr(); expectOp(']'); e={k:'Index',obj:e,key,line}; }
      else if(isOp(':')){ p++; const m=name(); const args=callArgs(); e={k:'MCall',obj:e,name:m,args,line}; }
      else if(isOp('(')||isOp('{')||t.t==='str'){ const args=callArgs(); e={k:'Call',f:e,args,line}; }
      else return e;
    }
  }
  function tableCons(){
    const line=T[p].line; expectOp('{'); const items=[];
    while(!isOp('}')){
      if(isOp('[')){ p++; const k=expr(); expectOp(']'); expectOp('='); items.push({kind:'kv',k,v:expr()}); }
      else if(T[p].t==='name' && T[p+1].t==='op' && T[p+1].v==='='){ const k={k:'Str',v:T[p++].v}; p++; items.push({kind:'kv',k,v:expr()}); }
      else items.push({kind:'pos',v:expr()});
      if(!acceptOp(',') && !acceptOp(';')) break;
    }
    expectOp('}'); return {k:'Table',items,line};
  }
  function simple(){
    const t=T[p];
    if(t.t==='num'){ p++; return {k:'Num',v:t.v}; }
    if(t.t==='str'){ p++; return {k:'Str',v:t.v}; }
    if(t.t==='kw'){
      if(t.v==='nil'){ p++; return {k:'Nil'}; }
      if(t.v==='true'){ p++; return {k:'True'}; }
      if(t.v==='false'){ p++; return {k:'False'}; }
      if(t.v==='function'){ p++; return funcBody(false,t.line); }
    }
    if(t.t==='op'){
      if(t.v==='...'){ p++; return {k:'Vararg'}; }
      if(t.v==='{') return tableCons();
    }
    return suffixed();
  }
  const BIN={'or':[1,1],'and':[2,2],'<':[3,3],'>':[3,3],'<=':[3,3],'>=':[3,3],'~=':[3,3],'==':[3,3],'..':[9,8],'+':[10,10],'-':[10,10],'*':[11,11],'/':[11,11],'//':[11,11],'%':[11,11],'^':[14,13]};
  function expr(limit=0){
    let left; const t=T[p];
    if((t.t==='kw'&&t.v==='not')||(t.t==='op'&&(t.v==='-'||t.v==='#'))){ p++; const e=expr(12); left={k:'Un',op:t.v,e,line:t.line}; }
    else left=simple();
    for(;;){
      const o=T[p]; const key=(o.t==='op'||(o.t==='kw'&&(o.v==='and'||o.v==='or')))?o.v:null;
      const pr=key&&BIN[key]; if(!pr||pr[0]<=limit) break;
      p++; const right=expr(pr[1]); left={k:'Bin',op:key,a:left,b:right,line:o.line};
    }
    return left;
  }
  const body=block(); if(T[p].t!=='eof') fail(); return body;
}

class LuaVM{
  constructor(){ this.G=new LuaTable(); this.steps=0; this.limit=4e6; this.line=0; this.depth=0; this.out=()=>{}; this.setup(); }
  err(m){ return new LuaError(m,this.line); }
  tick(){ if(++this.steps>this.limit){ const e=this.err('script ran too long (an endless loop?)'); e.fatal=true; throw e; } }
  typeName(v){ if(v===null||v===undefined) return 'nil'; if(typeof v==='boolean') return 'boolean'; if(typeof v==='number') return 'number'; if(typeof v==='string') return 'string'; if(v instanceof LuaTable) return 'table'; return 'function'; }
  numStr(n){ if(Number.isInteger(n)) return String(n); if(n!==n) return 'nan'; if(!isFinite(n)) return n>0?'inf':'-inf'; return String(+n.toPrecision(14)); }
  tostr(v){
    if(v===null||v===undefined) return 'nil';
    if(typeof v==='boolean') return v?'true':'false';
    if(typeof v==='number') return this.numStr(v);
    if(typeof v==='string') return v;
    if(v instanceof LuaTable){ if(v.meta){ const h=v.meta.get('__tostring'); if(h!==null) return this.tostr(this.call(h,[v])[0]); } if(!v._id) v._id=(LuaVM.ids=(LuaVM.ids||4096)+16); return 'table: 0x'+v._id.toString(16); }
    if(!v._id) v._id=(LuaVM.ids=(LuaVM.ids||4096)+16);
    return 'function: 0x'+v._id.toString(16);
  }
  toNum(v){ if(typeof v==='number') return v; if(typeof v==='string'){ const s=v.trim(); if(s!==''){ const n=Number(s); if(!isNaN(n)) return n; } } return null; }
  run(code){ const ast=luaParse(code); this.steps=0; this.depth=0; const sc=new LuaScope(null); const r=this.execBlock(ast,sc); return r&&r.ret?r.ret:[]; }
  callTop(f,args){ this.steps=0; this.depth=0; return this.call(f,args); }
  // ----- evaluation -----
  execBlock(stmts,scope){ for(const s of stmts){ const sig=this.exec(s,scope); if(sig) return sig; } return null; }
  exec(s,scope){
    this.line=s.line||this.line;
    switch(s.k){
      case 'Local': { const vals=this.evalList(s.exprs,scope); s.names.forEach((n,i)=>scope.v.set(n,i<vals.length?vals[i]:null)); return null; }
      case 'Assign': { const vals=this.evalList(s.exprs,scope); s.targets.forEach((t,i)=>this.assign(t,i<vals.length?vals[i]:null,scope)); return null; }
      case 'ExprStat': this.evalMulti(s.e,scope); return null;
      case 'LocalFunction': { scope.v.set(s.name,null); scope.v.set(s.name,new LuaFunction(s.f,scope,s.name)); return null; }
      case 'Return': return {ret:this.evalList(s.exprs,scope)};
      case 'Break': return LUA_BRK;
      case 'Do': return this.execBlock(s.body,new LuaScope(scope));
      case 'If': {
        for(const c of s.clauses){ if(luaTruthy(this.eval(c.cond,scope))) return this.execBlock(c.body,new LuaScope(scope)); }
        return s.els?this.execBlock(s.els,new LuaScope(scope)):null;
      }
      case 'While': {
        while(luaTruthy(this.eval(s.cond,scope))){ this.tick(); const r=this.execBlock(s.body,new LuaScope(scope)); if(r){ if(r===LUA_BRK) break; return r; } }
        return null;
      }
      case 'Repeat': {
        for(;;){ this.tick(); const sc=new LuaScope(scope); const r=this.execBlock(s.body,sc); if(r){ if(r===LUA_BRK) break; return r; } if(luaTruthy(this.eval(s.cond,sc))) break; }
        return null;
      }
      case 'NumFor': {
        const a=this.forNum(this.eval(s.a,scope),'initial'), b=this.forNum(this.eval(s.b,scope),'limit'), st=s.c?this.forNum(this.eval(s.c,scope),'step'):1;
        if(st===0) throw this.err("'for' step is zero");
        for(let i=a; st>0?i<=b:i>=b; i+=st){ this.tick(); const sc=new LuaScope(scope); sc.v.set(s.v,i); const r=this.execBlock(s.body,sc); if(r){ if(r===LUA_BRK) break; return r; } }
        return null;
      }
      case 'GenFor': {
        const vals=this.evalList(s.exprs,scope); const f=vals[0]; const st=vals.length>1?vals[1]:null; let ctl=vals.length>2?vals[2]:null;
        for(;;){
          this.tick(); const rs=this.call(f,[st,ctl]); if(rs.length===0||rs[0]===null) break; ctl=rs[0];
          const sc=new LuaScope(scope); s.names.forEach((n,i)=>sc.v.set(n,i<rs.length?rs[i]:null));
          const r=this.execBlock(s.body,sc); if(r){ if(r===LUA_BRK) break; return r; }
        }
        return null;
      }
    }
    return null;
  }
