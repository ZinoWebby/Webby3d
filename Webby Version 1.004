      if(pos<1||pos>n+1) throw vm.err("bad argument #2 to 'remove' (position out of bounds)");
      const v=t.get(pos); for(let k=pos;k<n;k++) t.set(k,t.get(k+1)); t.set(n,null); return v;
    });
    TB.set('concat',(t,sep,i,j)=>{
      tbl(t,1,'concat'); sep=opt(sep)?'':str(sep,2,'concat'); i=opt(i)?1:i; j=opt(j)?t.length():j; const out=[];
      for(let k=i;k<=j;k++){ const v=t.get(k); if(typeof v!=='string'&&typeof v!=='number') throw vm.err("invalid value (at index "+k+") in table for 'concat'"); out.push(typeof v==='number'?vm.numStr(v):v); }
      return out.join(sep);
