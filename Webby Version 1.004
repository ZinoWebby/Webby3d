  // ----- standard library -----
  setup(){
    const vm=this, G=this.G;
    const num=(v,i,fn)=>{ const x=typeof v==='boolean'?null:vm.toNum(v); if(x===null) throw vm.err("bad argument #"+i+" to '"+fn+"' (number expected, got "+vm.typeName(v)+")"); return x; };
