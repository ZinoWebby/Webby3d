    const tbl=(v,i,fn)=>{ if(!(v instanceof LuaTable)) throw vm.err("bad argument #"+i+" to '"+fn+"' (table expected, got "+vm.typeName(v)+")"); return v; };
    const opt=v=>v===undefined||v===null;
    G.set('_G',G);
    G.set('print',(...a)=>{ vm.out(a.map(x=>vm.tostr(x)).join('\t')); });
    G.set('type',(...a)=>{ if(a.length===0) throw vm.err("bad argument #1 to 'type' (value expected)"); return vm.typeName(a[0]); });
    G.set('tostring',v=>vm.tostr(v));
    G.set('tonumber',(v,base)=>{ if(!opt(base)){ const n=parseInt(String(v),base); return isNaN(n)?null:n; } return typeof v==='boolean'?null:vm.toNum(v); });
    G.set('ipairs',t=>{ let i=0; return [()=>{ i++; const v=vm.index(t,i); return v===null?[null]:[i,v]; },t,0]; });
    G.set('pairs',t=>{ tbl(t,1,'pairs'); const keys=[...t.h.keys()]; let i=0; return [()=>{ while(i<keys.length){ const k=keys[i++]; if(t.h.has(k)) return [k,t.h.get(k)]; } return [null]; },t,null]; });
    G.set('next',(t,k)=>{ tbl(t,1,'next'); const keys=[...t.h.keys()]; let i=0; if(!opt(k)){ i=keys.indexOf(k)+1; if(i===0) return [null]; } if(i>=keys.length) return [null]; return [keys[i],t.h.get(keys[i])]; });
    G.set('select',(n,...a)=>{ if(n==='#') return a.length; const i=Math.floor(num(n,1,'select')); return i<0?a.slice(a.length+i):a.slice(i-1); });
    G.set('rawget',(t,k)=>tbl(t,1,'rawget').get(k));
